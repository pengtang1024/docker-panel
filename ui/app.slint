// ═══════════════════════════════════════════════════════════
// app.slint — 应用入口，只放 MainWindow + AppActions global + 数据 struct
//
// 三文件拆分架构：
//   app.slint          MainWindow（主窗口 + 顶栏 + Tab + 状态栏）
//                      AppActions global（Rust 侧 callbacks.rs 绑定）
//                      ContainerRow / ImageRow struct（Rust ↔ Slint 数据桥）
//   delegates.slint    ContainerRowDelegate / ImageRowDelegate（ListView 每行视图）
//   dialogs.slint      PullDialog / CleanupDialog（遮罩弹窗）
//
// 为什么拆：
//   delegates.slint 被 ListView 的 `for row in root.container_rows: ContainerRowDelegate` 引用，
//   dialogs.slint 被 MainWindow 末尾 `if root.pull_open: PullDialog` 条件渲染引用。
//   拆出去的文件都是"可被单独 import 的组件库"，app.slint 只做组装。
//
// 数据桥（ContainerRow / ImageRow）：
//   这些 struct 定义在这里，`slint_gen.rs` 的 include_modules!() 会生成对应的 Rust 类型。
//   Rust 侧把 Vec<ContainerRow> 通过 ModelRc::from() 塞进 Slint ListView，
//   delegate 里通过 `row.field` 直接读属性，不需要手动同步。
// ═══════════════════════════════════════════════════════════

import { Button, LineEdit, ListView, VerticalBox, HorizontalBox,
         TabWidget, ScrollView, CheckBox } from "std-widgets.slint";

import { ContainerRowDelegate, ImageRowDelegate } from "delegates.slint";
import { PullDialog, CleanupDialog } from "dialogs.slint";

// ── AppActions global ──────────────────────────────────────
// 全局 action 回调——Rust 侧 callbacks.rs 的 ui.global::<AppActions>() 绑定到这里。
// delegate 组件内部**不**直接 import AppActions（见 delegates.slint 顶部注释），
// 而是在 MainWindow 里把 `AppActions.container_toggle(row.id)` 作为回调属性注入。
// 这样避免 Slint 的跨文件循环依赖（delegates.slint 被 app.slint import 后，
// 如果 delegates 再 import AppActions 就变成了互相依赖）。
export global AppActions {
    callback container_toggle(string);
    callback container_restart(string);
    callback container_remove(string);
    callback image_remove(string);
}

// —— 数据 struct ——
export struct ContainerRow {
    id: string,
    short_id: string,
    name: string,
    image: string,
    status: string,
    is_running: bool,
}

export struct ImageRow {
    id: string,
    short_id: string,
    name: string,
    tag: string,
    size: string,
    containers: int,
}

// —— 主窗口 ——
export component MainWindow inherits Window {
    title: "dvkit";
    width: 960px;
    height: 640px;

    // —— 属性 ——
    in-out property <bool> docker_ok: false;
    in-out property <string> status_text: "连接 Docker...";
    in-out property <string> container_count: "0";
    in-out property <string> image_count: "0";
    in-out property <[ContainerRow]> container_rows: [];
    in-out property <[ImageRow]> image_rows: [];

    // 弹窗状态
    in-out property <bool> pull_open: false;
    in-out property <string> pull_input: "";
    in-out property <bool> pull_busy: false;
    in-out property <bool> cleanup_open: false;
    in-out property <bool> cleanup_stopped: true;
    in-out property <bool> cleanup_dangling: true;
    in-out property <bool> cleanup_unused: false;

    // —— 回调 ——
    callback refresh_requested();
    callback search_accepted(string);
    callback stop_all_requested();
    callback pull_requested();
    callback cleanup_requested();
    callback pull_submit(string);
    callback pull_close();
    callback cleanup_submit(bool, bool, bool);
    callback cleanup_close();

    // —— 深色背景铺满整个窗口 ——
    Rectangle { background: #1e1e2e; x: 0; y: 0; width: root.width; height: root.height; }

    // —— 主布局 ——
    VerticalBox {
        spacing: 0px;

        // 顶栏
        VerticalBox {
            spacing: 6px;
            padding: 8px;

            HorizontalBox {
                spacing: 12px;
                Text {
                    text: "dvkit";
                    font-size: 16px;
                    font-weight: 700;
                }
                Text {
                    text: root.docker_ok ? "● 已连接" : "○ 未连接";
                    color: root.docker_ok ? #00c853 : #ff5252;
                }
                HorizontalLayout { }
                LineEdit {
                    placeholder-text: "搜索...";
                    accepted => { root.search_accepted(self.text); }
                }
                Button {
                    text: "↻ 刷新";
                    clicked => { root.refresh_requested(); }
                }
            }

            // Tab 区域：TabWidget 在上，工具栏在 TabWidget 下方横排
            VerticalBox {
                spacing: 6px;

                TabWidget {
                    Tab {
                        title: "容器";
                        ScrollView {
                            ListView {
                                for row in root.container_rows: ContainerRowDelegate {
                                    row_id: row.id;
                                    short_id: row.short_id;
                                    name: row.name;
                                    image: row.image;
                                    status: row.status;
                                    is_running: row.is_running;
                                    toggle => { AppActions.container_toggle(row.id); }
                                    restart => { AppActions.container_restart(row.id); }
                                    remove => { AppActions.container_remove(row.id); }
                                }
                            }
                        }
                    }
                    Tab {
                        title: "镜像";
                        ScrollView {
                            ListView {
                                for row in root.image_rows: ImageRowDelegate {
                                    row_id: row.id;
                                    short_id: row.short_id;
                                    name: row.name;
                                    tag: row.tag;
                                    size: row.size;
                                    containers: row.containers;
                                    remove => { AppActions.image_remove(row.id); }
                                }
                            }
                        }
                    }
                }

                // 工具栏独立一行，在 Tab 下方
                HorizontalBox {
                    spacing: 8px;
                    padding-top: 4px;
                    Button {
                        text: "停止全部运行中容器";
                        clicked => { root.stop_all_requested(); }
                    }
                    Button {
                        text: "拉取镜像";
                        clicked => { root.pull_requested(); }
                    }
                    Button {
                        text: "清理未使用资源";
                        clicked => { root.cleanup_requested(); }
                    }
                    HorizontalLayout { }
                }
            }
        }

        // 状态栏
        HorizontalBox {
            spacing: 12px;
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 4px;
            padding-bottom: 4px;
            Text {
                text: root.status_text;
            }
            HorizontalLayout { }
            Text {
                text: root.container_count + " 容器  ·  " + root.image_count + " 镜像";
                color: #888888;
            }
        }
    }

    // —— 弹窗层（条件渲染）——
    if root.pull_open: PullDialog {
        input <=> root.pull_input;
        busy <=> root.pull_busy;
        close => { root.pull_close(); }
        submit(val) => { root.pull_submit(val); }
    }
    if root.cleanup_open: CleanupDialog {
        stopped <=> root.cleanup_stopped;
        dangling <=> root.cleanup_dangling;
        unused <=> root.cleanup_unused;
        close => { root.cleanup_close(); }
        submit(s, d, u) => { root.cleanup_submit(s, d, u); }
    }
}
