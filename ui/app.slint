// —— app.slint — 应用入口骨架 ——
// 组装层：MainWindow + AppActions global，import 所有子组件。

import { ListView, VerticalBox, TabWidget, ScrollView, HorizontalBox } from "std-widgets.slint";

import { TopBar, ToolBar, StatusBar } from "panes.slint";
import { ContainerRowDelegate, ImageRowDelegate } from "delegates.slint";
import { ContainerHeader, ImageHeader } from "headers.slint";
import { PullDialog, CleanupDialog } from "dialogs.slint";
import { ContainerRow, ImageRow } from "models.slint";

// ── AppActions global ──────────────────────────────────────
// 行 delegate 触发 → MainWindow 注入 → callbacks.rs 绑定实现 → Rust 异步
export global AppActions {
    callback container_toggle(string);
    callback container_restart(string);
    callback container_remove(string);
    callback container_logs(string);
    callback image_remove(string);
}

// —— 主窗口 ——
export component MainWindow inherits Window {
    title: "Docker Panel";
    width: 1100px;
    height: 680px;

    // —— 属性 ——
    in-out property <bool> docker_ok: false;
    in-out property <string> status_text: "连接 Docker...";
    in-out property <string> container_count: "0";
    in-out property <string> image_count: "0";
    in-out property <[ContainerRow]> container_rows: [];
    in-out property <[ImageRow]> image_rows: [];

    // 弹窗状态
    in-out property <bool> pull_open: false;
    in-out property <string> pull_input: "";
    in-out property <bool> pull_busy: false;
    in-out property <bool> cleanup_open: false;
    in-out property <bool> cleanup_stopped: true;
    in-out property <bool> cleanup_dangling: true;
    in-out property <bool> cleanup_unused: false;

    // —— 回调 ——
    callback refresh_requested();
    callback search_accepted(string);
    callback stop_all_requested();
    callback pull_requested();
    callback cleanup_requested();
    callback pull_submit(string);
    callback pull_close();
    callback cleanup_submit(bool, bool, bool);
    callback cleanup_close();

    // —— 深色背景 ——
    Rectangle { background: #1e1e2e; x: 0; y: 0; width: root.width; height: root.height; }

    // —— 主布局：顶栏 → [Tab+工具栏 | 详情面板] → 状态栏 ——
    HorizontalBox {
        spacing: 0px;
        height: root.height;

        // 左侧主区
        VerticalBox {
            spacing: 0px;
            width: root.width - 320px;

            VerticalBox {
                spacing: 6px;
                padding: 8px;

                // 顶栏
                TopBar {
                    docker_ok <=> root.docker_ok;
                    refresh => { root.refresh_requested(); }
                    search(val) => { root.search_accepted(val); }
                }

                VerticalBox {
                    spacing: 6px;

                    TabWidget {
                        Tab {
                            title: "容器";
                            VerticalBox {
                                ContainerHeader { }  // 表头
                                ScrollView {
                                    ListView {
                                        for row in root.container_rows: ContainerRowDelegate {
                                    row_id: row.id;
                                    short_id: row.short_id;
                                    name: row.name;
                                    image: row.image;
                                    status: row.status;
                                    is_running: row.is_running;
                                    toggle => { AppActions.container_toggle(row.id); }
                                    restart => { AppActions.container_restart(row.id); }
                                    logs => { AppActions.container_logs(row.id); }
                                    remove => { AppActions.container_remove(row.id); }
                                }
                                    }
                                }
                            }
                        }
                        Tab {
                            title: "镜像";
                            VerticalBox {
                                ImageHeader { }  // 表头
                                ScrollView {
                                    ListView {
                                        for row in root.image_rows: ImageRowDelegate {
                                            row_id: row.id;
                                            short_id: row.short_id;
                                            name: row.name;
                                            tag: row.tag;
                                            size: row.size;
                                            containers: row.containers;
                                            remove => { AppActions.image_remove(row.id); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Tab 下方工具栏
                    ToolBar {
                        stop_all => { root.stop_all_requested(); }
                        pull_requested => { root.pull_requested(); }
                        cleanup_requested => { root.cleanup_requested(); }
                    }
                }
            }

            // 状态栏
            StatusBar {
                status_text <=> root.status_text;
                container_count <=> root.container_count;
                image_count <=> root.image_count;
            }
        }

        // —— 右侧详情面板占位（Phase 2 填充）——
        Rectangle {
            background: #252538;
            width: 320px;
        }
    }

    // —— 弹窗层 ——
    if root.pull_open: PullDialog {
        input <=> root.pull_input;
        busy <=> root.pull_busy;
        close => { root.pull_close(); }
        submit(val) => { root.pull_submit(val); }
    }
    if root.cleanup_open: CleanupDialog {
        stopped <=> root.cleanup_stopped;
        dangling <=> root.cleanup_dangling;
        unused <=> root.cleanup_unused;
        close => { root.cleanup_close(); }
        submit(s, d, u) => { root.cleanup_submit(s, d, u); }
    }
}
