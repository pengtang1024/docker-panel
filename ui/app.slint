// app.slint — 主窗口骨架
// 布局：VerticalLayout(TopBar, SubBar, BatchBar?, GridArea, FootBar) + Drawer
import { Theme } from "theme.slint";
import { Tip, CardMenu } from "components-align.slint";
import { TipLayer } from "components-interact.slint";
import { SortMenu, CardMenuLayer } from "menu-layers.slint";
import { TopBar } from "top-bar.slint";
import { SubBar } from "sub-bar.slint";
import { BatchBar } from "batch-bar.slint";
import { CardsArea } from "cards.slint";
import { FootBar } from "foot-bar.slint";
import { Drawer } from "drawer.slint";
import { PullDialog, CleanupDialog } from "dialogs.slint";
import { ContainerRow, ImageRow, NetworkRow, VolumeRow, LogLineRow, ComposeRow, DetailPair } from "models.slint";

export global AppActions {
    callback toggle_theme();
    callback refresh();
    callback cleanup();
    callback pull();
    callback set_view(int);
    callback set_filter(string);
    callback set_sort(int);
    callback set_sort_dir();
    callback search(string);
    callback container_toggle(string);
    callback container_restart(string);
    callback container_remove(string);
    callback container_logs(string);
    callback container_select(string);
    callback container_toggle_select(string);
    callback image_select(string);
    callback image_run(string);
    callback image_remove(string);
    callback network_select(string);
    callback network_remove(string);
    callback volume_select(string);
    callback volume_remove(string);
    callback batch_start();
    callback batch_stop();
    callback batch_restart();
    callback batch_remove();
    callback batch_clear();
    callback drawer_close();
    callback drawer_tab(int);
    callback log_toggle_follow();
    callback log_copy();
    callback log_clear();
    callback pull_submit(string);
    callback pull_close();
    callback cleanup_submit(bool, bool, bool, bool);
    callback cleanup_close();
}

export component MainWindow inherits Window {
    title: "Docker Panel";
    // 用 preferred-* 而非 width/height：显式 width/height 会把 min/max 一起钉死
    // → 窗口被锁成固定尺寸、无法缩放拖拽。preferred 只给初始尺寸，min 给下限。
    preferred-width: 1280px;
    preferred-height: 760px;
    min-width: 880px;
    min-height: 560px;
    background: Theme.bg;

    // 启动即把键盘焦点交给全局快捷键 FocusScope。
    // init 里先试一次；Rust 在事件循环启动后置 boot_tick 再兜底一次
    // （testing/winit 后端下 init 阶段焦点可能在窗口 show 时被清掉）
    in-out property <int> boot_tick: 0;
    init => { global-shortcuts.focus(); }
    changed boot_tick => { if root.boot_tick > 0 { global-shortcuts.focus(); } }

    // —— 视图与筛选 ——
    in-out property <int> view: 0;          // 0=容器 1=镜像 2=网络 3=卷
    in-out property <string> filter: "all";
    in-out property <int> sort_field: 0;    // 0=name 1=cpu 2=mem 3=disk 4=status
    in-out property <bool> sort_desc: true;
    in-out property <string> search_q: "";
    in-out property <int> theme_mode <=> Theme.theme_mode;

    // —— 全局状态 ——
    in-out property <bool> docker_ok: false;
    in-out property <string> status_text: @tr("Ready");
    in-out property <int> batch_count: 0;
    /// 首次数据拉取期间显示骨架屏（强制 true 单独验证骨架屏渲染效果）
    in-out property <bool> loading: true;
    /// 多选模式独立开关（与 batch_count 解耦：进入 sel-mode 后可先不选任何项）
    in-out property <bool> sel_mode: true;

    // —— 统计 ——
    in-out property <int> total_containers: 0;
    in-out property <int> running_containers: 0;
    in-out property <int> total_images: 0;
    in-out property <int> total_networks: 0;
    in-out property <int> total_volumes: 0;
    in-out property <string> cpu_total: "0%";
    in-out property <string> mem_total: "0MB";
    in-out property <string> disk_total: "0MB";

    // —— 数据 ——
    in-out property <[ContainerRow]> container_rows: [];
    in-out property <[ImageRow]> image_rows: [];
    in-out property <[NetworkRow]> network_rows: [];
    in-out property <[VolumeRow]> volume_rows: [];
    in-out property <[LogLineRow]> log_lines: [];
    in-out property <string> log_text: "";
    in-out property <[ComposeRow]> compose_rows: [];

    // —— 抽屉 ——
    in-out property <bool> drawer_open: true;
    in-out property <int> drawer_tab: 0;    // 0=详情 1=日志 2=环境
    in-out property <bool> log_follow: true;
    // 抽屉内容统一走 DetailPair 行列表（Rust 侧按选中类型构建，见 detail_fmt.rs）
    in-out property <string> drawer_title: "";
    in-out property <string> drawer_sub: "";
    in-out property <bool> drawer_tabs: true;
    in-out property <[DetailPair]> detail_rows: [];
    in-out property <[DetailPair]> env_rows: [];

    // —— 弹窗 ——
    in-out property <bool> pull_open: false;
    in-out property <string> pull_input: "";
    in-out property <bool> pull_busy: false;
    in-out property <int> pull_progress: 0;
    in-out property <string> pull_status: "";
    in-out property <bool> cleanup_open: false;
    in-out property <bool> cleanup_stopped: true;
    in-out property <bool> cleanup_dangling: true;
    in-out property <bool> cleanup_unused_net: false;
    in-out property <bool> cleanup_unused_vol: false;
    // 清理弹窗行右侧数量（Rust 侧按当前列表估算后回填）
    in-out property <string> cleanup_cnt_stopped: "";
    in-out property <string> cleanup_cnt_dangling: "";
    in-out property <string> cleanup_cnt_unused_net: "";
    in-out property <string> cleanup_cnt_unused_vol: "";

    // —— 全局快捷键（capture 阶段拦截：必须是所有可聚焦元素的祖先，
    //    否则捕获路径不含此 FocusScope，搜索框聚焦时收不到组合键）——
    global-shortcuts := FocusScope {
        width: 100%;
        height: 100%;
        capture-key-pressed(e) => {
            if (e.modifiers.control) {
                if (e.text == "k") {
                    top-bar.focus_search();
                    accept
                } else if (e.text == "r") {
                    AppActions.refresh();
                    accept
                } else if (e.text == "1" || e.text == "2" || e.text == "3" || e.text == "4") {
                    if (e.text == "1") { root.view = 0; }
                    else if (e.text == "2") { root.view = 1; }
                    else if (e.text == "3") { root.view = 2; }
                    else { root.view = 3; }
                    AppActions.set_view(root.view);
                    accept
                } else {
                    reject
                }
            } else if (e.text == "/") {
                // spec 3.5：`/` 直接聚焦搜索框（已在搜索框内输入时由 TextInput 先消费）
                top-bar.focus_search();
                accept
            } else if (e.text == Key.Escape) {
                sub-bar.sort_open = false;
                CardMenu.close();
                if (root.drawer_open || root.pull_open || root.cleanup_open) {
                    root.drawer_open = false;
                    root.pull_open = false;
                    root.cleanup_open = false;
                } else if (root.batch_count > 0) {
                    // sel-mode 退出：清空多选 → 复选框随之隐藏
                    AppActions.batch_clear();
                    root.sel_mode = false;
                } else if (root.sel_mode) {
                    // sel-mode=true 但还没选任何项 → 直接退出
                    root.sel_mode = false;
                }
                // 弹窗/抽屉被条件渲染移除后其内部焦点会悬空，把焦点收回全局快捷键层
                global-shortcuts.focus();
                accept
            } else {
                reject
            }
        }

    VerticalLayout {
        width: 100%; height: 100%;
        spacing: 0px;

        top-bar := TopBar {
            height: Theme.top_h;
            docker_ok <=> root.docker_ok;
            search_q <=> root.search_q;
            theme_click => { AppActions.toggle_theme(); }
            refresh_click => { AppActions.refresh(); }
            cleanup_click => { AppActions.cleanup(); }
            pull_click => { AppActions.pull(); }
            search(val) => { AppActions.search(val); }
        }

        sub-bar := SubBar {
            height: Theme.sub_h;
            view <=> root.view;
            filter <=> root.filter;
            sort_field <=> root.sort_field;
            sort_desc <=> root.sort_desc;
            sel_mode <=> root.sel_mode;
            compose_rows <=> root.compose_rows;
            total_containers <=> root.total_containers;
            running_containers <=> root.running_containers;
            total_images <=> root.total_images;
            total_networks <=> root.total_networks;
            total_volumes <=> root.total_volumes;
            set_view(v) => { AppActions.set_view(v); }
            set_filter(f) => { AppActions.set_filter(f); }
            set_sort(f) => { AppActions.set_sort(f); }
            set_sort_dir() => { AppActions.set_sort_dir(); }
            sel_toggle() => { root.sel_mode = root.sel_mode == false; if (root.sel_mode == false) { AppActions.batch_clear(); } }
        }

        if root.batch_count > 0: BatchBar {
            height: Theme.batch_h;
            count <=> root.batch_count;
            start => { AppActions.batch_start(); }
            stop => { AppActions.batch_stop(); }
            restart => { AppActions.batch_restart(); }
            remove => { AppActions.batch_remove(); }
            clear => { AppActions.batch_clear(); }
        }

        CardsArea {
            vertical-stretch: 1;
            view <=> root.view;
            sel_mode <=> root.sel_mode;
            loading <=> root.loading;
            containers <=> root.container_rows;
            images <=> root.image_rows;
            networks <=> root.network_rows;
            volumes <=> root.volume_rows;
            c_select(id) => { CardMenu.close(); AppActions.container_select(id); }
            c_toggle(id) => { AppActions.container_toggle(id); }
            c_restart(id) => { AppActions.container_restart(id); }
            c_logs(id) => { AppActions.container_logs(id); }
            c_remove(id) => { AppActions.container_remove(id); }
            c_box(id) => { AppActions.container_toggle_select(id); }
            i_select(id) => { CardMenu.close(); AppActions.image_select(id); }
            i_run(id) => { AppActions.image_run(id); }
            i_remove(id) => { AppActions.image_remove(id); }
            n_select(id) => { CardMenu.close(); AppActions.network_select(id); }
            n_remove(id) => { AppActions.network_remove(id); }
            v_select(id) => { CardMenu.close(); AppActions.volume_select(id); }
            v_remove(id) => { AppActions.volume_remove(id); }
        }

        FootBar {
            height: Theme.foot_h;
            docker_ok <=> root.docker_ok;
            status <=> root.status_text;
            total_containers <=> root.total_containers;
            running_containers <=> root.running_containers;
            total_images <=> root.total_images;
            total_networks <=> root.total_networks;
            total_volumes <=> root.total_volumes;
            cpu_total <=> root.cpu_total;
            mem_total <=> root.mem_total;
            disk_total <=> root.disk_total;
        }
    }

    // 排序下拉菜单 + 卡片「···」菜单：必须渲染在 CardsArea 之后（同层直接子元素），
    // 否则会被下方卡片区覆盖 / 裁掉 —— 与 prototype 的绝对定位下拉一致
    if sub-bar.sort_open : SortMenu {
        x: sub-bar.menu_x;
        y: sub-bar.menu_y;
        field: root.sort_field;
        desc: root.sort_desc;
        pick(f) => { sub-bar.sort_open = false; AppActions.set_sort(f); }
    }

    if CardMenu.id != "" : CardMenuLayer {
        x: CardMenu.mx;
        y: CardMenu.my;
        id: CardMenu.id;
        kind: CardMenu.kind;
        can_stop: CardMenu.can_stop;
        stop_card(id) => { AppActions.container_toggle(id); CardMenu.close(); }
        logs(id) => { AppActions.container_logs(id); CardMenu.close(); }
        details(id) => {
            if (CardMenu.kind == 1) { AppActions.image_select(id); }
            else if (CardMenu.kind == 2) { AppActions.network_select(id); }
            else { AppActions.volume_select(id); }
            CardMenu.close();
        }
        remove(id) => {
            if (CardMenu.kind == 1) { AppActions.image_remove(id); }
            else if (CardMenu.kind == 2) { AppActions.network_remove(id); }
            else { AppActions.volume_remove(id); }
            CardMenu.close();
        }
    }

    Drawer {
        // 未显式定位的元素默认在父级居中（x=(1280-400)/2=440），必须显式绑定到窗口右侧
        x: root.drawer_open ? root.width - Theme.drawer_w : root.width;
        animate x { duration: 180ms; easing: ease-out; }
        open <=> root.drawer_open;
        tab <=> root.drawer_tab;
        log_follow <=> root.log_follow;
        log_lines <=> root.log_lines;
        log_text <=> root.log_text;
        title <=> root.drawer_title;
        sub <=> root.drawer_sub;
        tabs_visible <=> root.drawer_tabs;
        detail_rows <=> root.detail_rows;
        env_rows <=> root.env_rows;
        close => { AppActions.drawer_close(); }
        set_tab(t) => { AppActions.drawer_tab(t); }
        log_follow_click => { AppActions.log_toggle_follow(); }
        log_copy_click => { AppActions.log_copy(); }
        log_clear_click => { AppActions.log_clear(); }
    }

    if root.pull_open: PullDialog {
        open <=> root.pull_open; input <=> root.pull_input;
        busy <=> root.pull_busy;
        progress <=> root.pull_progress;
        status <=> root.pull_status;
        close => { AppActions.pull_close(); }
        submit(v) => { AppActions.pull_submit(v); }
    }
    if root.cleanup_open: CleanupDialog {
        open <=> root.cleanup_open; stopped <=> root.cleanup_stopped;
        dangling <=> root.cleanup_dangling;
        unused_net <=> root.cleanup_unused_net;
        unused_vol <=> root.cleanup_unused_vol;
        cnt_stopped <=> root.cleanup_cnt_stopped;
        cnt_dangling <=> root.cleanup_cnt_dangling;
        cnt_unused_net <=> root.cleanup_cnt_unused_net;
        cnt_unused_vol <=> root.cleanup_cnt_unused_vol;
        close => { AppActions.cleanup_close(); }
        submit(a,b,c,d) => { AppActions.cleanup_submit(a,b,c,d); }
    }

    // 全局提示浮层：所有组件 hover 时写 Tip，这里统一渲染并做边界收敛
    // flip=true 时向下弹（锚点上方不够空间，如 TopBar 顶部按钮）
    TipLayer {
        flip: Tip.ay - self.height - 12px < Theme.s1;
        x: Math.max(Theme.s1, Math.min(root.width - self.width - Theme.s1, Tip.ax - self.width / 2));
        y: self.flip ? Tip.ay + Tip.btn_h + 4px : Math.max(Theme.s1, Tip.ay - self.height - 12px);
    }
    }
}
