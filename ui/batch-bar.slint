// batch-bar.slint — 多选批量操作栏
import { Theme } from "theme.slint";
import { Button } from "components.slint";

export component BatchBar inherits Rectangle {
    in-out property <int> count: 0;

    callback b-start();
    callback b-stop();
    callback b-restart();
    callback b-remove();
    callback b-clear();

    height: Theme.batch-h;
    background: Theme.bg-row-sel;

    VerticalLayout {
        width: 100%; height: 100%;
        padding-left: Theme.s4; padding-right: Theme.s4;
        alignment: center;
        HorizontalLayout {
            spacing: Theme.s2;
            alignment: center;

            Rectangle { width: 2px; height: 14px; background: Theme.accent; }
            Text {
                text: "已选 " + root.count + " 个";
                font-size: Theme.fs; font-weight: 700; color: Theme.fg;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "启动"; glyph: "▶"; clicked => { root.b-start(); } }
            Button { text: "停止"; glyph: "■"; clicked => { root.b-stop(); } }
            Button { text: "重启"; glyph: "↻"; clicked => { root.b-restart(); } }
            Button { text: "删除"; glyph: "✕"; danger: true; clicked => { root.b-remove(); } }
            Rectangle { width: Theme.s2; height: 1px; }
            Button { text: "取消"; clicked => { root.b-clear(); } }
        }
    }

    Rectangle { x: 0; y: 0; width: 100%; height: 1px; background: Theme.accent; }
}
