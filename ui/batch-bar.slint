// batch-bar.slint — 批量操作栏
import { Theme } from "theme.slint";

export component BatchBar inherits Rectangle {
    height: Theme.batch_h;
    background: Theme.pill_on_bg;

    in-out property <int> count: 0;
    callback start();
    callback stop();
    callback restart();
    callback remove();
    callback clear();

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.s3;
        padding-left: Theme.s5;
        padding-right: Theme.s5;

        Text {
            text: @tr("{0} selected", root.count);
            font-size: Theme.fs;
            font-weight: 700;
            color: Theme.ink;
        }

        Rectangle { horizontal-stretch: 1; }

        Rectangle {
            width: 32px; height: 28px; border-radius: Theme.r_sm;
            background: Theme.card; border-width: 1px; border-color: Theme.line;
            Text { text: "▶"; color: Theme.ink_2; font-size: 12px; }
            TouchArea { clicked => { root.start(); } }
        }
        Rectangle {
            width: 32px; height: 28px; border-radius: Theme.r_sm;
            background: Theme.card; border-width: 1px; border-color: Theme.line;
            Text { text: "■"; color: Theme.ink_2; font-size: 10px; }
            TouchArea { clicked => { root.stop(); } }
        }
        Rectangle {
            width: 32px; height: 28px; border-radius: Theme.r_sm;
            background: Theme.card; border-width: 1px; border-color: Theme.line;
            Text { text: "↻"; color: Theme.ink_2; font-size: 13px; }
            TouchArea { clicked => { root.restart(); } }
        }
        Rectangle {
            width: 32px; height: 28px; border-radius: Theme.r_sm;
            background: Theme.card; border-width: 1px; border-color: Theme.line;
            Text { text: "✕"; color: Theme.err; font-size: 12px; }
            TouchArea { clicked => { root.remove(); } }
        }
        Rectangle {
            height: 28px;
            border-radius: Theme.r_sm;
            background: Theme.card; border-width: 1px; border-color: Theme.line;
            HorizontalLayout {
                width: 100%; height: 100%;
                padding-left: Theme.s4; padding-right: Theme.s4;
                Text { text: @tr("Cancel"); color: Theme.ink_2; font-size: Theme.fs_sm; }
            }
            TouchArea { clicked => { root.clear(); } }
        }
    }
}
