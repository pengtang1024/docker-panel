// batch-bar.slint — 批量操作栏
import { Theme } from "theme.slint";
import { IconBtn } from "components.slint";

export component BatchBar inherits Rectangle {
    height: Theme.batch_h;
    background: Theme.pill_on_bg;

    in-out property <int> count: 0;
    callback start();
    callback stop();
    callback restart();
    callback remove();
    callback clear();

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.s3;
        padding-left: Theme.s5;
        padding-right: Theme.s5;

        Text {
            text: @tr("{0} selected", root.count);
            font-size: Theme.fs;
            font-weight: 700;
            color: Theme.ink;
        }

        Rectangle { horizontal-stretch: 1; }

        // 全图标 + tooltip（spec 2.3）
        IconBtn { size: 28px; glyph_size: 12px; glyph: "▶"; tip: @tr("Start"); clicked => { root.start(); } }
        IconBtn { size: 28px; glyph_size: 10px; glyph: "■"; tip: @tr("Stop"); clicked => { root.stop(); } }
        IconBtn { size: 28px; glyph_size: 13px; glyph: "↻"; tip: @tr("Restart"); clicked => { root.restart(); } }
        IconBtn { size: 28px; glyph_size: 13px; glyph: "🗑"; danger: true; tip: @tr("Remove"); clicked => { root.remove(); } }
        IconBtn { size: 28px; glyph_size: 12px; glyph: "✕"; tip: @tr("Cancel"); clicked => { root.clear(); } }
    }
}
