// card-netvol.slint — 网络卡片 + 卷卡片
// 规范：NetworkCard/VolumeCard 操作 ≤2（select/remove），不再显示右上角按钮；
//       touch.clicked 直接 select，删除走 Drawer 详情页的删除按钮。
import { Theme } from "theme.slint";
import { Tip, VCenterText } from "components-align.slint";
import { MonoChip } from "components-chip.slint";
import { NetworkRow, VolumeRow } from "models.slint";

export component NetworkCard inherits Rectangle {
    in property <NetworkRow> data;
    callback select(string);
    callback remove(string);

    border-radius: Theme.r;
    background: Theme.card;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.ink_4 : Theme.line;
    clip: true;

    Rectangle {
        x: 0px; y: 9px; width: 3px; height: parent.height - 16px;
        border-radius: 2px; background: Theme.ok;
    }

    touch := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.select(root.data.id); }
    }

    // 每行 height 固定，VL height 精确 = 总和
    // 18 + 14 + 22 + 14 = 68px（spacing=0）
    VerticalLayout {
        x: 11px; y: 9px; width: parent.width - 20px; height: 68px; spacing: 0px;

        HorizontalLayout {
            width: 100%; height: 18px; spacing: 6px;
            VCenterText { text: root.data.name; font-size: 14px; font-weight: 700; color: Theme.ink; overflow: elide; }
            if root.data.builtin : VCenterText { text: "(" + @tr("Builtin") + ")"; font-size: Theme.fs_xs; color: Theme.ink_3; }
            Rectangle { horizontal-stretch: 1; }
        }

        HorizontalLayout {
            height: 14px;
            VCenterText {
                text: root.data.subnet == ""
                    ? root.data.driver + " · " + root.data.scope
                    : root.data.driver + " · " + root.data.scope + " · " + root.data.subnet;
                font-size: Theme.fs_sm; font-family: Theme.mono; color: Theme.ink_2; overflow: elide;
            }
        }

        // driver/scope 胶囊行（alignment:start 防止 preferred 污染导致均分拉伸）
        HorizontalLayout {
            height: 22px;
            alignment: start;
            spacing: 4px;
            MonoChip { label: root.data.driver; fs: Theme.fs_sm; rad: Theme.r_sm; ink: Theme.ink_2; }
            MonoChip { label: root.data.scope; fs: Theme.fs_sm; rad: Theme.r_sm; ink: Theme.ink_2; }
        }

        HorizontalLayout {
            height: 14px;
            VCenterText {
                text: @tr("{0} container" | "{0} containers" % root.data.containers, root.data.containers);
                font-size: Theme.fs_sm; color: Theme.ink_2;
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

export component VolumeCard inherits Rectangle {
    in property <VolumeRow> data;
    callback select(string);
    callback remove(string);

    border-radius: Theme.r;
    background: Theme.card;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.ink_4 : Theme.line;
    clip: true;

    Rectangle {
        x: 0px; y: 9px; width: 3px; height: parent.height - 16px;
        border-radius: 2px; background: Theme.ok;
    }

    touch := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.select(root.data.name); }
    }

    name_touch := TouchArea {
        x: 11px; y: 9px; width: parent.width - 20px; height: 18px;
        private property <bool> tip_on: self.has-hover;
        clicked => { root.select(root.data.name); }
        changed tip_on => {
            if (self.tip_on && root.data.display_name != root.data.name) {
                Tip.text = root.data.name; Tip.ax = self.absolute-position.x + self.width / 2; Tip.ay = self.absolute-position.y;
            } else if (Tip.text == root.data.name) { Tip.text = ""; }
        }
    }

    // 每行 height 固定，VL height 精确 = 总和
    // 18 + 22(if anonymous) + 14 + 14 = 68px
    VerticalLayout {
        x: 11px; y: 9px; width: parent.width - 20px; height: 68px; spacing: 0px;

        HorizontalLayout {
            height: 18px;
            VCenterText {
                text: root.data.display_name; font-size: Theme.fs_md; font-weight: 700;
                font-family: Theme.mono; color: Theme.ink; horizontal-stretch: 1; overflow: elide;
            }
        }

        if root.data.anonymous : HorizontalLayout {
            height: 22px;
            MonoChip { label: @tr("Anonymous volume"); plain: false; ink: Theme.ink_3; }
        }

        HorizontalLayout {
            height: 14px;
            VCenterText {
                text: root.data.mountpoint; font-size: Theme.fs_xs; font-family: Theme.mono;
                color: Theme.ink_3; overflow: elide;
            }
        }

        HorizontalLayout {
            height: 14px;
            VCenterText { text: "driver: "; font-size: Theme.fs_sm; color: Theme.ink_2; }
            VCenterText { text: root.data.driver; font-size: Theme.fs_sm; font-weight: 600; font-family: Theme.mono; color: Theme.ink; }
            Rectangle { horizontal-stretch: 1; }
            VCenterText { text: root.data.size; font-size: Theme.fs_sm; font-weight: 600; font-family: Theme.mono; color: Theme.ink; }
        }
    }
}
