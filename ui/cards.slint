// cards.slint — 卡片网格区域（自适应列数 + 垂直滚动）
// 4 个视图共用一套网格几何：按宽度算列数（prototype 1280px 下 = 4 列 310px），
// 卡片绝对定位在 Flickable 内容层里；空数据显示 EmptyState。
// 三张卡片组件分别在 card-container / card-image / card-netvol.slint。
import { Theme } from "theme.slint";
import { CardMenu } from "components-align.slint";
import { EmptyState } from "components-empty.slint";
import { ContainerRow, ImageRow, NetworkRow, VolumeRow } from "models.slint";
import { ContainerCard } from "card-container.slint";
import { ImageCard } from "card-image.slint";
import { NetworkCard, VolumeCard } from "card-netvol.slint";
import { SkelGrid } from "skel.slint";

export component CardsArea inherits Rectangle {
    in-out property <int> view: 0;
    in-out property <bool> sel_mode: false;
    in-out property <bool> loading: false;
    in-out property <[ContainerRow]> containers: [];
    in-out property <[ImageRow]> images: [];
    in-out property <[NetworkRow]> networks: [];
    in-out property <[VolumeRow]> volumes: [];
    callback c_select(string);
    callback c_toggle(string);
    callback c_restart(string);
    callback c_logs(string);
    callback c_remove(string);
    callback c_box(string);
    callback i_select(string);
    callback i_run(string);
    callback i_remove(string);
    callback n_select(string);
    callback n_remove(string);
    callback v_select(string);
    callback v_remove(string);
    /// 卡片「···」菜单请求（冒泡到本层，由 CardsArea 写 CardMenu 总线单例）
    callback menu_toggle(string, int, bool, length, length);

    // 单实例菜单总线：点自己收起、点别的卡片改写锚点（id 必须最后写，
    // 否则 id 先变会让菜单带着旧锚点先渲染一帧）
    menu_toggle(id, kind, can_stop, mx, my) => {
        if (CardMenu.id == id) {
            CardMenu.close();
        } else {
            CardMenu.kind = kind;
            CardMenu.can_stop = can_stop;
            CardMenu.mx = mx;
            CardMenu.my = my;
            CardMenu.id = id;
        }
    }

    // —— 网格几何（prototype .content padding 8px / .grid gap 8px / 卡宽 310px @1280）——
    property <length> pad: Theme.s3;
    property <length> gap: Theme.s3;
    property <length> card_h: 140px;  // 89→140：cross-axis:center + preferred-height 自适应后内容实际更高
    property <length> card_min: 300px;
    property <float> per_row: Math.max(1, Math.floor((self.width - 2 * pad + gap) / (card_min + gap)));
    property <int> n: view == 0 ? containers.length
                    : view == 1 ? images.length
                    : view == 2 ? networks.length
                    : volumes.length;
    property <float> row_cnt: Math.ceil(n / per_row);
    // 单元格宽度：总宽均分后减去列间 gap
    property <length> pitch: (self.width - 2 * pad - (per_row - 1) * gap) / per_row;
    property <length> body_h: row_cnt * (card_h + gap) + 2 * pad - gap;

    // 空白区点击兜底：卡片带 clip 且菜单浮在顶层，点卡片以外区域应收起「···」菜单
    // （置于最底层：卡片 / 空白态在源码顺序上后绘，命中优先于本层，不影响卡片交互）
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { CardMenu.close(); }
    }

    // loading 骨架屏（首次数据拉取期间）
    if root.loading : SkelGrid { width: 100%; height: 100%; }
    // 空状态（prototype .empty：无数据 / 无匹配）
    if root.loading == false && root.n == 0 : EmptyState {
        width: 100%;
        height: 100%;
        icon_name: "";
        title: root.view == 0 ? @tr("No matching containers")
            : root.view == 1 ? @tr("No matching images")
            : root.view == 2 ? @tr("No matching networks")
            : @tr("No matching volumes");
        desc: root.view == 0 ? @tr("Try adjusting filters or keywords")
            : root.view == 1 ? @tr("Pull new image or adjust search")
            : "";
    }

    if root.loading == false && root.view == 0 && root.n > 0 : Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: root.body_h;
        for row[i] in root.containers : ContainerCard {
            data: row;
            sel_mode: root.sel_mode;
            menu_open: CardMenu.id == row.id;
            x: root.pad + (i - Math.floor(i / root.per_row) * root.per_row) * (root.pitch + root.gap);
            y: root.pad + Math.floor(i / root.per_row) * (root.card_h + root.gap);
            width: root.pitch;
            height: root.card_h;
            select(id) => { root.c_select(id); }
            toggle(id) => { root.c_toggle(id); }
            restart(id) => { root.c_restart(id); }
            logs(id) => { root.c_logs(id); }
            remove(id) => { root.c_remove(id); }
            box(id) => { root.c_box(id); }
            menu_toggle(id, kind, can_stop, mx, my) => {
                root.menu_toggle(id, kind, can_stop, mx, my);
            }
        }
    }

    if root.loading == false && root.view == 1 && root.n > 0 : Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: root.body_h;
        for row[i] in root.images : ImageCard {
            data: row;
            menu_open: CardMenu.id == row.id;
            x: root.pad + (i - Math.floor(i / root.per_row) * root.per_row) * (root.pitch + root.gap);
            y: root.pad + Math.floor(i / root.per_row) * (root.card_h + root.gap);
            width: root.pitch;
            height: root.card_h;
            select(id) => { root.i_select(id); }
            run(id) => { root.i_run(id); }
            remove(id) => { root.i_remove(id); }
            menu_toggle(id, kind, can_stop, mx, my) => {
                root.menu_toggle(id, kind, can_stop, mx, my);
            }
        }
    }

    if root.loading == false && root.view == 2 && root.n > 0 : Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: root.body_h;
        for row[i] in root.networks : NetworkCard {
            data: row;
            menu_open: CardMenu.id == row.id;
            x: root.pad + (i - Math.floor(i / root.per_row) * root.per_row) * (root.pitch + root.gap);
            y: root.pad + Math.floor(i / root.per_row) * (root.card_h + root.gap);
            width: root.pitch;
            height: root.card_h;
            select(id) => { root.n_select(id); }
            remove(id) => { root.n_remove(id); }
            menu_toggle(id, kind, can_stop, mx, my) => {
                root.menu_toggle(id, kind, can_stop, mx, my);
            }
        }
    }

    if root.loading == false && root.view == 3 && root.n > 0 : Flickable {
        width: 100%;
        height: 100%;
        content-width: self.width;
        content-height: root.body_h;
        for row[i] in root.volumes : VolumeCard {
            data: row;
            menu_open: CardMenu.id == row.name;
            x: root.pad + (i - Math.floor(i / root.per_row) * root.per_row) * (root.pitch + root.gap);
            y: root.pad + Math.floor(i / root.per_row) * (root.card_h + root.gap);
            width: root.pitch;
            height: root.card_h;
            select(id) => { root.v_select(id); }
            remove(id) => { root.v_remove(id); }
            menu_toggle(id, kind, can_stop, mx, my) => {
                root.menu_toggle(id, kind, can_stop, mx, my);
            }
        }
    }
}
