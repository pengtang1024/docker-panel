// components-chip.slint — 数据展示类组件
// 架构：Chip 基类（MonoChip + ProjTag 同构）+ Stat 独立（异构垂直布局）
import { Theme } from "theme.slint";
import { Tip, VCenterText, CenterText } from "components-align.slint";
import { StateArea } from "components-state.slint";

// ============ Chip 基类（严格对齐 prototype .chip/.tag/.view-tab）============
// .tag{font-size:11px;font-weight:600;color:var(--ink);background:var(--line-2);padding:2px 8px;border-radius:var(--r-sm);font-family:var(--m)}
export component Chip inherits Rectangle {
    in-out property <string> label: "";
    in-out property <string> tip: "";
    in-out property <bool> plain: false;
    in-out property <color> ink: Theme.ink_2;
    in-out property <length> fs: Theme.fs_sm;
    in-out property <length> rad: Theme.r_sm;
    in-out property <color> dot_color: Theme.accent;
    in-out property <bool> show_dot: false;
    in-out property <bool> mono: true;
    in-out property <bool> bold: true;
    in-out property <length> pad_h: 8px;     // padding-left/right
    in-out property <length> pad_v: 2px;     // padding-top/bottom

    border-radius: root.rad;
    background: root.plain ? transparent : Theme.line_2;

    area := StateArea {
        width: 100%; height: 100%;
        layer_color: Theme.row_hover;
        layer_radius: root.rad;
    }

    HorizontalLayout {
        alignment: center;
        padding-left: root.pad_h; padding-right: root.pad_h;
        padding-top: root.pad_v; padding-bottom: root.pad_v;

        if root.show_dot : Rectangle {
            width: 6px; height: 6px; border-radius: 3px; background: root.dot_color;
        }

        VCenterText {
            text: root.label; font-size: root.fs;
            font-family: root.mono ? Theme.mono : "";
            font-weight: root.bold ? 600 : 400;
            color: root.ink;
        }
    }

    private property <bool> tip_hover: area.has_hover;
    changed tip_hover => {
        if (root.tip_hover && root.tip != "") { Tip.text = root.tip; Tip.ax = area.absolute-position.x + area.width / 2; Tip.ay = area.absolute-position.y; }
        else if (Tip.text == root.tip) { Tip.text = ""; }
    }
}

// ============ 向后兼容别名（各组件独立微调 padding）============
export component MonoChip inherits Chip { mono: true; bold: true; show_dot: false; pad_h: 8px; pad_v: 2px; }
export component ProjTag inherits Chip { mono: false; bold: true; show_dot: true; pad_h: 8px; pad_v: 2px; }

// ============ 资源指标（图标 + 数值，异构垂直布局，独立）============
export component Stat inherits Rectangle {
    in-out property <string> glyph: "";
    in-out property <string> value: "";
    in-out property <string> tip: "";

    HorizontalLayout {
        alignment: center;
        CenterText {
            text: root.glyph; font-size: 11px; width: 14px; height: 14px;
            color: Theme.ink_3;
        }
        VCenterText {
            text: root.value; font-size: Theme.fs_sm; font-weight: 600;
            color: Theme.ink; font-family: Theme.mono;
        }
    }

    touch := TouchArea { width: 100%; height: 100%; }
    private property <bool> tip_hover: touch.has-hover;
    changed tip_hover => {
        if (root.tip_hover && root.tip != "") { Tip.text = root.tip; Tip.ax = touch.absolute-position.x + touch.width / 2; Tip.ay = touch.absolute-position.y; }
        else if (Tip.text == root.tip) { Tip.text = ""; }
    }
}
