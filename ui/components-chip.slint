// components-chip.slint — 数据展示类组件
// 所有内部 Text 必须是 CenterText / VCenterText / RightText，禁止裸写 Text {}。
import { Theme } from "theme.slint";
import { Tip, VCenterText } from "components-align.slint";

// ============ 等宽芯片（端口 / 标签 / 计数）============
export component MonoChip inherits Rectangle {
    in-out property <string> label: "";
    in-out property <string> tip: "";
    in-out property <bool> plain: false;
    in-out property <color> ink: Theme.ink_2;
    in-out property <length> fs: Theme.fs_xs;
    in-out property <length> rad: Theme.r_xs;

    border-radius: root.rad;
    background: root.plain ? transparent : Theme.line_2;

    HorizontalLayout {
        padding-left: 6px; padding-right: 6px;
        padding-top: 1px; padding-bottom: 2px;
        VCenterText {
            text: root.label; font-size: root.fs;
            color: root.ink; font-family: Theme.mono;
        }
    }

    touch := TouchArea { width: 100%; height: 100%; }
    private property <bool> tip_hover: touch.has-hover;
    changed tip_hover => {
        if (root.tip_hover && root.tip != "") { Tip.text = root.tip; Tip.ax = touch.absolute-position.x + touch.width / 2; Tip.ay = touch.absolute-position.y; }
        else if (Tip.text == root.tip) { Tip.text = ""; }
    }
}

// ============ 资源指标（图标 + 数值）============
export component Stat inherits Rectangle {
    in-out property <string> glyph: "";
    in-out property <string> value: "";
    in-out property <string> tip: "";

    HorizontalLayout {
        spacing: 4px; alignment: center;
        VCenterText { text: root.glyph; font-size: 11px; color: Theme.ink_3; }
        VCenterText {
            text: root.value; font-size: Theme.fs_sm; font-weight: 600;
            color: Theme.ink; font-family: Theme.mono;
        }
    }

    touch := TouchArea { width: 100%; height: 100%; }
    private property <bool> tip_hover: touch.has-hover;
    changed tip_hover => {
        if (root.tip_hover && root.tip != "") { Tip.text = root.tip; Tip.ax = touch.absolute-position.x + touch.width / 2; Tip.ay = touch.absolute-position.y; }
        else if (Tip.text == root.tip) { Tip.text = ""; }
    }
}

// ============ Compose 项目标签 ============
export component ProjTag inherits Rectangle {
    in-out property <string> label: "";
    in-out property <string> tip: "";
    in-out property <color> dot_color: Theme.accent;

    border-radius: Theme.r_xs;
    background: Theme.line_2;

    HorizontalLayout {
        padding-left: 6px; padding-right: 7px;
        padding-top: 2px; padding-bottom: 2px;
        spacing: 4px; alignment: center;
        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: root.dot_color; }
        VCenterText { text: root.label; font-size: Theme.fs_xs; font-weight: 700; color: Theme.ink_2; }
    }

    touch := TouchArea { width: 100%; height: 100%; }
    private property <bool> tip_hover: touch.has-hover;
    changed tip_hover => {
        if (root.tip_hover && root.tip != "") { Tip.text = root.tip; Tip.ax = touch.absolute-position.x + touch.width / 2; Tip.ay = touch.absolute-position.y; }
        else if (Tip.text == root.tip) { Tip.text = ""; }
    }
}
