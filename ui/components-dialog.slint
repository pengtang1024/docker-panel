// components-dialog.slint — Dialog 基类（严格对齐 prototype .dlg-head/.dlg-body/.dlg-footer）
import { Theme } from "theme.slint";
import { VCenterText } from "components-align.slint";
import { IconBtn } from "components-interact.slint";

/// BodySlot — Dialog body 插槽（子类 fill 内容）
export component BodySlot inherits Rectangle { @children }

/// FooterSlot — Dialog footer 插槽（预置右对齐布局）
/// prototype: .dlg-footer{padding:14px 20px;justify-content:flex-end;gap:8px}
export component FooterSlot inherits Rectangle {
    HorizontalLayout {
        width: 100%; height: 100%;
        spacing: 8px;
        Rectangle { horizontal-stretch: 1; }
        @children
    }
}

/// DialogShell — 通用对话框外壳
/// prototype: .overlay{position:absolute;inset:0;align-items:center;justify-content:center;z-index:30}
///           .dialog{background:var(--card);border-radius:16px;width:420px;box-shadow:var(--shadow-hover)}
/// 关键：作为 conditionally rendered overlay 必须显式 100%×100%，
/// 否则默认 0×0 导致遮罩不覆盖、居中公式算出负值。
export component DialogShell inherits Rectangle {
    width: 100%;
    height: 100%;
    in-out property <bool> open: false;
    in-out property <string> dlg_title: "";
    in-out property <string> dlg_subtitle: "";
    in-out property <length> card_width: 420px;
    callback close();

    background: Theme.overlay;
    visible: root.open;

    TouchArea { width: 100%; height: 100%; clicked => { root.close(); } }

    // Slint 1.18 不支持 backdrop-filter；居中用 VerticalLayout + HorizontalLayout 双重 alignment:center
    // ⚠️ 内层 layout 绝对不能设 100% 宽高——否则永远填满外层、alignment:center 失效
    HorizontalLayout {
        width: 100%; height: 100%;
        alignment: center;
        VerticalLayout {
            alignment: center;

            card := Rectangle {
                width: root.card_width;
                border-radius: Theme.r_dialog;
                background: Theme.card;
                border-width: 1px; border-color: Theme.line;
                clip: true;
                drop-shadow-color: Theme.shadow_hover;
                drop-shadow-blur: 32px;
                drop-shadow-offset-y: 4px;

                // Dialog 内部三段式：Header + Body + Footer
                VerticalLayout {
                    width: 100%; spacing: 0px;

                    // .dlg-head{padding:18px 20px 14px;border-bottom:1px solid var(--line)}
                    Rectangle {
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
                        HorizontalLayout {
                            width: 100%; height: 100%;
                            spacing: 0px; padding-left: 20px; padding-right: 20px;
                            padding-top: 18px; padding-bottom: 14px;

                            VerticalLayout {
                                horizontal-stretch: 1; spacing: 3px; alignment: start;
                                VCenterText {
                                    text: root.dlg_title;
                                    font-size: Theme.fs_lg; font-weight: 700; color: Theme.ink;
                                }
                                if root.dlg_subtitle != "" : VCenterText {
                                    text: root.dlg_subtitle;
                                    font-size: Theme.fs; color: Theme.ink_2;
                                }
                            }

                            IconBtn {
                                size: 28px; icon_size: 12px; icon_name: "x";
                                tip: @tr("Close");
                                clicked => { root.close(); }
                            }
                        }
                    }

                    // .dlg-body{padding:16px 20px}
                    VerticalLayout {
                        width: 100%;
                        padding-left: 20px; padding-right: 20px;
                        padding-top: 16px; padding-bottom: 16px;
                        body_slot := BodySlot { width: 100%; }
                    }

                    // .dlg-footer{padding:14px 20px;border-top:1px solid var(--line);justify-content:flex-end;gap:8px}
                    Rectangle {
                        width: 100%;
                        Rectangle { y: 0px; width: 100%; height: 1px; background: Theme.line; }
                        HorizontalLayout {
                            width: 100%; height: 100%;
                            padding-left: 20px; padding-right: 20px;
                            padding-top: 14px; padding-bottom: 14px;
                            footer_slot := FooterSlot { width: 100%; height: 100%; }
                        }
                    }
                }
            }  // card
        }  // inner VerticalLayout (alignment:center)
    }  // outer HorizontalLayout (alignment:center)
}  // DialogShell
