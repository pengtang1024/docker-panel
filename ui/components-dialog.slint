// components-dialog.slint — Dialog 基类
// ⚠️ Slint 1.18 关键约束（已验证）：
//   1. DialogShell 必须 inherits Rectangle！Material Modal 是裸组件，Window 层级不给 100% 尺寸
//   2. TouchArea 的 width/height:100% 不能正确解析父级 Rectangle，必须显式 root.width/height
//   3. 子类覆盖 slot 元素（:=）必须和父类声明在同一层级——否则 Slint 在根级新建实例
//      → 所以 DialogShell 只提供 card 容器 + @children，子类写完整 Header/Body/Footer
//   4. Slint 一个组件只能有一个 @children 入口
import { Theme } from "theme.slint";

/// DialogShell — 通用对话框外壳
/// 结构：全屏遮罩 TouchArea → 居中 card（硬值宽高）→ TouchArea 防穿透 → @children
/// 子类 inherits DialogShell 后，在根级写的 VerticalLayout（Header + Body + Footer）
/// 会被 @children 接收到 card 内部。
export component DialogShell inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <length> card_width: 420px;
    in-out property <length> card_height: 300px;
    callback close();

    width: 100%;
    height: 100%;
    visible: root.open;
    background: Theme.overlay;

    // 全屏 TouchArea（点击遮罩空白处关闭）
    // ⚠️ 必须显式 root.width/height——TouchArea 的 100% 对 Rectangle 父级不可靠
    TouchArea {
        width: root.width;
        height: root.height;
        clicked => { root.close(); }

        // 居中 card（硬值宽高，内容驱动的 layout.min_width/min_height 在 TouchArea 包装下不可靠）
        Rectangle {
            width: root.card_width;
            height: root.card_height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            border-radius: Theme.r_dialog;
            background: Theme.card;
            border-width: 1px; border-color: Theme.line;
            clip: true;

            // 内层 TouchArea 防穿透（card 内点击不会触发遮罩关闭）
            TouchArea {
                width: 100%;
                height: 100%;

                // @children：子类 inherits DialogShell 后写的完整 Header+Body+Footer 落到这里
                @children
            }
        }
    }
}
