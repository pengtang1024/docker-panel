// components-nav.slint — 导航类组件（TabBar + ListItem + Divider）
import { Theme } from "theme.slint";
import { VCenterText, CenterText } from "components-align.slint";
import { StateArea } from "components-state.slint";

// ============ TabItem — 单个 Tab（两种变体：icon+label / label+badge 计数）============
// 被 TabBar 内 for 循环渲染，也可独立使用
export component TabItem inherits Rectangle {
    in-out property <string> label: "";
    in-out property <int> idx: 0;
    in-out property <bool> active: false;
    in-out property <string> glyph: "";        // 可选前置图标
    in-out property <string> badge: "";        // 可选后置计数（ViewTab 用）
    callback clicked(int);

    width: self.preferred-width + 16px;

    area := StateArea {
        width: 100%; height: 100%;
        layer_color: Theme.row_hover;
        layer_radius: 0px;
        clicked => { root.clicked(root.idx); }
    }

    HorizontalLayout {
        width: 100%; height: 100%;
        padding-left: 8px; padding-right: 8px;
        alignment: center;
        spacing: 4px;

        if root.glyph != "" : VCenterText {
            text: root.glyph; font-size: 11px; color: root.active ? Theme.ink : Theme.ink_3;
        }

        VCenterText {
            text: root.label;
            font-size: Theme.fs_sm;
            font-weight: root.active ? 700 : 500;
            color: root.active ? Theme.ink : Theme.ink_3;
        }

        if root.badge != "" : VCenterText {
            text: root.badge;
            font-size: Theme.fs_sm; font-family: Theme.mono;
            color: root.active ? Theme.ink : Theme.ink_3;
        }
    }

    // active indicator（底部下划线）
    Rectangle {
        y: parent.height - 2px;
        width: 100%; height: 2px;
        background: root.active ? Theme.ink : transparent;
    }
}

// ============ TabBar — Tab 栏容器 ============
// 用法：TabBar { tabs: [TabItemSpec{...}, ...]; active_index <=> root.tab; }
// Slint 限制：for 循环不能配合 @children → 用数组属性驱动
struct TabItemSpec {
    label: string,
    glyph: string,
    badge: string,
}

export component TabBar inherits Rectangle {
    in-out property <[TabItemSpec]> tabs: [];
    in-out property <int> active_index: 0;
    callback selected(int);

    height: 40px;

    HorizontalLayout {
        width: 100%; height: 100%;
        spacing: 0px;
        alignment: center;

        for t[i] in root.tabs : TabItem {
            label: t.label;
            glyph: t.glyph;
            badge: t.badge;
            idx: i;
            active: i == root.active_index;
            clicked(idx) => { root.active_index = idx; root.selected(idx); }
        }
    }
}

// ============ ListItem — 通用列表行（icon + label + sublabel + trailing）============
export component ListItem inherits Rectangle {
    in-out property <string> icon: "";
    in-out property <string> label: "";
    in-out property <string> sublabel: "";
    in-out property <string> trailing: "";
    in-out property <bool> checked: false;
    callback clicked();
    callback toggled();

    height: 40px;

    area := StateArea {
        width: 100%; height: 100%;
        layer_color: Theme.row_hover;
        layer_radius: 0px;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        width: 100%; height: 100%;
        spacing: Theme.s3;
        padding-left: Theme.s4; padding-right: Theme.s4;
        alignment: center;

        if root.icon != "" : CenterText {
            text: root.icon; font-size: Theme.fs_md; width: 20px; height: 100%;
            color: Theme.ink_2;
        }

        VerticalLayout {
            horizontal-stretch: 1; spacing: 1px; alignment: center;
            VCenterText { text: root.label; font-size: Theme.fs_md; font-weight: 600; color: Theme.ink; overflow: elide; }
            if root.sublabel != "" : VCenterText { text: root.sublabel; font-size: Theme.fs_sm; color: Theme.ink_3; overflow: elide; }
        }

        if root.trailing != "" : VCenterText {
            text: root.trailing; font-size: Theme.fs_sm; font-family: Theme.mono; color: Theme.ink_3;
        }
    }
}

// ============ Divider — 水平分割线 ============
export component HorizontalDivider inherits Rectangle {
    height: 1px;
    width: 100%;
    background: Theme.line;
}

// ============ Divider — 垂直分割线 ============
export component VerticalDivider inherits Rectangle {
    width: 1px;
    height: 100%;
    background: Theme.line;
}
