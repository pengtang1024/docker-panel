// components.slint — 基础组件（布局纪律：只用 HorizontalLayout / VerticalLayout）
import { Theme } from "theme.slint";
import { LineEdit, CheckBox } from "std-widgets.slint";

// ============ 主按钮 / 次按钮 ============
export component Button inherits Rectangle {
    in-out property <string> text: "";
    in-out property <string> glyph: "";
    in-out property <bool> primary: false;
    in-out property <bool> danger: false;
    in-out property <bool> enabled: true;
    callback clicked();

    height: 28px;
    border-radius: 5px;
    border-width: root.primary ? 0px : 1px;
    border-color: root.danger ? Theme.err : Theme.line;
    background: root.primary ? Theme.accent
        : root.danger ? (touch.has-hover ? #3a2230 : Theme.bg-card)
        : touch.has-hover ? Theme.bg-row-hover
        : Theme.bg-card;
    opacity: root.enabled ? 1.0 : 0.35;

    touch := TouchArea {
        width: 100%; height: 100%;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        width: 100%; height: 100%;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Text {
                text: root.glyph;
                font-size: Theme.fs;
                color: root.primary ? Theme.bg-root : (root.danger ? Theme.err : Theme.fg-2);
                visible: root.glyph != "";
                vertical-alignment: center;
            }
            if root.glyph != "": Rectangle { width: 3px; height: 1px; }
            Text {
                text: root.text;
                font-size: Theme.fs;
                font-weight: 600;
                color: root.primary ? Theme.bg-root : (root.danger ? Theme.err : Theme.fg-2);
                vertical-alignment: center;
            }
        }
    }
}

// ============ 图标按钮 ============
export component IconBtn inherits Rectangle {
    in-out property <string> glyph: "";
    in-out property <bool> danger: false;
    callback clicked();

    width: 28px; height: 28px;
    border-radius: 5px;
    background: touch.has-hover ? (root.danger ? #3a2230 : Theme.bg-row-hover) : transparent;

    touch := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.glyph;
        font-size: Theme.fs-md;
        color: touch.has-hover ? (root.danger ? Theme.err : Theme.fg) : Theme.fg-3;
        width: 100%; height: 100%;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// ============ 状态圆点 ============
export component Dot inherits Rectangle {
    in-out property <bool> on: false;
    width: 8px; height: 8px;
    border-radius: 4px;
    background: root.on ? Theme.ok : Theme.off;
}

// ============ 连接状态徽章 ============
export component ConnBadge inherits Rectangle {
    in-out property <bool> online: false;
    height: 22px;
    border-radius: 11px;
    background: root.online ? #16342e : #3a2230;

    VerticalLayout {
        width: 100%; height: 100%;
        padding-left: 10px; padding-right: 10px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 6px; height: 6px; border-radius: 3px;
                background: root.online ? Theme.ok : Theme.err;
            }
            Rectangle { width: 5px; height: 1px; }
            Text {
                text: root.online ? "已连接" : "未连接";
                font-size: Theme.fs-sm;
                font-weight: 600;
                color: root.online ? Theme.ok : Theme.err;
                vertical-alignment: center;
            }
        }
    }
}

// ============ 搜索框 ============
export component SearchBox inherits Rectangle {
    in-out property <string> placeholder: "搜索容器、镜像...";
    callback accepted(string);

    height: 28px;
    border-radius: 5px;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.accent : Theme.line;
    background: Theme.bg-card;

    HorizontalLayout {
        width: 100%; height: 100%;
        padding-left: 8px; padding-right: 4px;
        spacing: 4px;
        Text {
            text: "⌕";
            font-size: Theme.fs-md;
            color: Theme.fg-4;
            vertical-alignment: center;
        }
        LineEdit {
            vertical-stretch: 1;
            font-size: Theme.fs;
            placeholder-text: root.placeholder;
            accepted => { root.accepted(self.text); }
        }
    }
    touch := TouchArea {
        x: parent.width - 36px; y: 0;
        width: 36px; height: 100%;
    }
}

// ============ 复选框（表格内用，纯几何不用 std 控件）============
export component CheckCell inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled();

    width: 16px; height: 16px;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : (touch.has-hover ? Theme.fg-3 : Theme.line);
    background: root.checked ? Theme.accent : (touch.has-hover ? Theme.bg-row-hover : transparent);

    touch := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.toggled(); }
    }

    if root.checked: Text {
        text: "✓";
        font-size: 11px;
        font-weight: 700;
        color: Theme.bg-root;
        width: 100%; height: 100%;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

// ============ 左侧导航项 ============
export component NavItem inherits Rectangle {
    in-out property <string> glyph: "";
    in-out property <string> label: "";
    in-out property <int> count: 0;
    in-out property <bool> active: false;
    callback clicked();

    height: 34px;
    background: root.active ? Theme.bg-row-sel : (touch.has-hover ? Theme.bg-row-hover : transparent);

    touch := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.clicked(); }
    }

    // 左侧高亮条
    Rectangle {
        x: 0; y: 0;
        width: 3px; height: 100%;
        background: Theme.accent;
        visible: root.active;
    }

    VerticalLayout {
        x: 3px; width: parent.width - 3px; height: 100%;
        padding-left: 12px; padding-right: 10px;
        spacing: 0px;
        HorizontalLayout {
            spacing: 9px;
            alignment: center;
            Rectangle {
                width: 18px; height: 100%;
                Text {
                    text: root.glyph;
                    font-size: Theme.fs-md;
                    color: root.active ? Theme.accent : Theme.fg-3;
                    width: 100%; height: 100%;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
            Text {
                text: root.label;
                font-size: Theme.fs-md;
                font-weight: root.active ? 700 : 400;
                color: root.active ? Theme.fg : Theme.fg-3;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.count > 0: Text {
                text: root.count;
                font-size: Theme.fs-sm;
                color: root.active ? Theme.accent : Theme.fg-4;
                vertical-alignment: center;
            }
        }
    }
}

// ============ Tab 项 ============
export component TabItem inherits Rectangle {
    in-out property <string> label: "";
    in-out property <bool> active: false;
    callback clicked();

    height: 100%;
    background: touch.has-hover ? Theme.bg-row-hover : transparent;

    touch := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        font-size: Theme.fs-md;
        font-weight: root.active ? 700 : 400;
        color: root.active ? Theme.accent : Theme.fg-3;
        width: 100%; height: 100%;
        horizontal-alignment: center; vertical-alignment: center;
    }

    Rectangle {
        x: 0; y: parent.height - 2px;
        width: parent.width; height: 2px;
        background: Theme.accent;
        visible: root.active;
    }
}

// ============ 可排序表头单元格 ============
export component SortCell inherits Rectangle {
    in-out property <string> label: "";
    in-out property <int> field: 0;
    in-out property <int> sort_field: 0;
    in-out property <bool> sort_desc: false;
    in-out property <bool> align-right: false;
    callback sort(int);

    height: 100%;
    border-radius: 4px;
    background: touch.has-hover ? Theme.bg-row-hover : transparent;

    touch := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.sort(root.field); }
    }

    VerticalLayout {
        width: 100%; height: 100%;
        padding-left: 6px; padding-right: 6px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            if root.align-right: Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.label;
                font-size: Theme.fs-xs;
                font-weight: 700;
                color: root.sort_field == root.field ? Theme.accent : Theme.fg-3;
                vertical-alignment: center;
            }
            if root.sort_field == root.field: Text {
                text: root.sort_desc ? "▾" : "▴";
                font-size: 9px;
                color: Theme.accent;
                vertical-alignment: center;
            }
            if root.align-right == false: Rectangle { horizontal-stretch: 1; }
        }
    }
}
