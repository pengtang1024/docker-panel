// components.slint — 原子组件系统（唯一可复用控件源）
// 纪律：
//   1. 仅使用 HorizontalLayout / VerticalLayout 布局容器
//   2. 所有颜色 / 尺寸 / 圆角 / 字体族走 Theme 令牌，禁止硬编码
//   3. 禁止 !expr 前缀否定，一律写 `expr == false`
//   4. 提示统一走全局 Tip + TipLayer（app.slint 顶层渲染），不在组件内自绘浮层
//      —— 自绘浮层会被 .card 的 clip 裁掉，且每处重复实现

import { Theme } from "theme.slint";

// ============ 全局提示总线（spec 3.5）============
// 交互元素 hover 时把文案与锚点（元素顶边中点，窗口坐标）写入 Tip，
// 由 app.slint 顶层 TipLayer 统一渲染在上方并做左右边界收敛。
export global Tip {
    in-out property <string> text: "";
    in-out property <length> ax: 0;   // 锚点 x：被 hover 元素中点（窗口坐标）
    in-out property <length> ay: 0;   // 锚点 y：被 hover 元素顶边（窗口坐标）
}

// ============ 卡片「···」菜单总线（spec 3.1 card-actions）============
// 菜单本体必须渲染在卡片区**之后**（Window 直接子元素）：卡片带 clip 且 Repeater
// 按源码顺序绘制，同层渲染会被下方卡片裁掉 / 覆盖。同一时刻只允许一个菜单展开，
// 故用一个全局单例承载 id + 类型 + 锚点，卡片只负责把请求冒泡上来。
export global CardMenu {
    in-out property <string> id: "";      // 空 = 未展开
    in-out property <int> kind: 0;        // 0=容器 1=镜像 2=网络 3=卷
    in-out property <bool> can_stop: false;
    in-out property <length> mx: 0;       // 菜单左上角（窗口坐标）
    in-out property <length> my: 0;

    public function close() { id = ""; }
}

export component TipLayer inherits Rectangle {
    // 尺寸由内容决定：Rectangle 根默认 100%×100%，必须显式绑到内层布局的 preferred-*
    width: row.preferred-width;
    height: row.preferred-height;
    background: Theme.tip_bg;
    border-radius: Theme.r_xs;
    drop-shadow-color: Theme.shadow;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 4px;
    opacity: Tip.text == "" ? 0.0 : 1.0;
    // prototype: setTimeout(...,300) 后淡入；消失不延迟（.12s）
    animate opacity { duration: 120ms; delay: Tip.text == "" ? 0ms : 300ms; easing: ease-out; }

    row := HorizontalLayout {
        // prototype .tip{padding:5px 9px}
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 5px;
        padding-bottom: 5px;
        Text {
            text: Tip.text;
            color: Theme.tip_ink;
            font-size: Theme.fs_sm;
            font-weight: 500;
        }
    }

    // 底部小三角箭头（朝下，指向锚点；绘制在泡泡外，故父组件不可设 clip）
    Path {
        x: (parent.width - 8px) / 2;
        y: parent.height;
        commands: "M 0 0 L 8 0 L 4 4 Z";
        fill: Theme.tip_bg;
    }
}

// ============ 图标按钮 ============
// 纯图标 + hover 底色 + 全局 Tip；primary=实心强调，danger=危险色
export component IconBtn inherits Rectangle {
    in-out property <string> glyph: "";
    in-out property <bool> primary: false;
    in-out property <bool> danger: false;
    in-out property <bool> active: false;
    in-out property <bool> enabled: true;
    in-out property <bool> outline: false;   // 卡片动作按钮：常态描边
    in-out property <bool> hidden: false;    // hover 才显形（不占交互命中）
    in-out property <length> size: 32px;
    in-out property <length> glyph_size: 16px;
    in-out property <string> tip: "";
    /// 常态底色：卡片上的按钮传 Theme.card（prototype .ca-main 底色 = var(--card)）
    in-out property <color> rest_bg: Theme.bg;
    /// hover 时的字形色：play → ok / restart → warn（prototype .ca-main.play:hover）
    in-out property <color> hover_fg: Theme.ink;
    /// 对外暴露 hover 态：卡片用它维持 hover 才显形的动作按钮，
    /// 避免「按钮显形→hover 被按钮抢走→按钮消失」的抖动
    out property <bool> hovered: touch.has-hover;
    callback clicked();

    width: root.size;
    height: root.size;
    border-radius: Theme.r_sm;
    border-width: (root.primary || (root.outline == false && root.active == false)) ? 0px : 1px;
    border-color: root.outline ? Theme.line : Theme.ok;
    background: root.primary ? Theme.ink
        : root.active ? Theme.pill_on_bg
        : (root.danger && touch.has-hover) ? Theme.err_bg
        : touch.has-hover ? (root.outline ? Theme.bg : Theme.row_hover)
        : root.rest_bg;
    opacity: root.hidden ? 0.0 : (root.enabled ? 1.0 : 0.4);
    animate opacity { duration: 120ms; easing: ease-out; }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled && root.hidden == false;
        clicked => { root.clicked(); }
    }

    Text {
        text: root.glyph;
        font-size: root.glyph_size;
        color: root.primary ? Theme.card
            : root.active ? Theme.ok
            : root.danger ? Theme.err
            : touch.has-hover ? root.hover_fg
            : Theme.ink_2;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // changed 只接受普通标识符（不能写 child.prop）
    changed hovered => {
        if (root.hovered && root.tip != "") {
            Tip.text = root.tip;
            Tip.ax = touch.absolute-position.x + touch.width / 2;
            Tip.ay = touch.absolute-position.y;
        } else if (Tip.text == root.tip) {
            Tip.text = "";
        }
    }
}

// ============ 状态圆点 ============
// 运行=ok 绿点，停止=stop 灰点；仅几何，无文字
export component Dot inherits Rectangle {
    in-out property <bool> on: false;
    in-out property <string> tip: "";
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.on ? Theme.ok : Theme.stop;

    touch := TouchArea { width: 100%; height: 100%; }

    // changed 只接受普通标识符（不能写 child.prop），故用私有属性承接 hover 态
    private property <bool> tip_hover: touch.has-hover;
    changed tip_hover => {
        if (root.tip_hover && root.tip != "") {
            Tip.text = root.tip;
            Tip.ax = touch.absolute-position.x + touch.width / 2;
            Tip.ay = touch.absolute-position.y;
        } else if (Tip.text == root.tip) {
            Tip.text = "";
        }
    }
}

// ============ 复选框 ============
export component CheckCell inherits Rectangle {
    in-out property <bool> checked: false;
    in-out property <length> box: 16px;
    callback toggled();

    width: root.box;
    height: root.box;
    border-radius: Theme.r_xs;
    border-width: 1px;
    border-color: root.checked ? Theme.ok : (touch.has-hover ? Theme.ink_3 : Theme.line);
    background: root.checked ? Theme.pill_on_bg : (touch.has-hover ? Theme.row_hover : transparent);

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.toggled(); }
    }

    if root.checked : Text {
        text: "✓";
        font-size: 11px;
        font-weight: 700;
        color: Theme.ok;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ============ 菜单项（下拉菜单 / 排序菜单共用）============
export component MenuItem inherits Rectangle {
    in-out property <string> glyph: "";
    in-out property <string> label: "";
    in-out property <bool> danger: false;
    in-out property <bool> active: false;
    callback clicked();

    height: 26px;
    border-radius: Theme.r_xs;
    background: touch.has-hover ? (root.danger ? Theme.err_bg : Theme.row_hover) : transparent;

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.s3;
        padding-left: Theme.s3;
        padding-right: Theme.s3;
        Text {
            text: root.glyph;
            font-size: 11px;
            width: 14px;
            vertical-alignment: center;
            color: root.danger ? Theme.err : Theme.ink_3;
        }
        Text {
            text: root.label;
            font-size: Theme.fs;
            vertical-alignment: center;
            color: root.active ? Theme.ink : (root.danger ? Theme.err : Theme.ink_2);
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// ============ 下拉菜单外壳 ============
// 固定宽度（避免 width 由内容反向推导形成布局循环），圆角 + 阴影 + 4px 内边距
export component Dropdown inherits Rectangle {
    in-out property <length> dw: 124px;
    width: root.dw;
    border-radius: Theme.r_md;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    drop-shadow-color: Theme.shadow;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 3px;

    VerticalLayout {
        width: 100%;
        spacing: 1px;
        padding: 4px;
        @children
    }
}

// ============ 等宽芯片（端口 / 标签 / 计数）============
export component MonoChip inherits Rectangle {
    in-out property <string> label: "";
    in-out property <string> tip: "";
    in-out property <bool> plain: false;   // plain=无底色（port-more）
    in-out property <color> ink: Theme.ink_2;
    in-out property <length> fs: Theme.fs_xs;
    in-out property <length> rad: Theme.r_xs;

    border-radius: root.rad;
    background: root.plain ? transparent : Theme.line_2;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 1px;
        padding-bottom: 2px;
        Text {
            text: root.label;
            font-size: root.fs;
            color: root.ink;
            font-family: Theme.mono;
            vertical-alignment: center;
        }
    }

    touch := TouchArea { width: 100%; height: 100%; }

    // changed 只接受普通标识符（不能写 child.prop），故用私有属性承接 hover 态
    private property <bool> tip_hover: touch.has-hover;
    changed tip_hover => {
        if (root.tip_hover && root.tip != "") {
            Tip.text = root.tip;
            Tip.ax = touch.absolute-position.x + touch.width / 2;
            Tip.ay = touch.absolute-position.y;
        } else if (Tip.text == root.tip) {
            Tip.text = "";
        }
    }
}

// ============ 资源指标（图标 + 数值）============
export component Stat inherits Rectangle {
    in-out property <string> glyph: "";
    in-out property <string> value: "";
    in-out property <string> tip: "";

    HorizontalLayout {
        spacing: 4px;
        alignment: center;
        Text {
            text: root.glyph;
            font-size: 11px;
            color: Theme.ink_3;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            font-size: Theme.fs_sm;
            font-weight: 600;
            color: Theme.ink;
            font-family: Theme.mono;
            vertical-alignment: center;
        }
    }

    touch := TouchArea { width: 100%; height: 100%; }

    // changed 只接受普通标识符（不能写 child.prop），故用私有属性承接 hover 态
    private property <bool> tip_hover: touch.has-hover;
    changed tip_hover => {
        if (root.tip_hover && root.tip != "") {
            Tip.text = root.tip;
            Tip.ax = touch.absolute-position.x + touch.width / 2;
            Tip.ay = touch.absolute-position.y;
        } else if (Tip.text == root.tip) {
            Tip.text = "";
        }
    }
}

// ============ 空状态（列表无数据 / 无匹配）============
// prototype .empty：大图标 + 标题 + 说明，垂直居中
export component EmptyState inherits Rectangle {
    in-out property <string> title: "";
    in-out property <string> desc: "";
    in-out property <string> glyph: "▢";

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        spacing: Theme.s3;
        Text {
            text: root.glyph;
            font-size: 40px;
            color: Theme.ink_4;
            horizontal-alignment: center;
        }
        Text {
            text: root.title;
            font-size: Theme.fs_md;
            font-weight: 700;
            color: Theme.ink_2;
            horizontal-alignment: center;
        }
        Text {
            text: root.desc;
            font-size: Theme.fs_sm;
            color: Theme.ink_3;
            horizontal-alignment: center;
        }
    }
}

// ============ Compose 项目标签 ============
export component ProjTag inherits Rectangle {
    in-out property <string> label: "";
    in-out property <string> tip: "";
    in-out property <color> dot_color: Theme.accent;

    border-radius: Theme.r_xs;
    background: Theme.line_2;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 7px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 4px;
        alignment: center;
        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.dot_color;
        }
        Text {
            text: root.label;
            font-size: Theme.fs_xs;
            font-weight: 700;
            color: Theme.ink_2;
            vertical-alignment: center;
        }
    }

    touch := TouchArea { width: 100%; height: 100%; }

    // changed 只接受普通标识符（不能写 child.prop），故用私有属性承接 hover 态
    private property <bool> tip_hover: touch.has-hover;
    changed tip_hover => {
        if (root.tip_hover && root.tip != "") {
            Tip.text = root.tip;
            Tip.ax = touch.absolute-position.x + touch.width / 2;
            Tip.ay = touch.absolute-position.y;
        } else if (Tip.text == root.tip) {
            Tip.text = "";
        }
    }
}
