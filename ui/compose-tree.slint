// compose-tree.slint — Compose 侧栏树（项目 → 服务两级）
//
// 定位：容器视图左侧的导航栏（208px），替代筛选栏里平铺的 compose chips。
// 形态：全部容器 / 项目（可展开 → 服务）/ 独立容器。
// 交互：点箭头 = 展开收起（**不改筛选**）；点标签 = 选中该范围（改筛选）；再点一次取消。
//
// ⚠️ 命中顺序铁律（AGENTS.md 规范 #19）：展开箭头的 TouchArea 必须声明在
//    标签 TouchArea **之前** —— Slint 按声明顺序命中，后声明的兄弟节点先拿事件，
//    反过来会让标签点击永远抢不到箭头。
//
// ⚠️ 列表必须用 ListView 而不是 ScrollView + VerticalLayout：Flickable 的
//    非布局子元素高度默认吃到 100% 视口高，多行会被等比压扁、永不溢出（见
//    drawer.slint 的实测记录）。ListView 由运行时逐项读 delegate.height 累加内容高。
import { Theme } from "theme.slint";
import { VCenterText } from "components-align.slint";
import { StateArea } from "components-state.slint";
import { ComposeNode } from "models.slint";
import { ListView } from "@material";

/// 树节点行（26px）
component NodeRow inherits Rectangle {
    in property <ComposeNode> data;
    /// 选中节点：kind / project / service
    callback select(int, string, string);
    /// 展开收起项目：project
    callback toggle(string);

    height: 26px;
    background: root.data.selected ? Theme.row_sel : transparent;

    // 选中态：左侧 2px 强调条
    // contains_selected（子树里藏着选中项）也留条 —— 否则收起项目后筛选凭空消失
    if (root.data.selected || root.data.contains_selected) : Rectangle {
        x: 0px;
        width: 2px;
        height: 26px;
        background: Theme.accent;
    }

    // —— 展开箭头（仅项目节点）——
    // ⚠️ 声明在标签热区之前（命中顺序铁律）
    if root.data.kind == 1 : Rectangle {
        x: 8px;
        width: 14px;
        height: 26px;
        StateArea {
            layer_color: Theme.ink_3;
            layer_radius: Theme.r_xs;
            clicked => { root.toggle(root.data.project); }
        }
        Path {
            width: 10px;
            height: 10px;
            commands: root.data.expanded ? "M6 9l6 6 6-6" : "M9 6l6 6-6 6";
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: 24;
            viewbox-height: 24;
            stroke: Theme.ink_3;
            stroke-width: 2px;
            stroke-line-cap: round;
            stroke-line-join: round;
            fill: transparent;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }

    // —— 标签区（点选 / 取消选中）——
    // 服务节点缩进到与项目名对齐（40px = 箭头槽 26 + 色点槽 8 + 间距 6）
    Rectangle {
        x: root.data.depth == 1 ? 40px : 26px;
        y: 0px;
        width: parent.width - self.x - 8px;
        height: 26px;
        StateArea {
            layer_color: Theme.ink;
            layer_radius: Theme.r_xs;
            clicked => { root.select(root.data.kind, root.data.project, root.data.service); }
        }
        HorizontalLayout {
            width: 100%;
            height: 100%;
            spacing: 6px;
            padding-right: 6px;
            cross-axis-alignment: center;

            // 项目色点（服务 / 独立容器不显示）
            if root.data.kind == 1 : Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.data.color;
            }

            VCenterText {
                horizontal-stretch: 1;
                min-width: 0px;
                text: root.data.label;
                font-size: Theme.fs;
                color: root.data.selected ? Theme.ink : Theme.ink_2;
                overflow: elide;
            }

            VCenterText {
                text: root.data.n;
                font-size: Theme.fs_xs;
                font-family: Theme.mono;
                color: Theme.ink_3;
            }
        }
    }
}

export component ComposeTree inherits Rectangle {
    in-out property <[ComposeNode]> nodes: [];
    /// 选中节点：kind / project / service
    callback select(int, string, string);
    /// 展开收起项目：project
    callback toggle(string);

    background: Theme.card;
    // 右侧分隔线
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.line;
    }

    list := ListView {
        vertical-stretch: 1;
        width: 100%;
        vertical-scrollbar-policy: as-needed;
        horizontal-scrollbar-policy: always-off;
        // 锁死横向 viewport：树是定宽导航，不允许横向拖拽
        content_width: self.visible_width;
        mouse_drag_pan_enabled: false;
        for node[i] in root.nodes : NodeRow {
            data: node;
            width: 100%;
            height: 26px;
            select(k, p, s) => { root.select(k, p, s); }
            toggle(p) => { root.toggle(p); }
        }
    }
}
