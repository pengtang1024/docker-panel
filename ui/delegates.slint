// delegates.slint — ListView 行视图
// Compose 分组标题 + stats 列 + Checkbox 多选 + 自绘按钮 + 右键菜单
import { HorizontalBox, CheckBox } from "std-widgets.slint";

export component StatusDot inherits Rectangle {
    width: 12px; height: 12px;
    border-radius: 6px;
    in-out property <bool> running: false;
    background: running ? #22c55e : #64748b;
}

export component RowButton inherits Rectangle {
    width: 28px; height: 26px;
    border-radius: 4px;
    in-out property <bool> hovered: false;
    background: hovered ? #334155 : transparent;
    callback clicked();
    TouchArea {
        x: 0; y: 0; width: parent.width; height: parent.height;
        property <bool> hovered2 <=> root.hovered;
        clicked => { root.clicked(); }
    }
}

export component ContainerRowDelegate inherits Rectangle {
    in-out property <string> row_id: "";
    in-out property <bool> is_group_start: false;
    in-out property <string> compose_project: "";
    in-out property <string> compose_service: "";
    in-out property <string> short_id: "";
    in-out property <string> name: "";
    in-out property <string> image: "";
    in-out property <string> status: "";
    in-out property <bool> is_running: false;
    in-out property <bool> is_selected: false;
    in-out property <string> cpu_percent: "";
    in-out property <string> mem_usage: "";
    in-out property <string> net_traffic: "";

    callback toggle();
    callback restart();
    callback logs();
    callback remove();
    callback clicked();
    callback toggle_select();

    height: 36px;
    in-out property <bool> hovered: false;
    background: is_group_start ? #1a2332 : (is_selected ? #1e3a5f : transparent);

    ContextMenuArea {
        x: 0; y: 0; width: root.width; height: root.height;

        // —— 左键点击（选行看详情）——
        TouchArea {
            x: 16px; y: 0; width: parent.width - 16px; height: parent.height;
            property <bool> hovered2 <=> root.hovered;
            clicked => { root.clicked(); }
        }

        // —— 右键菜单 ——
        Menu {
            MenuItem { title: "查看详情"; activated => { root.clicked(); } }
            MenuItem { title: "查看日志"; activated => { root.logs(); } }
            MenuItem { title: root.is_running ? "停止" : "启动"; activated => { root.toggle(); } }
            MenuItem { title: "重启"; activated => { root.restart(); } }
            MenuItem { title: "删除"; activated => { root.remove(); } }
        }
    }

    // —— 分组标题行 ——
    if root.is_group_start: HorizontalBox {
        spacing: 8px;
        padding-left: 8px;
        padding-right: 8px;
        width: parent.width;
        height: parent.height;
        Text { text: "📁"; font-size: 14px; }
        Text {
            text: "Compose Project: " + root.compose_project;
            color: #22d3ee; font-size: 13px; font-weight: 700;
        }
        HorizontalLayout { }
    }

    // —— 普通容器行 ——
    if !root.is_group_start: HorizontalBox {
        spacing: 8px;
        padding-left: 4px;
        padding-right: 8px;
        width: parent.width;
        height: parent.height;

        CheckBox {
            checked <=> root.is_selected;
            toggled => { root.toggle_select(); }
        }
        StatusDot { running <=> root.is_running; }
        Text { text: root.short_id; min-width: 96px; color: #64748b; font-size: 12px; }

        HorizontalBox {
            spacing: 4px;
            min-width: 180px;
            HorizontalLayout { }
            Text {
                text: root.compose_service != "" ? (root.compose_service + " ") : "";
                color: #22d3ee; font-size: 11px; font-weight: 600;
            }
            Text { text: root.name; min-width: 120px; overflow: elide; color: #e2e8f0; }
        }

        Text { text: root.image; min-width: 100px; overflow: elide; color: #94a3b8; font-size: 12px; }
        HorizontalLayout { }
        Text { text: root.status; min-width: 80px; color: #cbd5e1; font-size: 12px; }

        Text {
            text: root.cpu_percent;
            min-width: 50px;
            color: root.cpu_percent != "" && root.cpu_percent != "0.0%" ? #fbbf24 : #64748b;
            font-size: 11px; horizontal-alignment: right;
        }
        Text {
            text: root.mem_usage;
            min-width: 80px;
            color: #94a3b8; font-size: 11px; horizontal-alignment: right;
        }

        RowButton {
            clicked => { root.toggle(); }
            Text { text: root.is_running ? "⏸" : "▶";
                   color: #cbd5e1; font-size: 12px;
                   x: 9px; height: parent.height; vertical-alignment: center; }
        }
        RowButton {
            clicked => { root.restart(); }
            Text { text: "⟳"; color: #cbd5e1; font-size: 12px;
                   x: 9px; height: parent.height; vertical-alignment: center; }
        }
        RowButton {
            clicked => { root.logs(); }
            Text { text: "📋"; color: #cbd5e1; font-size: 12px;
                   x: 9px; height: parent.height; vertical-alignment: center; }
        }
        RowButton {
            clicked => { root.remove(); }
            Text { text: "🗑"; color: #cbd5e1; font-size: 12px;
                   x: 9px; height: parent.height; vertical-alignment: center; }
        }
    }
}

// —— 镜像行（暂不支持多选，保持原样）——
export component ImageRowDelegate inherits Rectangle {
    in-out property <string> row_id: "";
    in-out property <string> short_id: "";
    in-out property <string> name: "";
    in-out property <string> tag: "";
    in-out property <string> size: "";
    in-out property <int> containers: 0;

    callback remove();
    callback clicked();

    height: 36px;
    in-out property <bool> hovered: false;
    background: hovered ? #1e293b : transparent;

    ContextMenuArea {
        x: 0; y: 0; width: root.width; height: root.height;
        TouchArea {
            x: 0; y: 0; width: parent.width; height: parent.height;
            property <bool> hovered2 <=> root.hovered;
            clicked => { root.clicked(); }
        }
        Menu {
            MenuItem { title: "查看详情"; activated => { root.clicked(); } }
            MenuItem { title: "删除"; activated => { root.remove(); } }
        }
    }

    HorizontalBox {
        spacing: 8px;
        padding-left: 8px;
        padding-right: 8px;
        width: parent.width;
        height: parent.height;

        Text { text: root.short_id; min-width: 96px; color: #64748b; font-size: 12px; }
        Text { text: root.name; min-width: 200px; overflow: elide; color: #e2e8f0; }
        Text { text: ":" + root.tag; color: #22d3ee; min-width: 100px; font-size: 12px; }
        HorizontalLayout { }
        Text {
            text: root.containers > 0 ? (root.containers + " 使用中") : "未使用";
            min-width: 80px; font-size: 12px;
            color: root.containers > 0 ? #22c55e : #f59e0b;
        }
        Text { text: root.size; min-width: 80px; color: #94a3b8; font-size: 12px; }
        RowButton {
            clicked => { root.remove(); }
            Text { text: "🗑"; color: #cbd5e1; font-size: 12px;
                   x: 9px; height: parent.height; vertical-alignment: center; }
        }
    }
}
