// delegates.slint — ListView 的行视图组件
// 只声明 callback 属性，MainWindow 在 for 循环里把 AppActions 回调注入。

import { Button, HorizontalBox } from "std-widgets.slint";

export component ContainerRowDelegate inherits HorizontalBox {
    in-out property <string> row_id: "";
    in-out property <string> short_id: "";
    in-out property <string> name: "";
    in-out property <string> image: "";
    in-out property <string> status: "";
    in-out property <bool> is_running: false;

    callback toggle();
    callback restart();
    callback logs();
    callback remove();

    spacing: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;

    Text {
        text: root.is_running ? "●" : "○";
        color: root.is_running ? #00c853 : #888;
        min-width: 16px;
    }
    Text {
        text: root.short_id;
        min-width: 96px;
        color: #888;
    }
    Text {
        text: root.name;
        min-width: 140px;
        overflow: elide;
    }
    Text {
        text: root.image;
        min-width: 120px;
        overflow: elide;
        color: #aaa;
    }
    HorizontalLayout { }
    Text {
        text: root.status;
        min-width: 80px;
        color: #bbb;
    }
    Button {
        text: root.is_running ? "⏹" : "▶";
        min-width: 32px;
        clicked => { root.toggle(); }
    }
    Button {
        text: "⟳";
        min-width: 28px;
        clicked => { root.restart(); }
    }
    Button {
        text: "📋";
        min-width: 28px;
        clicked => { root.logs(); }
    }
    Button {
        text: "🗑";
        min-width: 28px;
        clicked => { root.remove(); }
    }
}

export component ImageRowDelegate inherits HorizontalBox {
    in-out property <string> row_id: "";
    in-out property <string> short_id: "";
    in-out property <string> name: "";
    in-out property <string> tag: "";
    in-out property <string> size: "";
    in-out property <int> containers: 0;

    callback remove();

    spacing: 8px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 4px;
    padding-bottom: 4px;

    Text {
        text: root.short_id;
        min-width: 96px;
        color: #888;
    }
    Text {
        text: root.name;
        min-width: 200px;
        overflow: elide;
    }
    Text {
        text: ":" + root.tag;
        color: #00bcd4;
        min-width: 100px;
    }
    HorizontalLayout { }
    Text {
        text: root.containers > 0 ? (root.containers + " 容器") : "未使用";
        min-width: 80px;
        color: root.containers > 0 ? #00c853 : #ff9800;
    }
    Text {
        text: root.size;
        min-width: 70px;
        color: #bbb;
    }
    Button {
        text: "🗑";
        min-width: 28px;
        clicked => { root.remove(); }
    }
}
