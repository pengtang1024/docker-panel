// delegates.slint — ListView 行视图
// Compose 分组标题 + stats 列 + Checkbox 多选 + 自绘按钮 + 右键菜单
import { HorizontalBox, CheckBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component StatusDot inherits Rectangle {
    width: 12px; height: 12px;
    border-radius: 6px;
    in-out property <bool> running: false;
    background: running ? Theme.status-running : Theme.status-stopped;
}

export component RowButton inherits Rectangle {
    width: 28px; height: 26px;
    border-radius: 4px;
    in-out property <bool> hovered: false;
    background: hovered ? Theme.bg-hover : transparent;
    callback clicked();
    TouchArea {
        x: 0; y: 0; width: parent.width; height: parent.height;
        property <bool> hovered2 <=> root.hovered;
        clicked => { root.clicked(); }
    }
}

export component ContainerRowDelegate inherits Rectangle {
    in-out property <string> row_id: "";
    in-out property <bool> is_group_start: false;
    in-out property <string> compose_project: "";
    in-out property <string> compose_service: "";
    in-out property <string> short_id: "";
    in-out property <string> name: "";
    in-out property <string> image: "";
    in-out property <string> status: "";
    in-out property <bool> is_running: false;
    in-out property <bool> is_selected: false;
    in-out property <string> cpu_percent: "";
    in-out property <string> mem_usage: "";
    in-out property <string> net_traffic: "";

    callback toggle();
    callback restart();
    callback logs();
    callback remove();
    callback clicked();
    callback toggle_select();

    height: 36px;
    in-out property <bool> hovered: false;
    background: is_group_start ? Theme.bg-group : (is_selected ? Theme.bg-selected : transparent);

    ContextMenuArea {
        x: 0; y: 0; width: root.width; height: root.height;

        // —— 左键点击（选行看详情）——
        TouchArea {
            x: Theme.space-4; y: 0; width: parent.width - Theme.space-4; height: parent.height;
            property <bool> hovered2 <=> root.hovered;
            clicked => { root.clicked(); }
        }

        // —— 右键菜单 ——
        Menu {
            MenuItem { title: "查看详情"; activated => { root.clicked(); } }
            MenuItem { title: "查看日志"; activated => { root.logs(); } }
            MenuItem { title: root.is_running ? "停止" : "启动"; activated => { root.toggle(); } }
            MenuItem { title: "重启"; activated => { root.restart(); } }
            MenuItem { title: "删除"; activated => { root.remove(); } }
        }
    }

    // —— 分组标题行 ——
    if root.is_group_start: HorizontalBox {
        spacing: Theme.space-3;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        width: parent.width;
        height: parent.height;
        Text { text: "📁"; font-size: 14px; }
        Text {
            text: "Compose Project: " + root.compose_project;
            color: Theme.accent; font-size: Theme.text-base; font-weight: 700;
        }
        HorizontalLayout { }
    }

    // —— 普通容器行 ——
    if !root.is_group_start: HorizontalBox {
        spacing: Theme.space-3;
        padding-left: Theme.space-1;
        padding-right: Theme.space-3;
        width: parent.width;
        height: parent.height;

        CheckBox {
            checked <=> root.is_selected;
            toggled => { root.toggle_select(); }
        }
        StatusDot { running <=> root.is_running; }
        Text { text: root.short_id; min-width: 96px; color: Theme.text-faint; font-size: Theme.text-sm; }

        HorizontalBox {
            spacing: Theme.space-1;
            min-width: 180px;
            HorizontalLayout { }
            Text {
                text: root.compose_service != "" ? (root.compose_service + " ") : "";
                color: Theme.accent; font-size: Theme.text-xs; font-weight: 600;
            }
            Text { text: root.name; min-width: 120px; overflow: elide; color: Theme.text-normal; }
        }

        Text { text: root.image; min-width: 100px; overflow: elide; color: Theme.text-muted; font-size: Theme.text-sm; }
        HorizontalLayout { }
        Text { text: root.status; min-width: 80px; color: Theme.text-secondary; font-size: Theme.text-sm; }

        Text {
            text: root.cpu_percent;
            min-width: 50px;
            color: root.cpu_percent != "" && root.cpu_percent != "0.0%" ? Theme.status-warning : Theme.text-faint;
            font-size: Theme.text-xs; horizontal-alignment: right;
        }
        Text {
            text: root.mem_usage;
            min-width: 80px;
            color: Theme.text-muted; font-size: Theme.text-xs; horizontal-alignment: right;
        }

        RowButton {
            clicked => { root.toggle(); }
            Text { text: root.is_running ? "⏸" : "▶";
                   color: Theme.text-secondary; font-size: Theme.text-sm;
                   x: 9px; height: parent.height; vertical-alignment: center; }
        }
        RowButton {
            clicked => { root.restart(); }
            Text { text: "⟳"; color: Theme.text-secondary; font-size: Theme.text-sm;
                   x: 9px; height: parent.height; vertical-alignment: center; }
        }
        RowButton {
            clicked => { root.logs(); }
            Text { text: "📋"; color: Theme.text-secondary; font-size: Theme.text-sm;
                   x: 9px; height: parent.height; vertical-alignment: center; }
        }
        RowButton {
            clicked => { root.remove(); }
            Text { text: "🗑"; color: Theme.text-secondary; font-size: Theme.text-sm;
                   x: 9px; height: parent.height; vertical-alignment: center; }
        }
    }
}

// —— 镜像行（暂不支持多选，保持原样）——
export component ImageRowDelegate inherits Rectangle {
    in-out property <string> row_id: "";
    in-out property <string> short_id: "";
    in-out property <string> name: "";
    in-out property <string> tag: "";
    in-out property <string> size: "";
    in-out property <int> containers: 0;

    callback remove();
    callback clicked();

    height: 36px;
    in-out property <bool> hovered: false;
    background: hovered ? Theme.bg-card : transparent;

    ContextMenuArea {
        x: 0; y: 0; width: root.width; height: root.height;
        TouchArea {
            x: 0; y: 0; width: parent.width; height: parent.height;
            property <bool> hovered2 <=> root.hovered;
            clicked => { root.clicked(); }
        }
        Menu {
            MenuItem { title: "查看详情"; activated => { root.clicked(); } }
            MenuItem { title: "删除"; activated => { root.remove(); } }
        }
    }

    HorizontalBox {
        spacing: Theme.space-3;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        width: parent.width;
        height: parent.height;

        Text { text: root.short_id; min-width: 96px; color: Theme.text-faint; font-size: Theme.text-sm; }
        Text { text: root.name; min-width: 200px; overflow: elide; color: Theme.text-normal; }
        Text { text: ":" + root.tag; color: Theme.accent; min-width: 100px; font-size: Theme.text-sm; }
        HorizontalLayout { }
        Text {
            text: root.containers > 0 ? (root.containers + " 使用中") : "未使用";
            min-width: 80px; font-size: Theme.text-sm;
            color: root.containers > 0 ? Theme.status-running : Theme.status-warning;
        }
        Text { text: root.size; min-width: 80px; color: Theme.text-muted; font-size: Theme.text-sm; }
        RowButton {
            clicked => { root.remove(); }
            Text { text: "🗑"; color: Theme.text-secondary; font-size: Theme.text-sm;
                   x: 9px; height: parent.height; vertical-alignment: center; }
        }
    }
}
