// delegates.slint — 表格数据行
// 对齐契约：本文件的每个行组件，其 HorizontalLayout 的子元素序列与
// headers.slint 中对应表头的子元素序列**逐个对应**，宽度取自同一组 Theme 常量。
import { Theme } from "theme.slint";
import { IconBtn, Dot, CheckCell } from "components.slint";

// ============ Compose 分组标题行 ============
export component RowGroup inherits Rectangle {
    in-out property <string> project: "";
    in-out property <int> count: 0;

    height: Theme.group-h;
    background: Theme.bg-group;

    VerticalLayout {
        width: 100%; height: 100%;
        padding-left: Theme.s4; padding-right: Theme.s4;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            spacing: Theme.s2;
            Text {
                text: "▾";
                font-size: 9px; color: Theme.accent;
                vertical-alignment: center;
            }
            Text {
                text: root.project;
                font-size: Theme.fs-sm; font-weight: 700; color: Theme.accent;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.count + " 个容器";
                font-size: Theme.fs-xs; color: Theme.fg-4;
                vertical-alignment: center;
            }
        }
    }
}

// ============ 容器行 ============
export component RowContainer inherits Rectangle {
    in-out property <string> id: "";
    in-out property <bool> is-group: false;
    in-out property <string> group: "";
    in-out property <int> group-count: 0;
    in-out property <string> service: "";
    in-out property <string> name: "";
    in-out property <string> image: "";
    in-out property <string> state: "";
    in-out property <bool> running: false;
    in-out property <bool> selected: false;
    in-out property <string> cpu: "";
    in-out property <string> mem: "";

    callback pick();
    callback toggle();
    callback logs();
    callback remove();
    callback pick-box();

    height: Theme.row-h;
    background: root.is-group ? Theme.bg-group
        : root.selected ? Theme.bg-row-sel
        : touch.has-hover ? Theme.bg-row-hover : transparent;

    touch := TouchArea {
        x: 0; y: 0;
        width: parent.width - Theme.c-act; height: 100%;
        clicked => { root.pick(); }
    }

    // 分组行
    if root.is-group: RowGroup {
        x: 0; y: 0; width: 100%; height: 100%;
        project: root.group; count: root.group-count;
    }

    // 数据行
    if root.is-group == false: VerticalLayout {
        x: 0; y: 0; width: 100%; height: 100%;
        padding-left: Theme.s4; padding-right: Theme.s4;
        alignment: center;
        HorizontalLayout {
            spacing: Theme.s2;
            alignment: center;

            // 1 checkbox
            Rectangle {
                width: Theme.c-check; height: 100%;
                HorizontalLayout {
                    alignment: center;
                    CheckCell {
                        checked <=> root.selected;
                        toggled => { root.pick-box(); }
                    }
                }
            }
            // 2 dot
            Rectangle {
                width: Theme.c-dot; height: 100%;
                HorizontalLayout {
                    alignment: center;
                    Dot { on <=> root.running; }
                }
            }
            // 3 name (flex)
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: Theme.s2;
                alignment: center;
                if root.service != "": Text {
                    text: root.service;
                    font-size: Theme.fs-xs; font-weight: 700; color: Theme.accent;
                    max-width: 100px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.name;
                    font-size: Theme.fs-md; color: Theme.fg-2;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            // 4 image
            Text {
                width: Theme.c-image;
                text: root.image;
                font-size: Theme.fs; color: Theme.fg-3;
                overflow: elide;
                vertical-alignment: center;
            }
            // 5 state
            Text {
                width: Theme.c-state;
                text: root.state;
                font-size: Theme.fs;
                color: root.running ? Theme.ok : Theme.fg-4;
                overflow: elide;
                vertical-alignment: center;
            }
            // 6 cpu
            Text {
                width: Theme.c-cpu;
                text: root.cpu;
                font-size: Theme.fs-sm;
                color: root.cpu == "" || root.cpu == "0.00%" ? Theme.fg-4 : Theme.warn;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            // 7 mem
            Text {
                width: Theme.c-mem;
                text: root.mem;
                font-size: Theme.fs-sm; color: Theme.fg-3;
                horizontal-alignment: right;
                overflow: elide;
                vertical-alignment: center;
            }
            // 8 actions
            HorizontalLayout {
                width: Theme.c-act; height: 100%;
                spacing: 0px;
                alignment: center;
                Rectangle { horizontal-stretch: 1; }
                IconBtn { glyph: root.running ? "■" : "▶"; clicked => { root.toggle(); } }
                IconBtn { glyph: "↻"; clicked => { root.restart(); } }
                IconBtn { glyph: "≡"; clicked => { root.logs(); } }
                IconBtn { glyph: "✕"; danger: true; clicked => { root.remove(); } }
            }
        }
    }
}

// ============ 镜像行 ============
export component RowImage inherits Rectangle {
    in-out property <string> id: "";
    in-out property <string> repo: "";
    in-out property <string> tag: "";
    in-out property <string> size: "";
    in-out property <int> used: 0;

    callback pick();
    callback remove();

    height: Theme.row-h;
    background: touch.has-hover ? Theme.bg-row-hover : transparent;

    touch := TouchArea {
        x: 0; y: 0;
        width: parent.width - 28px; height: 100%;
        clicked => { root.pick(); }
    }

    VerticalLayout {
        x: 0; y: 0; width: 100%; height: 100%;
        padding-left: Theme.s4; padding-right: Theme.s4;
        alignment: center;
        HorizontalLayout {
            spacing: Theme.s2;
            alignment: center;

            Text {
                horizontal-stretch: 1;
                text: root.repo;
                font-size: Theme.fs-md; color: Theme.fg-2;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                width: Theme.i-tag;
                text: root.tag;
                font-size: Theme.fs; color: Theme.accent;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                width: Theme.i-use;
                text: root.used > 0 ? (root.used + " 个") : "未使用";
                font-size: Theme.fs-sm;
                color: root.used > 0 ? Theme.ok : Theme.fg-4;
                vertical-alignment: center;
            }
            Text {
                width: Theme.i-size;
                text: root.size;
                font-size: Theme.fs-sm; color: Theme.fg-3;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            IconBtn { glyph: "✕"; danger: true; clicked => { root.remove(); } }
        }
    }
}

// ============ 网络行 ============
export component RowNetwork inherits Rectangle {
    in-out property <string> name: "";
    in-out property <string> driver: "";
    in-out property <string> scope: "";
    in-out property <int> used: 0;

    height: Theme.row-h;
    background: touch.has-hover ? Theme.bg-row-hover : transparent;

    touch := TouchArea { x: 0; y: 0; width: 100%; height: 100%; }

    VerticalLayout {
        x: 0; y: 0; width: 100%; height: 100%;
        padding-left: Theme.s4; padding-right: Theme.s4;
        alignment: center;
        HorizontalLayout {
            spacing: Theme.s2;
            alignment: center;

            Text {
                horizontal-stretch: 1;
                text: root.name;
                font-size: Theme.fs-md; color: Theme.fg-2;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                width: Theme.n-driver;
                text: root.driver;
                font-size: Theme.fs; color: Theme.accent;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                width: Theme.n-scope;
                text: root.scope;
                font-size: Theme.fs; color: Theme.fg-3;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                width: Theme.n-count;
                text: root.used > 0 ? root.used : "0";
                font-size: Theme.fs-sm; color: Theme.fg-4;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

// ============ 卷行 ============
export component RowVolume inherits Rectangle {
    in-out property <string> name: "";
    in-out property <string> driver: "";
    in-out property <string> mountpoint: "";

    height: Theme.row-h;
    background: touch.has-hover ? Theme.bg-row-hover : transparent;

    touch := TouchArea { x: 0; y: 0; width: 100%; height: 100%; }

    VerticalLayout {
        x: 0; y: 0; width: 100%; height: 100%;
        padding-left: Theme.s4; padding-right: Theme.s4;
        alignment: center;
        HorizontalLayout {
            spacing: Theme.s2;
            alignment: center;

            Text {
                horizontal-stretch: 1;
                text: root.name;
                font-size: Theme.fs-md; color: Theme.fg-2;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                width: Theme.n-driver;
                text: root.driver;
                font-size: Theme.fs; color: Theme.accent;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                text: root.mountpoint;
                font-size: Theme.fs-sm; color: Theme.fg-4;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
}
