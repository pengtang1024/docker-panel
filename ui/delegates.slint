// delegates.slint — ListView 行视图
// Compose 分组标题 + stats 列 + Checkbox 多选 + 自绘按钮 + 右键菜单
// 列宽用 Theme.col-* 常量，必须与 headers.slint 严格对齐
import { HorizontalBox, CheckBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

export component StatusDot inherits Rectangle {
    width: Theme.col-status-dot; height: Theme.col-status-dot;
    border-radius: 6px;
    in-out property <bool> running: false;
    background: running ? Theme.status-running : Theme.status-stopped;
}

export component RowButton inherits Rectangle {
    width: Theme.col-btn; height: 26px;
    border-radius: 4px;
    in-out property <bool> hovered: false;
    background: hovered ? Theme.bg-hover : transparent;
    callback clicked();
    TouchArea {
        x: 0; y: 0; width: parent.width; height: parent.height;
        property <bool> hovered2 <=> root.hovered;
        clicked => { root.clicked(); }
    }
}

// —— 带居中图标的 RowButton 内部 Text ——
// 用法：RowButton 内的 Text 用 width: 100% + horizontal-alignment: center
// 替代之前硬编码 x: 9px 偏移，避免不同 emoji 字宽下图标偏移

export component ContainerRowDelegate inherits Rectangle {
    in-out property <string> row_id: "";
    in-out property <bool> is_group_start: false;
    in-out property <string> compose_project: "";
    in-out property <string> compose_service: "";
    in-out property <string> short_id: "";
    in-out property <string> name: "";
    in-out property <string> image: "";
    in-out property <string> status: "";
    in-out property <bool> is_running: false;
    in-out property <bool> is_selected: false;
    in-out property <string> cpu_percent: "";
    in-out property <string> mem_usage: "";
    in-out property <string> net_traffic: "";

    callback toggle();
    callback restart();
    callback logs();
    callback remove();
    callback clicked();
    callback toggle_select();

    height: 36px;
    in-out property <bool> hovered: false;
    background: is_group_start ? Theme.bg-group : (is_selected ? Theme.bg-selected : transparent);

    ContextMenuArea {
        x: 0; y: 0; width: root.width; height: root.height;

        // —— 左键点击（选行看详情）——
        TouchArea {
            x: Theme.col-checkbox + Theme.col-status-dot + Theme.col-id + Theme.space-3 + Theme.space-1;
            // 跳过 CheckBox + StatusDot + short_id 的区域从 name 开始算... 简化：让 CheckBox 独占第一列，后面都可点击
            width: parent.width; height: parent.height;
            property <bool> hovered2 <=> root.hovered;
            clicked => { root.clicked(); }
        }

        // —— 右键菜单 ——
        Menu {
            MenuItem { title: "查看详情"; activated => { root.clicked(); } }
            MenuItem { title: "查看日志"; activated => { root.logs(); } }
            MenuItem { title: root.is_running ? "停止" : "启动"; activated => { root.toggle(); } }
            MenuItem { title: "重启"; activated => { root.restart(); } }
            MenuItem { title: "删除"; activated => { root.remove(); } }
        }
    }

    // —— 分组标题行 ——
    if root.is_group_start: HorizontalBox {
        spacing: Theme.space-3;
        padding-left: Theme.space-1;   // 与普通行保持一致起点
        padding-right: Theme.space-3;
        width: parent.width;
        height: parent.height;
        Text { text: "📁"; font-size: Theme.text-sm; }
        Text {
            text: "Compose Project: " + root.compose_project;
            color: Theme.accent; font-size: Theme.text-base; font-weight: 700;
        }
        HorizontalLayout { }
    }

    // —— 普通容器行（10 列与 header 严格对齐）——
    if root.is_group_start == false: HorizontalBox {
        spacing: Theme.space-3;
        padding-left: Theme.space-1;    // 与 header padding-left: space-1 对齐
        padding-right: Theme.space-3;
        width: parent.width;
        height: parent.height;

        // 1. CheckBox
        CheckBox {
            min-width: Theme.col-checkbox;
            checked <=> root.is_selected;
            toggled => { root.toggle_select(); }
        }
        // 2. 状态灯
        StatusDot { running <=> root.is_running; }
        // 3. 短 ID
        Text {
            text: root.short_id;
            min-width: Theme.col-id;
            color: Theme.text-faint;
            font-size: Theme.text-sm;
        }
        // 4. 服务名 + 容器名（可弹性）
        HorizontalBox {
            spacing: Theme.space-1;
            min-width: Theme.col-name;
            HorizontalLayout { }
            Text {
                text: root.compose_service != "" ? (root.compose_service + " ") : "";
                color: Theme.accent; font-size: Theme.text-xs; font-weight: 600;
            }
            Text {
                text: root.name;
                min-width: 120px;
                overflow: elide;
                color: Theme.text-normal;
            }
        }
        // 5. 镜像
        Text {
            text: root.image;
            min-width: Theme.col-image;
            overflow: elide;
            color: Theme.text-muted;
            font-size: Theme.text-sm;
        }

        HorizontalLayout { }

        // 6. 状态
        Text {
            text: root.status;
            min-width: Theme.col-status;
            color: Theme.text-secondary;
            font-size: Theme.text-sm;
        }
        // 7. CPU
        Text {
            text: root.cpu_percent;
            min-width: Theme.col-cpu;
            color: root.cpu_percent != "" && root.cpu_percent != "0.0%" ? Theme.status-warning : Theme.text-faint;
            font-size: Theme.text-xs;
            horizontal-alignment: right;
        }
        // 8. 内存
        Text {
            text: root.mem_usage;
            min-width: Theme.col-mem;
            color: Theme.text-muted;
            font-size: Theme.text-xs;
            horizontal-alignment: right;
        }

        // 9-12. 四个 RowButton（图标用 width:100% + horizontal-alignment:center 居中）
        RowButton {
            clicked => { root.toggle(); }
            Text {
                text: root.is_running ? "⏸" : "▶";
                color: Theme.text-secondary;
                font-size: Theme.text-sm;
                height: parent.height; width: parent.width;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        RowButton {
            clicked => { root.restart(); }
            Text {
                text: "⟳"; color: Theme.text-secondary; font-size: Theme.text-sm;
                height: parent.height; width: parent.width;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        RowButton {
            clicked => { root.logs(); }
            Text {
                text: "📋"; color: Theme.text-secondary; font-size: Theme.text-sm;
                height: parent.height; width: parent.width;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        RowButton {
            clicked => { root.remove(); }
            Text {
                text: "🗑"; color: Theme.text-secondary; font-size: Theme.text-sm;
                height: parent.height; width: parent.width;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}

// —— 镜像行 ——
export component ImageRowDelegate inherits Rectangle {
    in-out property <string> row_id: "";
    in-out property <string> short_id: "";
    in-out property <string> name: "";
    in-out property <string> tag: "";
    in-out property <string> size: "";
    in-out property <int> containers: 0;

    callback remove();
    callback clicked();

    height: 36px;
    in-out property <bool> hovered: false;
    background: hovered ? Theme.bg-card : transparent;

    ContextMenuArea {
        x: 0; y: 0; width: root.width; height: root.height;
        TouchArea {
            x: 0; y: 0; width: parent.width; height: parent.height;
            property <bool> hovered2 <=> root.hovered;
            clicked => { root.clicked(); }
        }
        Menu {
            MenuItem { title: "查看详情"; activated => { root.clicked(); } }
            MenuItem { title: "删除"; activated => { root.remove(); } }
        }
    }

    HorizontalBox {
        spacing: Theme.space-3;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        width: parent.width;
        height: parent.height;

        Text { text: root.short_id; min-width: Theme.col-id;   color: Theme.text-faint; font-size: Theme.text-sm; }
        Text { text: root.name;     min-width: Theme.col-name; color: Theme.text-normal; overflow: elide; }
        Text { text: ":" + root.tag; color: Theme.accent; min-width: Theme.col-tag; font-size: Theme.text-sm; }
        HorizontalLayout { }
        Text {
            text: root.containers > 0 ? (root.containers + " 使用中") : "未使用";
            min-width: Theme.col-usage; font-size: Theme.text-sm;
            color: root.containers > 0 ? Theme.status-running : Theme.status-warning;
        }
        Text { text: root.size; min-width: Theme.col-size; color: Theme.text-muted; font-size: Theme.text-sm; }
        RowButton {
            clicked => { root.remove(); }
            Text {
                text: "🗑"; color: Theme.text-secondary; font-size: Theme.text-sm;
                height: parent.height; width: parent.width;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}
