// detail-log-panel.slint — 右侧详情/日志面板（卡片化）
import { Theme } from "theme.slint";
import { TabItem } from "components.slint";
import { HorizontalBox } from "std-widgets.slint";
import { DetailPanel } from "detail-panel.slint";
import { LogPanel } from "log-panel.slint";
import { LogLineRow } from "models.slint";
import { ImageDetailPanel } from "image-detail-panel.slint";

export component DetailLogPanel inherits Rectangle {
    width: 320px;
    height: 100%;
    background: Theme.bg-surface;

    // —— 面板切换：0=容器详情 / 1=日志 / 2=镜像详情 ——
    in-out property <int> active_view: 0;

    // —— 容器详情属性（Tab 0）——
    in-out property <string> d_name: "";
    in-out property <string> d_state: "";
    in-out property <string> d_status: "";
    in-out property <string> d_image: "";
    in-out property <string> d_id: "";
    in-out property <string> d_pid: "";
    in-out property <string> d_exit: "";
    in-out property <string> d_created: "";
    in-out property <string> d_started: "";
    in-out property <string> d_restart: "";
    in-out property <string> d_netmode: "";
    in-out property <string> d_ports: "";
    in-out property <string> d_mounts: "";
    in-out property <string> d_networks: "";
    in-out property <string> d_entry: "";
    in-out property <string> d_cmd: "";
    in-out property <string> d_workdir: "";
    in-out property <string> d_labels: "";

    // —— 镜像详情属性（Tab 2）——
    in-out property <string> i_short_id: "";
    in-out property <string> i_repo_tags: "";
    in-out property <string> i_created: "";
    in-out property <string> i_author: "";
    in-out property <string> i_size: "";
    in-out property <string> i_platform: "";
    in-out property <string> i_entrypoint: "";
    in-out property <string> i_cmd: "";
    in-out property <string> i_workdir: "";
    in-out property <string> i_ports: "";
    in-out property <string> i_volumes: "";
    in-out property <string> i_labels: "";
    in-out property <string> i_env: "";
    in-out property <string> i_id: "";

    // —— 日志行（Tab 1）——
    in-out property <[LogLineRow]> log_lines: [];

    // 左侧分隔线
    Rectangle { background: Theme.divider; width: 1px; height: parent.height; x: 0px; y: 0px; }

    // Tab 头（3 Tab：详情 / 日志 / 镜像）
    Rectangle {
        width: parent.width;
        height: 36px;
        background: Theme.bg-surface;
        x: 0px; y: 0px;

        HorizontalBox {
            x: 0; y: 0; width: parent.width; height: parent.height;
            spacing: 0px;

            TabItem {
                width: parent.width / 3;
                label: "详情";
                active: root.active_view == 0;
                clicked => { root.active_view = 0; }
            }
            TabItem {
                width: parent.width / 3;
                label: "日志";
                active: root.active_view == 1;
                clicked => { root.active_view = 1; }
            }
            TabItem {
                width: parent.width / 3;
                label: "镜像";
                active: root.active_view == 2;
                clicked => { root.active_view = 2; }
            }
        }
    }
    Rectangle { background: Theme.divider; width: parent.width; height: 1px; x: 0px; y: 36px; }

    // 面板内容（条件渲染）
    if root.active_view == 0: DetailPanel {
        x: 0px; y: 37px; width: parent.width; height: parent.height - 37px;
        d_name <=> root.d_name; d_state <=> root.d_state; d_status <=> root.d_status;
        d_image <=> root.d_image; d_id <=> root.d_id; d_pid <=> root.d_pid;
        d_exit <=> root.d_exit; d_created <=> root.d_created; d_started <=> root.d_started;
        d_restart <=> root.d_restart; d_netmode <=> root.d_netmode; d_ports <=> root.d_ports;
        d_mounts <=> root.d_mounts; d_networks <=> root.d_networks; d_entry <=> root.d_entry;
        d_cmd <=> root.d_cmd; d_workdir <=> root.d_workdir; d_labels <=> root.d_labels;
    }
    if root.active_view == 1: LogPanel {
        x: 0px; y: 37px; width: parent.width; height: parent.height - 37px;
        log_lines <=> root.log_lines;
    }
    if root.active_view == 2: ImageDetailPanel {
        x: 0px; y: 37px; width: parent.width; height: parent.height - 37px;
        i_short_id <=> root.i_short_id; i_repo_tags <=> root.i_repo_tags;
        i_created <=> root.i_created; i_author <=> root.i_author;
        i_size <=> root.i_size; i_platform <=> root.i_platform;
        i_entrypoint <=> root.i_entrypoint; i_cmd <=> root.i_cmd;
        i_workdir <=> root.i_workdir; i_ports <=> root.i_ports;
        i_volumes <=> root.i_volumes; i_labels <=> root.i_labels;
        i_env <=> root.i_env; i_id <=> root.i_id;
    }
}
