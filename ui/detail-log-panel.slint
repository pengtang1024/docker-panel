// detail-log-panel.slint — 右侧详情/日志面板（条件渲染 + 自绘 Tab 头）
// 抽出来避免 app.slint 超 300 行

import { DetailPanel } from "detail-panel.slint";
import { LogPanel } from "log-panel.slint";
import { LogLineRow } from "models.slint";

// 🔄 右侧面板（自绘 Tab 头 + 条件渲染内容）
export component DetailLogPanel inherits Rectangle {
    width: 320px;
    height: 100%;
    background: #1e293b;

    // —— 面板切换：0=详情 / 1=日志 ——
    in-out property <int> active_view: 0;

    // —— 详情面板属性 ——
    in-out property <string> d_name: "";
    in-out property <string> d_state: "";
    in-out property <string> d_status: "";
    in-out property <string> d_image: "";
    in-out property <string> d_id: "";
    in-out property <string> d_pid: "";
    in-out property <string> d_exit: "";
    in-out property <string> d_created: "";
    in-out property <string> d_started: "";
    in-out property <string> d_restart: "";
    in-out property <string> d_netmode: "";
    in-out property <string> d_ports: "";
    in-out property <string> d_mounts: "";
    in-out property <string> d_networks: "";
    in-out property <string> d_entry: "";
    in-out property <string> d_cmd: "";
    in-out property <string> d_workdir: "";

    // —— 日志行 ——
    in-out property <[LogLineRow]> log_lines: [];

    // 左侧分隔线
    Rectangle { background: #334155; width: 1px; height: parent.height; x: 0px; y: 0px; }

    // Tab 头
    Rectangle {
        width: parent.width;
        height: 36px;
        background: #1e293b;
        x: 0px; y: 0px;

        Rectangle {
            width: 100px; height: parent.height;
            background: root.active_view == 0 ? #0f172a : transparent;
            TouchArea { x: 0; y: 0; width: parent.width; height: parent.height;
                        clicked => { root.active_view = 0; } }
            Text { text: "详情"; x: 12px; height: parent.height; vertical-alignment: center;
                   color: root.active_view == 0 ? #f1f5f9 : #94a3b8;
                   font-weight: root.active_view == 0 ? 700 : 400; }
            Rectangle { background: #22d3ee; width: parent.width; height: 2px;
                        y: parent.height - 2px; visible: root.active_view == 0; }
        }
        Rectangle {
            x: 100px;
            width: 100px; height: parent.height;
            background: root.active_view == 1 ? #0f172a : transparent;
            TouchArea { x: 0; y: 0; width: parent.width; height: parent.height;
                        clicked => { root.active_view = 1; } }
            Text { text: "日志"; x: 12px; height: parent.height; vertical-alignment: center;
                   color: root.active_view == 1 ? #f1f5f9 : #94a3b8;
                   font-weight: root.active_view == 1 ? 700 : 400; }
            Rectangle { background: #22d3ee; width: parent.width; height: 2px;
                        y: parent.height - 2px; visible: root.active_view == 1; }
        }
    }
    Rectangle { background: #334155; width: parent.width; height: 1px; x: 0px; y: 36px; }

    // 面板内容（条件渲染）
    if root.active_view == 0: DetailPanel {
        x: 0px; y: 37px; width: parent.width; height: parent.height - 37px;
        d_name <=> root.d_name; d_state <=> root.d_state; d_status <=> root.d_status;
        d_image <=> root.d_image; d_id <=> root.d_id; d_pid <=> root.d_pid;
        d_exit <=> root.d_exit; d_created <=> root.d_created; d_started <=> root.d_started;
        d_restart <=> root.d_restart; d_netmode <=> root.d_netmode; d_ports <=> root.d_ports;
        d_mounts <=> root.d_mounts; d_networks <=> root.d_networks; d_entry <=> root.d_entry;
        d_cmd <=> root.d_cmd; d_workdir <=> root.d_workdir;
    }
    if root.active_view == 1: LogPanel {
        x: 0px; y: 37px; width: parent.width; height: parent.height - 37px;
        log_lines <=> root.log_lines;
    }
}
