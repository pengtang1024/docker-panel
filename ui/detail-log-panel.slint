// detail-log-panel.slint — 右侧面板：容器详情 / 实时日志 / 镜像详情
// 三个视图互斥渲染，每个视图独立 ScrollView，高度由内容决定不截断。
import { Theme } from "theme.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { TabItem } from "components.slint";
import { SecTitle, Field, FieldBlock } from "detail-panel.slint";
import { LogLineRow, ContainerRow, ImageRow, NetworkRow, VolumeRow } from "models.slint";

// ============ 容器详情 ============
export component PaneContainer inherits Rectangle {
    in-out property <bool> has: false;
    in-out property <string> d_name: "";
    in-out property <string> d_state: "";
    in-out property <string> d_status: "";
    in-out property <string> d_image: "";
    in-out property <string> d_id: "";
    in-out property <string> d_pid: "";
    in-out property <string> d_exit: "";
    in-out property <string> d_created: "";
    in-out property <string> d_started: "";
    in-out property <string> d_restart: "";
    in-out property <string> d_netmode: "";
    in-out property <string> d_ports: "";
    in-out property <string> d_mounts: "";
    in-out property <string> d_networks: "";
    in-out property <string> d_entry: "";
    in-out property <string> d_cmd: "";
    in-out property <string> d_workdir: "";
    in-out property <string> d_labels: "";

    background: Theme.bg-side;

    // 空态
    if root.has == false: Text {
        text: "选择一个容器查看详情";
        font-size: Theme.fs; color: Theme.fg-4;
        width: 100%; height: 100%;
        horizontal-alignment: center; vertical-alignment: center;
    }

    if root.has: ScrollView {
        width: 100%; height: 100%;
        VerticalLayout {
            width: 100%;
            spacing: 0px;
            padding-bottom: Theme.s5;

            // 头部
            VerticalLayout {
                width: 100%;
                spacing: 2px;
                padding-left: Theme.s4; padding-right: Theme.s4;
                padding-top: Theme.s4; padding-bottom: Theme.s3;
                Text {
                    text: root.d_name;
                    font-size: Theme.fs-md; font-weight: 700; color: Theme.fg;
                    width: 100%; wrap: word-wrap; max-height: 36px;
                }
                Text {
                    text: root.d_image;
                    font-size: Theme.fs-xs; color: Theme.accent;
                    width: 100%; overflow: elide;
                }
            }

            Rectangle { width: 100%; height: 1px; background: Theme.line; }
            SecTitle { text: "基本信息"; width: 100%; }
            Field { k: "状态"; v: root.d_state; width: 100%; }
            Field { k: "描述"; v: root.d_status; width: 100%; }
            Field { k: "进程 PID"; v: root.d_pid; width: 100%; }
            Field { k: "退出码"; v: root.d_exit; width: 100%; }
            Field { k: "容器 ID"; v: root.d_id; width: 100%; }

            Rectangle { width: 100%; height: 1px; background: Theme.line; }
            SecTitle { text: "时间"; width: 100%; }
            Field { k: "创建"; v: root.d_created; width: 100%; }
            Field { k: "启动"; v: root.d_started; width: 100%; }
            Field { k: "重启"; v: root.d_restart; width: 100%; }

            Rectangle { width: 100%; height: 1px; background: Theme.line; }
            SecTitle { text: "网络"; width: 100%; }
            Field { k: "模式"; v: root.d_netmode; width: 100%; }
            Field { k: "端口"; v: root.d_ports; width: 100%; }
            Field { k: "网络"; v: root.d_networks; width: 100%; }
            FieldBlock { k: "挂载卷"; v: root.d_mounts; width: 100%; }

            Rectangle { width: 100%; height: 1px; background: Theme.line; }
            SecTitle { text: "运行配置"; width: 100%; }
            FieldBlock { k: "入口点"; v: root.d_entry; block-h: 46px; width: 100%; }
            FieldBlock { k: "命令"; v: root.d_cmd; block-h: 46px; width: 100%; }
            Field { k: "工作目录"; v: root.d_workdir; width: 100%; }
            FieldBlock { k: "Labels"; v: root.d_labels; block-h: 88px; width: 100%; }
        }
    }
}

// ============ 日志 ============
export component PaneLogs inherits Rectangle {
    in-out property <[LogLineRow]> lines: [];
    background: Theme.bg-side;

    if root.lines.length == 0: Text {
        text: "点击行末的 ≡ 查看日志";
        font-size: Theme.fs; color: Theme.fg-4;
        width: 100%; height: 100%;
        horizontal-alignment: center; vertical-alignment: center;
    }

    if root.lines.length > 0: ScrollView {
        width: 100%; height: 100%;
        ListView {
            width: 100%;
            for line in root.lines: Rectangle {
                width: 100%; height: 16px;
                Text {
                    x: Theme.s4; y: 0;
                    width: parent.width - 2 * Theme.s4; height: 100%;
                    text: line.text;
                    font-size: Theme.fs-xs; color: Theme.fg-3;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// ============ 镜像详情 ============
export component PaneImage inherits Rectangle {
    in-out property <string> i_repo: "";
    in-out property <string> i_short: "";
    in-out property <string> i_created: "";
    in-out property <string> i_author: "";
    in-out property <string> i_size: "";
    in-out property <string> i_platform: "";
    in-out property <string> i_entry: "";
    in-out property <string> i_cmd: "";
    in-out property <string> i_workdir: "";
    in-out property <string> i_ports: "";
    in-out property <string> i_volumes: "";
    in-out property <string> i_labels: "";
    in-out property <string> i_env: "";
    in-out property <string> i_id: "";

    background: Theme.bg-side;

    ScrollView {
        width: 100%; height: 100%;
        VerticalLayout {
            width: 100%;
            spacing: 0px;
            padding-bottom: Theme.s5;

            VerticalLayout {
                width: 100%;
                spacing: 2px;
                padding-left: Theme.s4; padding-right: Theme.s4;
                padding-top: Theme.s4; padding-bottom: Theme.s3;
                Text {
                    text: root.i_repo;
                    font-size: Theme.fs-md; font-weight: 700; color: Theme.fg;
                    width: 100%; wrap: word-wrap; max-height: 36px;
                }
                Text {
                    text: root.i_short;
                    font-size: Theme.fs-xs; color: Theme.accent;
                    width: 100%; overflow: elide;
                }
            }

            Rectangle { width: 100%; height: 1px; background: Theme.line; }
            SecTitle { text: "基本信息"; width: 100%; }
            Field { k: "镜像 ID"; v: root.i_short; width: 100%; }
            Field { k: "大小"; v: root.i_size; width: 100%; }
            Field { k: "平台"; v: root.i_platform; width: 100%; }
            Field { k: "创建"; v: root.i_created; width: 100%; }
            Field { k: "作者"; v: root.i_author; width: 100%; }

            Rectangle { width: 100%; height: 1px; background: Theme.line; }
            SecTitle { text: "运行配置"; width: 100%; }
            FieldBlock { k: "入口点"; v: root.i_entry; block-h: 46px; width: 100%; }
            FieldBlock { k: "命令"; v: root.i_cmd; block-h: 46px; width: 100%; }
            Field { k: "工作目录"; v: root.i_workdir; width: 100%; }
            Field { k: "端口"; v: root.i_ports; width: 100%; }
            FieldBlock { k: "卷"; v: root.i_volumes; block-h: 46px; width: 100%; }

            Rectangle { width: 100%; height: 1px; background: Theme.line; }
            SecTitle { text: "环境变量"; width: 100%; }
            FieldBlock { k: "Env"; v: root.i_env; block-h: 110px; width: 100%; }
            FieldBlock { k: "Labels"; v: root.i_labels; block-h: 88px; width: 100%; }
        }
    }
}

// ============ 右侧面板外壳 ============
export component DetailLogPanel inherits Rectangle {
    in-out property <int> tab: 0;    // 0 容器详情 / 1 日志 / 2 镜像详情
    in-out property <[LogLineRow]> log_lines: [];

    in-out property <bool> has_detail: false;
    in-out property <string> d_name: "";
    in-out property <string> d_state: "";
    in-out property <string> d_status: "";
    in-out property <string> d_image: "";
    in-out property <string> d_id: "";
    in-out property <string> d_pid: "";
    in-out property <string> d_exit: "";
    in-out property <string> d_created: "";
    in-out property <string> d_started: "";
    in-out property <string> d_restart: "";
    in-out property <string> d_netmode: "";
    in-out property <string> d_ports: "";
    in-out property <string> d_mounts: "";
    in-out property <string> d_networks: "";
    in-out property <string> d_entry: "";
    in-out property <string> d_cmd: "";
    in-out property <string> d_workdir: "";
    in-out property <string> d_labels: "";

    in-out property <string> i_repo: "";
    in-out property <string> i_short: "";
    in-out property <string> i_created: "";
    in-out property <string> i_author: "";
    in-out property <string> i_size: "";
    in-out property <string> i_platform: "";
    in-out property <string> i_entry: "";
    in-out property <string> i_cmd: "";
    in-out property <string> i_workdir: "";
    in-out property <string> i_ports: "";
    in-out property <string> i_volumes: "";
    in-out property <string> i_labels: "";
    in-out property <string> i_env: "";
    in-out property <string> i_id: "";

    background: Theme.bg-side;

    VerticalLayout {
        width: 100%; height: 100%;
        spacing: 0px;

        // Tab 栏
        Rectangle {
            width: 100%; height: Theme.tab-h;
            HorizontalLayout {
                width: 100%; height: 100%;
                padding-left: Theme.s3; padding-right: Theme.s3;
                spacing: Theme.s1;
                TabItem {
                    horizontal-stretch: 1;
                    label: "详情"; active: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                TabItem {
                    horizontal-stretch: 1;
                    label: "日志"; active: root.tab == 1;
                    clicked => { root.tab = 1; }
                }
                TabItem {
                    horizontal-stretch: 1;
                    label: "镜像"; active: root.tab == 2;
                    clicked => { root.tab = 2; }
                }
            }
            Rectangle { x: 0; y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
        }

        // 内容（互斥）
        if root.tab == 0: PaneContainer {
            width: 100%; vertical-stretch: 1;
            has <=> root.has_detail;
            d_name <=> root.d_name; d_state <=> root.d_state; d_status <=> root.d_status;
            d_image <=> root.d_image; d_id <=> root.d_id; d_pid <=> root.d_pid;
            d_exit <=> root.d_exit; d_created <=> root.d_created; d_started <=> root.d_started;
            d_restart <=> root.d_restart; d_netmode <=> root.d_netmode;
            d_ports <=> root.d_ports; d_mounts <=> root.d_mounts; d_networks <=> root.d_networks;
            d_entry <=> root.d_entry; d_cmd <=> root.d_cmd; d_workdir <=> root.d_workdir;
            d_labels <=> root.d_labels;
        }
        if root.tab == 1: PaneLogs {
            width: 100%; vertical-stretch: 1;
            lines <=> root.log_lines;
        }
        if root.tab == 2: PaneImage {
            width: 100%; vertical-stretch: 1;
            i_repo <=> root.i_repo; i_short <=> root.i_short;
            i_created <=> root.i_created; i_author <=> root.i_author;
            i_size <=> root.i_size; i_platform <=> root.i_platform;
            i_entry <=> root.i_entry; i_cmd <=> root.i_cmd;
            i_workdir <=> root.i_workdir; i_ports <=> root.i_ports;
            i_volumes <=> root.i_volumes; i_labels <=> root.i_labels;
            i_env <=> root.i_env; i_id <=> root.i_id;
        }
    }

    Rectangle { x: 0; y: 0; width: 1px; height: 100%; background: Theme.line; }
}
