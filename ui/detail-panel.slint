import { Theme } from "theme.slint";
// —— 详情面板 ——
// 展示 AppState.detail（ContainerDetail）的所有字段。
// 每次 inspect 结果到达 → pump_and_apply 更新 in-out 属性 → 面板刷新。

import { VerticalBox, ScrollView, HorizontalBox } from "std-widgets.slint";

export component DetailRow inherits HorizontalBox {
    in-out property <string> label: "";
    in-out property <string> value: "";

    spacing: Theme.space-3;
    padding-left: Theme.space-1;
    padding-right: Theme.space-1;
    padding-top: 2px;
    padding-bottom: 2px;

    Text {
        text: root.label;
        min-width: 88px;
        color: #888;
        font-size: Theme.text-sm;
    }
    Text {
        text: root.value;
        color: #ddd;
        font-size: Theme.text-sm;
        overflow: elide;
    }
}

export component DetailPanel inherits Rectangle {
    background: Theme.bg-surface;
    width: 100%;
    height: 100%;

    in-out property <bool> has_detail: false;

    // —— 基本信息 ——
    in-out property <string> d_name: "";
    in-out property <string> d_state: "";
    in-out property <string> d_status: "";
    in-out property <string> d_image: "";
    in-out property <string> d_id: "";
    in-out property <string> d_pid: "";
    in-out property <string> d_exit: "";
    in-out property <string> d_created: "";
    in-out property <string> d_started: "";
    in-out property <string> d_restart: "";
    in-out property <string> d_netmode: "";

    // —— 端口 / 挂载 / 网络 ——
    in-out property <string> d_ports: "";
    in-out property <string> d_mounts: "";
    in-out property <string> d_networks: "";

    // —— 运行配置 ——
    in-out property <string> d_entry: "";
    in-out property <string> d_cmd: "";
    in-out property <string> d_workdir: "";

    // —— Labels ——
    in-out property <string> d_labels: "";

    VerticalBox {
        spacing: 0px;
        padding: Theme.space-3;
        width: parent.width;
        height: parent.height;

        Text {
            text: "容器详情";
            font-size: 14px;
            font-weight: 700;
            color: #eee;
        }
        VerticalBox {
            padding-bottom: Theme.space-2;
            Text { text: root.d_name; font-size: Theme.text-xs; color: Theme.text-muted; }
        }
        Rectangle { height: 1px; background: Theme.bg-card; width: parent.width; }

        ScrollView {
            VerticalBox {
                spacing: 0px;
                width: parent.width;

                // —— 基本 ——
                VerticalBox { padding-top: Theme.space-3; padding-bottom: Theme.space-1; Text { text: "基本信息"; color: Theme.text-secondary; font-size: Theme.text-xs; } }
                DetailRow { label: "状态";    value: root.d_state; }
                DetailRow { label: "状态描述"; value: root.d_status; }
                DetailRow { label: "PID";      value: root.d_pid; }
                DetailRow { label: "退出码";   value: root.d_exit; }
                DetailRow { label: "镜像";     value: root.d_image; }
                DetailRow { label: "ID";       value: root.d_id; }
                DetailRow { label: "创建时间"; value: root.d_created; }
                DetailRow { label: "启动时间"; value: root.d_started; }
                DetailRow { label: "重启策略"; value: root.d_restart; }
                DetailRow { label: "网络模式"; value: root.d_netmode; }

                // —— 网络 ——
                VerticalBox { padding-top: Theme.space-3; padding-bottom: Theme.space-1; Text { text: "网络 / 端口"; color: Theme.text-secondary; font-size: Theme.text-xs; } }
                DetailRow { label: "端口";   value: root.d_ports; }
                DetailRow { label: "网络";   value: root.d_networks; }

                // —— 挂载 ——
                VerticalBox { padding-top: Theme.space-3; padding-bottom: Theme.space-1; Text { text: "挂载卷"; color: Theme.text-secondary; font-size: Theme.text-xs; } }
                DetailRow { label: "挂载"; value: root.d_mounts; }

                // —— 运行 ——
                VerticalBox { padding-top: Theme.space-3; padding-bottom: Theme.space-1; Text { text: "运行配置"; color: Theme.text-secondary; font-size: Theme.text-xs; } }
                DetailRow { label: "入口点"; value: root.d_entry; }
                DetailRow { label: "命令";   value: root.d_cmd; }
                DetailRow { label: "工作目录"; value: root.d_workdir; }

                // —— Labels ——
                VerticalBox { padding-top: Theme.space-3; padding-bottom: Theme.space-1; Text { text: "Labels"; color: Theme.text-secondary; font-size: Theme.text-xs; } }
                DetailRow { label: ""; value: root.d_labels; }
            }
        }
    }
}
