// detail-panel.slint — 详情字段渲染基元
// 设计：取消固定高度卡片（高度计算是溢出/截断的根源），
// 改为「小节标题 + 扁平行」平铺，高度由行数自然决定，外层 ScrollView 滚动。
import { Theme } from "theme.slint";

// ============ 小节标题 ============
export component SecTitle inherits Rectangle {
    in-out property <string> text: "";
    height: 26px;

    VerticalLayout {
        x: 0; y: 0; width: 100%; height: 100%;
        padding-left: Theme.s4; padding-right: Theme.s4;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle { width: 2px; height: 10px; background: Theme.accent; }
            Rectangle { width: 6px; height: 1px; }
            Text {
                text: root.text;
                font-size: Theme.fs-xs; font-weight: 700;
                color: Theme.fg-4;
                }
            Rectangle { horizontal-stretch: 1; }
        }
    }
}

// ============ 键值行 ============
export component Field inherits Rectangle {
    in-out property <string> k: "";
    in-out property <string> v: "";
    height: 21px;

    VerticalLayout {
        x: 0; y: 0; width: 100%; height: 100%;
        padding-left: Theme.s4; padding-right: Theme.s4;
        alignment: center;
        HorizontalLayout {
            spacing: Theme.s3;
            alignment: center;
            Text {
                width: 66px;
                text: root.k;
                font-size: Theme.fs-sm; color: Theme.fg-4;
                horizontal-alignment: right;
                }
            Text {
                horizontal-stretch: 1;
                text: root.v == "" ? "—" : root.v;
                font-size: Theme.fs-sm;
                color: root.v == "" ? Theme.fg-4 : Theme.fg-2;
                overflow: elide;
                }
        }
    }
}

// ============ 多行文本块 ============
export component FieldBlock inherits Rectangle {
    in-out property <string> k: "";
    in-out property <string> v: "";
    in-out property <length> block-h: 72px;

    VerticalLayout {
        width: 100%; height: 100%;
        spacing: 0px;

        VerticalLayout {
            width: 100%; height: 21px;
            padding-left: Theme.s4; padding-right: Theme.s4;
            alignment: center;
            HorizontalLayout {
                spacing: Theme.s3;
                alignment: center;
                Text {
                    width: 66px;
                    text: root.k;
                    font-size: Theme.fs-sm; color: Theme.fg-4;
                    horizontal-alignment: right;
                    }
                Text {
                    horizontal-stretch: 1;
                    text: "—";
                    font-size: Theme.fs-sm; color: Theme.fg-4;
                    }
            }
        }

        Rectangle {
            width: 100%; height: root.block-h;
            background: #0d1626;
            border-radius: 5px;
            border-width: 1px;
            border-color: Theme.line;

            Text {
                x: Theme.s3; y: Theme.s2;
                width: parent.width - 2 * Theme.s3;
                height: parent.height - 2 * Theme.s2;
                text: root.v == "" ? "—" : root.v;
                font-size: Theme.fs-xs; color: Theme.fg-3;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }
    }
}
