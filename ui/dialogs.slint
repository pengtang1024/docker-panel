// dialogs.slint — PullDialog / CleanupDialog（继承 DialogShell 基类）
import { Theme } from "theme.slint";
import { VCenterText, RightText } from "components-align.slint";
import { TextButton, CheckBox, ProgressBar } from "components-interact.slint";
import { TextField } from "components-form.slint";
import { DialogShell, BodySlot, FooterSlot } from "components-dialog.slint";

// ============ CleanItem — 清理行（严格对齐 prototype .check-row）============
// .check-row{padding:10px 12px;border:1px solid var(--line);border-radius:var(--r-md);margin-bottom:8px;display:flex;align-items:center;gap:12px}
component CleanItem inherits Rectangle {
    in-out property <bool> checked: true;
    in-out property <string> label: "";
    in-out property <string> desc: "";
    in-out property <string> glyph: "";
    in-out property <string> cnt: "";
    callback toggled();

    height: 52px;
    border-radius: Theme.r_md;
    border-width: 1px;
    border-color: root.checked ? Theme.ink_3 : Theme.line;
    background: root.checked ? Theme.bg : Theme.card;

    HorizontalLayout {
        width: 100%; height: 100%;
        spacing: 12px;
        padding-left: 12px; padding-right: 12px;

        CheckBox {
            checked <=> root.checked;
            toggled => { root.toggled(); }
        }

        VCenterText {
            text: root.glyph; font-size: Theme.fs_md; width: 20px;
            color: root.checked ? Theme.ink : Theme.ink_2;
        }

        VerticalLayout {
            VCenterText { text: root.label; font-size: Theme.fs_md; font-weight: 600; color: Theme.ink; overflow: elide; }
            VCenterText { text: root.desc; font-size: Theme.fs; color: Theme.ink_3; overflow: elide; }
        }

        VCenterText {
            text: root.cnt; font-size: Theme.fs;
            font-family: Theme.mono; color: Theme.ink_3;
        }
    }
}

// ============ PullDialog ============
export component PullDialog inherits DialogShell {
    in-out property <string> input: "";
    in-out property <bool> busy: false;
    in-out property <int> progress: 0;
    in-out property <string> status: "";
    callback submit(string);

    dlg_title: @tr("Pull Image");
    dlg_subtitle: @tr("Enter image name, optional tag (default latest)");

    // 填充 body_slot
    body_slot := BodySlot {
        width: 100%;
        VerticalLayout {
            width: 100%; spacing: Theme.s2; alignment: start;

            VCenterText { text: @tr("Image"); font-size: Theme.fs_sm; font-weight: 700; color: Theme.ink_3; letter-spacing: 0.8px; }
            TextField {
                text <=> root.input;
                placeholder: "nginx:latest";
                font_family: Theme.mono;
                font_size: Theme.fs_md;
            }

            VCenterText { text: @tr("Progress"); font-size: Theme.fs_sm; font-weight: 700; color: Theme.ink_3; letter-spacing: 0.8px; }
            ProgressBar {
                value: root.progress / 100.0;
            }
            VCenterText {
                text: root.status == "" ? @tr("Waiting to pull...") : root.status;
                font-size: Theme.fs_sm; font-family: Theme.mono; color: Theme.ink_3;
            }
        }
    }

    footer_slot := FooterSlot {
        TextButton { label: @tr("Cancel"); clicked => { root.close(); } }
        TextButton { label: @tr("Pull"); filled: true; clicked => { root.submit(root.input); } }
    }
}

// ============ CleanupDialog ============
export component CleanupDialog inherits DialogShell {
    in-out property <bool> stopped: true;
    in-out property <bool> dangling: true;
    in-out property <bool> unused_net: false;
    in-out property <bool> unused_vol: false;
    in-out property <string> cnt_stopped: "";
    in-out property <string> cnt_dangling: "";
    in-out property <string> cnt_unused_net: "";
    in-out property <string> cnt_unused_vol: "";
    callback submit(bool, bool, bool, bool);

    dlg_title: @tr("Cleanup Resources");
    dlg_subtitle: @tr("Select resource types to clean up");

    body_slot := BodySlot {
        width: 100%;
        VerticalLayout {
            width: 100%; spacing: Theme.s3; alignment: start;
            CleanItem { label: @tr("Stopped Containers"); desc: @tr("Remove all stopped containers"); glyph: "▢"; cnt: root.cnt_stopped; checked <=> root.stopped; toggled => { } }
            CleanItem { label: @tr("Dangling Images"); desc: @tr("Remove unused image layers"); glyph: "▣"; cnt: root.cnt_dangling; checked <=> root.dangling; toggled => { } }
            CleanItem { label: @tr("Unused Networks"); desc: @tr("Remove networks not in use"); glyph: "◇"; cnt: root.cnt_unused_net; checked <=> root.unused_net; toggled => { } }
            CleanItem { label: @tr("Unused Volumes"); desc: @tr("Remove volumes not in use"); glyph: "▤"; cnt: root.cnt_unused_vol; checked <=> root.unused_vol; toggled => { } }
        }
    }

    footer_slot := FooterSlot {
        TextButton { label: @tr("Cancel"); clicked => { root.close(); } }
        TextButton { label: @tr("Cleanup"); filled: true; clicked => { root.submit(root.stopped, root.dangling, root.unused_net, root.unused_vol); } }
    }
}
