// dialogs.slint — 拉取镜像 & 清理资源 对话框
import { Theme } from "theme.slint";

component CleanItem inherits Rectangle {
    in property <string> label: "";
    in property <string> desc: "";
    in-out property <bool> checked: true;
    height: 56px;
    border-radius: Theme.r_md;
    background: Theme.bg;
    border-width: 1px; border-color: Theme.line;
    HorizontalLayout {
        width: 100%; height: 100%;
        spacing: Theme.s3;
        padding-left: Theme.s3; padding-right: Theme.s3;
        Rectangle {
            width: 16px; height: 16px; border-radius: 4px;
            background: root.checked ? Theme.ok : Theme.card;
            border-width: 1px; border-color: root.checked ? Theme.ok : Theme.line_2;
            if root.checked : Text { text: "✓"; color: #fff; font-size: 11px; }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: root.label; font-size: Theme.fs_sm; font-weight: 600; color: Theme.ink; }
            Text { text: root.desc; font-size: Theme.fs_xs; color: Theme.ink_3; }
        }
        TouchArea { clicked => { root.checked = !root.checked; } }
    }
}

// 拉取镜像对话框
export component PullDialog inherits Rectangle {
    in-out property <string> input: "";
    in-out property <bool> busy: false;
    in-out property <int> progress: 0;
    in-out property <string> status: "";
    callback close();
    callback submit(string);

    background: Theme.overlay;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: 420px; height: 240px;
        border-radius: Theme.r;
        background: Theme.card;
        border-width: 1px; border-color: Theme.line;
        VerticalLayout {
            width: 100%; height: 100%;
            spacing: Theme.s4;
            padding: Theme.s5;

            Text { text: @tr("Pull Image"); font-size: Theme.fs_lg; font-weight: 700; color: Theme.ink; }

            Rectangle {
                height: 36px;
                border-radius: Theme.r_md;
                background: Theme.bg;
                border-width: 1px;
                border-color: Theme.line;
                TextInput {
                    width: 100%;
                    height: 100%;
                    text <=> root.input;
                    color: Theme.ink;
                }
            }

            if root.busy : Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.bar_bg;
                Rectangle {
                    width: parent.width * root.progress / 100;
                    height: 100%;
                    border-radius: 3px;
                    background: Theme.bar_cpu;
                }
            }
            if root.status != "" : Text { text: root.status; font-size: Theme.fs_xs; color: Theme.ink_3; }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: Theme.s3;
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    height: 32px;
                    border-radius: Theme.r_sm;
                    background: Theme.bg; border-width: 1px; border-color: Theme.line;
                    HorizontalLayout {
                        width: 100%; height: 100%;
                        padding-left: Theme.s4; padding-right: Theme.s4;
                        Text { text: @tr("Cancel"); font-size: Theme.fs_sm; color: Theme.ink_2; }
                    }
                    TouchArea { clicked => { root.close(); } }
                }
                Rectangle {
                    height: 32px;
                    border-radius: Theme.r_sm;
                    background: Theme.ink;
                    HorizontalLayout {
                        width: 100%; height: 100%;
                        padding-left: Theme.s4; padding-right: Theme.s4;
                        Text { text: @tr("Pull"); font-size: Theme.fs_sm; font-weight: 600; color: Theme.card; }
                    }
                    TouchArea { clicked => { root.submit(root.input); } }
                }
            }
        }
    }
}

// 清理资源对话框
export component CleanupDialog inherits Rectangle {
    in-out property <bool> stopped: true;
    in-out property <bool> dangling: true;
    in-out property <bool> unused_net: false;
    in-out property <bool> unused_vol: false;
    callback close();
    callback submit(bool, bool, bool, bool);

    background: Theme.overlay;
    TouchArea { clicked => { root.close(); } }
    Rectangle {
        width: 420px; height: 340px;
        border-radius: Theme.r;
        background: Theme.card;
        border-width: 1px; border-color: Theme.line;
        VerticalLayout {
            width: 100%; height: 100%;
            spacing: Theme.s3;
            padding: Theme.s5;

            Text { text: @tr("Cleanup Resources"); font-size: Theme.fs_lg; font-weight: 700; color: Theme.ink; }

            CleanItem { label: @tr("Stopped Containers"); desc: @tr("Remove all stopped containers"); checked <=> root.stopped; }
            CleanItem { label: @tr("Dangling Images"); desc: @tr("Remove unused image layers"); checked <=> root.dangling; }
            CleanItem { label: @tr("Unused Networks"); desc: @tr("Remove networks not in use"); checked <=> root.unused_net; }
            CleanItem { label: @tr("Unused Volumes"); desc: @tr("Remove volumes not in use"); checked <=> root.unused_vol; }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: Theme.s3;
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    height: 32px;
                    border-radius: Theme.r_sm;
                    background: Theme.bg; border-width: 1px; border-color: Theme.line;
                    HorizontalLayout {
                        width: 100%; height: 100%;
                        padding-left: Theme.s4; padding-right: Theme.s4;
                        Text { text: @tr("Cancel"); font-size: Theme.fs_sm; color: Theme.ink_2; }
                    }
                    TouchArea { clicked => { root.close(); } }
                }
                Rectangle {
                    height: 32px;
                    border-radius: Theme.r_sm;
                    background: Theme.err;
                    HorizontalLayout {
                        width: 100%; height: 100%;
                        padding-left: Theme.s4; padding-right: Theme.s4;
                        Text { text: @tr("Cleanup"); font-size: Theme.fs_sm; font-weight: 600; color: #fff; }
                    }
                    TouchArea { clicked => { root.submit(root.stopped, root.dangling, root.unused_net, root.unused_vol); } }
                }
            }
        }
    }
}
