// dialogs.slint — 自绘弹窗（遮罩 + 居中卡片 + 标题区 + 内容区 + footer 按钮区）
import { Theme } from "theme.slint";
import { FlatButton } from "components.slint";
import { LineEdit, HorizontalBox, VerticalBox, CheckBox } from "std-widgets.slint";

// —— 拉取镜像弹窗 ——
export component PullDialog inherits Rectangle {
    in-out property <string> input: "";
    in-out property <bool> busy: false;
    callback close();
    callback submit(string);

    background: rgba(0,0,0,0.45);

    TouchArea { width: 100%; height: 100%; clicked => { root.close(); } }

    Rectangle {
        x: (root.width - 380px) / 2;
        y: (root.height - 180px) / 2;
        width: 380px; height: 180px;
        background: Theme.bg-surface;
        border-radius: 10px;
    }

    VerticalBox {
        x: (root.width - 380px) / 2 + 20px;
        y: (root.height - 180px) / 2 + 16px;
        width: 340px; height: 148px;
        spacing: Theme.space-3;

        HorizontalBox {
            width: parent.width; height: 28px;
            Text {
                text: "拉取镜像";
                font-size: Theme.text-lg; font-weight: 700;
                color: Theme.text-primary;
                height: parent.height; vertical-alignment: center;
            }
            HorizontalLayout { }
            FlatButton {
                text: "✕"; height: 24px; width: 28px; fg_color: Theme.text-muted;
                clicked => { root.close(); }
            }
        }

        Rectangle {
            width: parent.width; height: 40px;
            background: Theme.bg-card; border-radius: 6px;
            LineEdit {
                x: 8px; y: 0; width: parent.width - 16px; height: parent.height;
                placeholder-text: "镜像名:tag  （如 nginx:latest）";
                text <=> root.input;
                enabled: root.busy == false;
                accepted => { root.submit(root.input); }
            }
        }

        HorizontalBox {
            width: parent.width; height: 32px; spacing: Theme.space-2;
            HorizontalLayout { }
            FlatButton {
                text: "取消"; height: 30px; width: 80px;
                fg_color: Theme.text-muted;
                clicked => { root.close(); }
            }
            FlatButton {
                text: root.busy ? "拉取中..." : "开始拉取";
                height: 30px; width: 100px;
                hover_bg: Theme.accent; fg_color: Theme.bg-root;
                clicked => { root.submit(root.input); }
            }
        }
    }
}

// —— 清理资源弹窗 ——
export component CleanupDialog inherits Rectangle {
    in-out property <bool> stopped: true;
    in-out property <bool> dangling: true;
    in-out property <bool> unused: false;
    callback close();
    callback submit(bool, bool, bool);

    background: rgba(0,0,0,0.45);

    TouchArea { width: 100%; height: 100%; clicked => { root.close(); } }

    Rectangle {
        x: (root.width - 380px) / 2;
        y: (root.height - 240px) / 2;
        width: 380px; height: 240px;
        background: Theme.bg-surface;
        border-radius: 10px;
    }

    VerticalBox {
        x: (root.width - 380px) / 2 + 20px;
        y: (root.height - 240px) / 2 + 16px;
        width: 340px; height: 208px;
        spacing: Theme.space-2;

        HorizontalBox {
            width: parent.width; height: 28px;
            Text {
                text: "清理未使用资源";
                font-size: Theme.text-lg; font-weight: 700;
                color: Theme.text-primary;
                height: parent.height; vertical-alignment: center;
            }
            HorizontalLayout { }
            FlatButton {
                text: "✕"; height: 24px; width: 28px; fg_color: Theme.text-muted;
                clicked => { root.close(); }
            }
        }

        Rectangle {
            width: parent.width; height: 36px;
            background: Theme.bg-card; border-radius: 6px;
            CheckBox {
                x: 12px; y: 0; width: parent.width - 24px; height: parent.height;
                text: "清理停止的容器";
                checked <=> root.stopped;
            }
        }
        Rectangle {
            width: parent.width; height: 36px;
            background: Theme.bg-card; border-radius: 6px;
            CheckBox {
                x: 12px; y: 0; width: parent.width - 24px; height: parent.height;
                text: "清理悬空镜像 (dangling)";
                checked <=> root.dangling;
            }
        }
        Rectangle {
            width: parent.width; height: 36px;
            background: Theme.bg-card; border-radius: 6px;
            CheckBox {
                x: 12px; y: 0; width: parent.width - 24px; height: parent.height;
                text: "清理所有未使用镜像 (危险!)";
                checked <=> root.unused;
            }
        }

        HorizontalBox {
            width: parent.width; height: 32px; spacing: Theme.space-2;
            HorizontalLayout { }
            FlatButton {
                text: "取消"; height: 30px; width: 80px; fg_color: Theme.text-muted;
                clicked => { root.close(); }
            }
            FlatButton {
                text: "执行清理";
                height: 30px; width: 100px;
                hover_bg: Theme.status-error; fg_color: Theme.bg-root;
                clicked => { root.submit(root.stopped, root.dangling, root.unused); }
            }
        }
    }
}
