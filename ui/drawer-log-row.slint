// drawer-log-row.slint — Drawer 日志行（一条日志一行）
//
// 行高：**固定 20px**（不再随内容折行变化）。
//   ListView 的 delegate 必须显式行高（Slint 列表布局逐项读 delegate.height），
//   实例处用 height: self.min-height 取用；绝不能写成 100%（会退化为视口高）。
//   旧的 char-wrap 会让一条长日志折成多行 → 行高随内容变化，虚拟化列表的
//   行位置逐条漂移，滚动/贴底跳动；改为单行 + 尾部省略（overflow: elide）。
//   省略只影响显示：Rust 侧日志窗口保存完整原文，「复制日志」复制原文。
import { Theme } from "theme.slint";
import { VCenterText } from "components-align.slint";
import { LogRow } from "models.slint";

export component LogLineRow inherits Rectangle {
    in property <LogRow> data;

    vertical-stretch: 0;
    min-height: 20px;

    body := VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;
        padding-left: 16px;
        padding-right: 16px;
        VCenterText {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            min-width: 0px;
            text: root.data.text;
            font-size: 12px;
            font-family: Theme.mono;
            color: Theme.log_ink;
            // 固定单行：超长日志在右边界省略，不再折行撑高行
            wrap: no-wrap;
            overflow: elide;
        }
    }
}
