// drawer.slint — 右侧抽屉（详情 / 日志 / 环境）
import { Theme } from "theme.slint";
import { VCenterText } from "components-align.slint";
import { IconBtn } from "components-interact.slint";
import { LogLineRow, DetailPair } from "models.slint";
import { DetailRow } from "drawer-detail-row.slint";

component DTab inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <int> idx: 0;
    callback clicked(int);
    Rectangle {
        y: parent.height - 2px;
        width: 100%;
        height: 2px;
        background: root.active ? Theme.ink : transparent;
    }
    VCenterText { text: root.label; font-size: Theme.fs_sm; font-weight: 600; color: root.active ? Theme.ink : Theme.ink_3; width: 100%; height: 100%; }
    TouchArea { clicked => { root.clicked(root.idx); } }
}

export component Drawer inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <int> tab: 0;
    in-out property <bool> log_follow: true;
    in-out property <[LogLineRow]> log_lines: [];

    in-out property <string> title: "";
    in-out property <string> sub: "";
    in-out property <bool> tabs_visible: true;
    in-out property <[DetailPair]> detail_rows: [];
    in-out property <[DetailPair]> env_rows: [];

    callback close();
    callback set_tab(int);
    callback log_follow_click();
    callback log_copy_click();
    callback log_clear_click();

    property <length> content_h: root.height - Theme.drawer_head - (root.tabs_visible ? Theme.drawer_tabs : 0px);

    width: Theme.drawer_w;
    height: 100%;
    background: Theme.card;
    Rectangle { width: 1px; height: 100%; background: Theme.line; }

    body := VerticalLayout {
        visible: root.open;
        width: 100%;
        height: root.height;
        spacing: 0px;

        Rectangle {
            height: Theme.drawer_head;
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
            HorizontalLayout {
                width: 100%; height: 100%;
                spacing: Theme.s3; padding-left: Theme.s4; padding-right: Theme.s4;
                alignment: center;
                VerticalLayout {
                    horizontal-stretch: 1; spacing: 2px; alignment: center;
                    VCenterText { text: root.title; font-size: Theme.fs_lg; font-weight: 700; color: Theme.ink; overflow: elide; }
                    VCenterText { text: root.sub; font-size: Theme.fs_sm; color: Theme.ink_3; overflow: elide; }
                }
                IconBtn { size: 28px; glyph_size: 12px; glyph: "✕"; tip: @tr("Close"); clicked => { root.close(); } }
            }
        }

        if root.tabs_visible : Rectangle {
            height: Theme.drawer_tabs;
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
            HorizontalLayout {
                width: 100%; height: 100%; spacing: 0px; alignment: center;
                DTab { label: @tr("Details"); active: root.tab == 0; idx: 0; clicked(t) => { root.set_tab(t); } }
                DTab { label: @tr("Logs"); active: root.tab == 1; idx: 1; clicked(t) => { root.set_tab(t); } }
                DTab { label: @tr("Environment"); active: root.tab == 2; idx: 2; clicked(t) => { root.set_tab(t); } }
            }
        }

        content_box := Rectangle {
            width: 100%;
            height: root.content_h;

            detail_scroll := Flickable {
                visible: (root.tabs_visible == false) || root.tab == 0;
                height: root.content_h;
                VerticalLayout {
                    width: 100%; spacing: 0px;
                    for row[i] in root.detail_rows : DetailRow { data: row; head_gap: i > 0; }
                    Rectangle { height: Theme.s5; }
                }
            }

            logsec := VerticalLayout {
                visible: root.tabs_visible && root.tab == 1;
                height: root.content_h;
                spacing: 0px;
                Rectangle {
                    height: Theme.drawer_logbar;
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
                    HorizontalLayout {
                        width: 100%; height: 100%; spacing: Theme.s2; padding-left: Theme.s3; padding-right: Theme.s3;
                        alignment: center;
                        IconBtn { size: 28px; glyph_size: 11px; glyph: root.log_follow ? "‖" : "▶"; active: root.log_follow; tip: @tr("Follow logs"); clicked => { root.log_follow_click(); } }
                        IconBtn { size: 28px; glyph_size: 12px; glyph: "❐"; tip: @tr("Copy logs"); clicked => { root.log_copy_click(); } }
                        IconBtn { size: 28px; glyph_size: 12px; glyph: "⌫"; tip: @tr("Clear logs"); clicked => { root.log_clear_click(); } }
                    }
                }
                logbox := Rectangle {
                    height: root.content_h - Theme.drawer_logbar;
                    background: Theme.log_bg;
                    VerticalLayout {
                        width: 100%; height: 100%; padding: Theme.s3;
                        for line in root.log_lines : VCenterText {
                            text: line.text; font-size: Theme.fs_xs; font-family: Theme.mono;
                            color: Theme.log_ink; wrap: word-wrap;
                        }
                    }
                }
            }

            env_scroll := Flickable {
                visible: root.tabs_visible && root.tab == 2;
                height: root.content_h;
                VerticalLayout {
                    width: 100%; spacing: 0px;
                    for row[i] in root.env_rows : DetailRow { data: row; head_gap: i > 0; }
                    Rectangle { height: Theme.s5; }
                }
            }
        }
    }
}
