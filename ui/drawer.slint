// drawer.slint — 右侧抽屉（详情 / 日志 / 环境）
import { Theme } from "theme.slint";
import { VCenterText } from "components-align.slint";
import { IconBtn } from "components-interact.slint";
import { TabItem } from "components-nav.slint";
import { LogLineRow, DetailPair } from "models.slint";
import { DetailRow } from "drawer-detail-row.slint";

export component Drawer inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <int> tab: 0;
    in-out property <bool> log_follow: true;
    in-out property <[LogLineRow]> log_lines: [];

    in-out property <string> title: "";
    in-out property <string> sub: "";
    in-out property <bool> tabs_visible: true;
    in-out property <[DetailPair]> detail_rows: [];
    in-out property <[DetailPair]> env_rows: [];

    callback close();
    callback set_tab(int);
    callback log_follow_click();
    callback log_copy_click();
    callback log_clear_click();

    property <length> content_h: root.height - 62px - (root.tabs_visible ? 36px : 0px);

    width: Theme.drawer_w;
    height: 100%;
    background: Theme.card;
    Rectangle { width: 1px; height: 100%; background: Theme.line; }

    body := VerticalLayout {
        visible: root.open;
        width: 100%;
        height: root.height;
        spacing: 0px;

        Rectangle {
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
            HorizontalLayout {
                width: 100%; height: 100%;
                spacing: 0px; padding-left: Theme.s6; padding-right: Theme.s6;
                padding-top: 18px; padding-bottom: 14px;
                VerticalLayout {
                    horizontal-stretch: 1; spacing: 4px; alignment: start;
                    VCenterText { text: root.title; font-size: Theme.fs_xl; font-weight: 700; color: Theme.ink; overflow: elide; }
                    VCenterText { text: root.sub; font-size: Theme.fs; color: Theme.ink_2; font-family: Theme.mono; overflow: elide; }
                }
                IconBtn { size: 28px; glyph_size: 12px; glyph: "✕"; tip: @tr("Close"); clicked => { root.close(); } }
            }
        }

        // Tab 栏（严格对齐 prototype .d-tabs{d-tab）
        if root.tabs_visible : Rectangle {
            height: 36px;
            Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
            HorizontalLayout {
                width: 100%; height: 100%;
                spacing: 2px; padding-left: 12px; padding-right: 12px;
                TabItem { label: @tr("Details"); active: root.tab == 0; idx: 0; clicked(t) => { root.set_tab(t); } }
                TabItem { label: @tr("Logs"); active: root.tab == 1; idx: 1; clicked(t) => { root.set_tab(t); } }
                TabItem { label: @tr("Environment"); active: root.tab == 2; idx: 2; clicked(t) => { root.set_tab(t); } }
            }
        }

        content_box := Rectangle {
            width: 100%;
            height: root.content_h;

            detail_scroll := Flickable {
                visible: (root.tabs_visible == false) || root.tab == 0;
                height: root.content_h;
                VerticalLayout {
                    width: 100%; spacing: 0px;
                    for row[i] in root.detail_rows : DetailRow { data: row; head_gap: i > 0; }
                    Rectangle { height: Theme.s5; }
                }
            }

            logsec := VerticalLayout {
                visible: root.tabs_visible && root.tab == 1;
                height: root.content_h;
                spacing: 0px;
                Rectangle {
                    height: 36px;
                    Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.ink_4; }
                    HorizontalLayout {
                        width: 100%; height: 100%; spacing: 8px; padding-left: 12px; padding-right: 12px;
                        IconBtn { size: 26px; glyph_size: 11px; glyph: root.log_follow ? "‖" : "▶"; active: root.log_follow; tip: @tr("Follow logs"); clicked => { root.log_follow_click(); } }
                        IconBtn { size: 26px; glyph_size: 12px; glyph: "❐"; tip: @tr("Copy logs"); clicked => { root.log_copy_click(); } }
                        IconBtn { size: 26px; glyph_size: 12px; glyph: "⌫"; tip: @tr("Clear logs"); clicked => { root.log_clear_click(); } }
                    }
                }
                logbox := Rectangle {
                    height: root.content_h - 36px;
                    background: Theme.log_bg;
                    VerticalLayout {
                        width: 100%; height: 100%; padding: Theme.s3;
                        for line in root.log_lines : VCenterText {
                            text: line.text; font-size: Theme.fs_xs; font-family: Theme.mono;
                            color: Theme.log_ink; wrap: word-wrap;
                        }
                    }
                }
            }

            env_scroll := Flickable {
                visible: root.tabs_visible && root.tab == 2;
                height: root.content_h;
                VerticalLayout {
                    width: 100%; spacing: 0px;
                    for row[i] in root.env_rows : DetailRow { data: row; head_gap: i > 0; }
                    Rectangle { height: Theme.s5; }
                }
            }
        }
    }
}
