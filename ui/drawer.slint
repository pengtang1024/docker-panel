// drawer.slint — 右侧抽屉（详情 / 日志 / 环境）
//
// 详情区不再用固定字段属性，统一走 [DetailPair] 列表：
// 同一个抽屉要展示容器 / 镜像 / 网络 / 卷四种不同结构，固定属性无法表达，
// 由 Rust 侧 detail_fmt::build_drawer_data 按选中类型生成行列表。
import { Theme } from "theme.slint";
import { IconBtn } from "components.slint";
import { LogLineRow, DetailPair } from "models.slint";
import { ScrollView } from "std-widgets.slint";

component DTab inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    in property <int> idx: 0;
    callback clicked(int);
    Rectangle {
        y: parent.height - 2px;
        width: 100%;
        height: 2px;
        background: root.active ? Theme.ink : transparent;
    }
    Text { text: root.label; font-size: Theme.fs_sm; font-weight: 600; color: root.active ? Theme.ink : Theme.ink_3; }
    TouchArea { clicked => { root.clicked(root.idx); } }
}

// 单条详情行：按 kind 切换渲染（对齐 prototype .sec / .kv / .box / .kv-list .it）
component DetailRow inherits Rectangle {
    in property <DetailPair> data;
    in property <bool> head_gap: false;   // 非首节：头部上方先画 1px 分节线

    // kind 1 — 分节标题（.sec h3：小字灰度 + 上下留白）
    // 对齐 prototype：分节线在最上 → 16px 顶部留白 → 标题 → 10px 底部留白
    if root.data.kind == 1 : VerticalLayout {
        width: 100%;
        spacing: 0px;
        if root.head_gap : Rectangle { height: 1px; background: Theme.line; }
        Rectangle { height: Theme.s5; }
        HorizontalLayout {
            width: 100%;
            padding-left: Theme.s6;
            padding-right: Theme.s6;
            Text {
                text: root.data.k;
                font-size: Theme.fs_xs;
                font-weight: 700;
                color: Theme.ink_3;
                letter-spacing: 1.1px;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
        }
        Rectangle { height: 10px; }
    }

    // kind 0 — kv 行（.kv：k 62px 右对齐灰字 + v 正文）
    if root.data.kind == 0 : HorizontalLayout {
        width: 100%;
        spacing: Theme.s4;
        padding-left: Theme.s6;
        padding-right: Theme.s6;
        padding-top: 5px;
        padding-bottom: 5px;
        alignment: start;
        Text {
            text: root.data.k;
            width: 62px;
            font-size: Theme.fs;
            color: Theme.ink_3;
            horizontal-alignment: right;
            wrap: word-wrap;
        }
        Text {
            text: root.data.v;
            font-size: root.data.mono ? Theme.fs_sm : Theme.fs;
            font-family: root.data.mono ? Theme.mono : "";
            color: root.data.mono ? Theme.ink_2 : Theme.ink;
            font-weight: 500;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
    }

    // kind 2 — kv 行，值渲染为代码盒（.box：底色 + 描边 + 等宽 pre-wrap）
    if root.data.kind == 2 : HorizontalLayout {
        width: 100%;
        spacing: Theme.s4;
        padding-left: Theme.s6;
        padding-right: Theme.s6;
        padding-top: 5px;
        padding-bottom: 5px;
        alignment: start;
        Text {
            text: root.data.k;
            width: 62px;
            font-size: Theme.fs;
            color: Theme.ink_3;
            horizontal-alignment: right;
            wrap: word-wrap;
        }
        Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.r_md;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.line;
            HorizontalLayout {
                width: 100%;
                padding-left: 11px;
                padding-right: 11px;
                padding-top: 9px;
                padding-bottom: 9px;
                Text {
                    text: root.data.v;
                    font-size: Theme.fs_sm;
                    font-family: Theme.mono;
                    color: Theme.ink_2;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }
        }
    }

    // kind 3 — 代码盒条目（.kv-list .it：描边小条；k 为高亮键名前缀）
    // padding 必须由布局元素承载：外层用 VerticalLayout 提供左右 20px / 上下 2px 间距
    if root.data.kind == 3 : VerticalLayout {
        width: 100%;
        spacing: 0px;
        padding-left: Theme.s6;
        padding-right: Theme.s6;
        padding-top: 2px;
        padding-bottom: 2px;
        Rectangle {
            width: 100%;
            border-radius: Theme.r_xs;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.line;
            HorizontalLayout {
                width: 100%;
                padding-left: Theme.s3;
                padding-right: Theme.s3;
                padding-top: Theme.s1;
                padding-bottom: Theme.s1;
                Text {
                    // 键名前缀固定自然宽（无键名时值独占整行并换行），避免剩余宽度被摊到 KEY
                    text: root.data.k == "" ? root.data.v : root.data.k + "=";
                    font-size: Theme.fs_sm;
                    font-family: Theme.mono;
                    color: root.data.k == "" ? Theme.ink_2 : Theme.bar_cpu;
                    horizontal-stretch: root.data.k == "" ? 1 : 0;
                    wrap: word-wrap;
                }
                if root.data.k != "" : Text {
                    // 值吃满剩余宽度并在盒内换行（对齐 prototype 的 word-break:break-all）
                    text: root.data.v;
                    font-size: Theme.fs_sm;
                    font-family: Theme.mono;
                    color: Theme.ink_2;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
            }
        }
    }
}

export component Drawer inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <int> tab: 0;
    in-out property <bool> log_follow: true;
    in-out property <[LogLineRow]> log_lines: [];

    /// 标题（容器名 / 镜像仓库名 / 网络名 / 卷名）与副标题（镜像 / 大小 / 驱动）
    in-out property <string> title: "";
    in-out property <string> sub: "";
    /// 仅容器展示 Tab 栏（对齐 prototype openDetail：非容器类型隐藏 tabs）
    in-out property <bool> tabs_visible: true;
    /// 详情 Tab 与 环境 Tab 的行列表
    in-out property <[DetailPair]> detail_rows: [];
    in-out property <[DetailPair]> env_rows: [];

    callback close();
    callback set_tab(int);
    callback log_follow_click();
    callback log_copy_click();
    callback log_clear_click();

    /// 抽屉布局契约（对齐 Theme.drawer_*）：内容区高 = 抽屉高 - 头部 -（容器才有）Tab 栏。
    /// Drawer.height 自身是百分比，其后代一律用此定值推导，不依赖 height:% / 嵌套 vertical-stretch。
    property <length> content_h: root.height - Theme.drawer_head - (root.tabs_visible ? Theme.drawer_tabs : 0px);

    width: Theme.drawer_w;
    height: 100%;
    background: Theme.card;
    Rectangle {
        width: 1px;
        height: 100%;
        background: Theme.line;
    }

    // 内容布局：非条件元素 + 显式高度 root.height（Drawer 已解析的确定高度），
    // 切断「条件元素自动高 ↔ 子级 height:%」的循环绑定（否则整层塌陷到 min 高）。
    body := VerticalLayout {
        visible: root.open;
        width: 100%;
        height: root.height;
        spacing: 0px;

        // 头部
        Rectangle {
            height: Theme.drawer_head;
            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                width: 100%; height: 100%;
                spacing: Theme.s3;
                padding-left: Theme.s4;
                padding-right: Theme.s4;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: root.title;
                        font-size: Theme.fs_lg;
                        font-weight: 700;
                        color: Theme.ink;
                        overflow: elide;
                    }
                    Text {
                        text: root.sub;
                        font-size: Theme.fs_sm;
                        color: Theme.ink_3;
                        overflow: elide;
                    }
                }
                IconBtn {
                    size: 28px; glyph_size: 12px;
                    glyph: "✕";
                    tip: @tr("Close");
                    clicked => { root.close(); }
                }
            }
        }

        // Tab 栏（仅容器）
        if root.tabs_visible : Rectangle {
            height: Theme.drawer_tabs;
            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                width: 100%; height: 100%;
                spacing: 0px;
                DTab { label: @tr("Details"); active: root.tab == 0; idx: 0; clicked(t) => { root.set_tab(t); } }
                DTab { label: @tr("Logs"); active: root.tab == 1; idx: 1; clicked(t) => { root.set_tab(t); } }
                DTab { label: @tr("Environment"); active: root.tab == 2; idx: 2; clicked(t) => { root.set_tab(t); } }
            }
        }

        // 内容区：唯一分配剩余高度的非条件容器（对齐 Theme 抽屉契约）。
        // 三个视图并存、用 visible 切换显隐；content 是普通 Rectangle，
        // 子级按各自绑定定位 → 三者重叠，仅可见者被绘制。
        content := Rectangle {
            width: 100%;
            height: root.content_h;

            // 详情（非容器类型没有 Tab 栏，恒展示详情）
            detail_scroll := ScrollView {
                visible: (root.tabs_visible == false) || root.tab == 0;
                height: root.content_h;
                VerticalLayout {
                    width: 100%;
                    spacing: 0px;
                    // ScrollView 会把内层布局拉满视口，若不置 start 则每行被均摊拉高到 100px+；
                    // alignment:start 让各行保持自然高，从顶部紧密排布（对齐 prototype 紧凑 kv 行）
                    alignment: start;
                    for row[i] in root.detail_rows : DetailRow {
                        data: row;
                        head_gap: i > 0;
                    }
                    Rectangle { height: Theme.s5; }
                }
            }

            // 日志
            logsec := VerticalLayout {
                visible: root.tabs_visible && root.tab == 1;
                height: root.content_h;
                spacing: 0px;
                Rectangle {
                    height: Theme.drawer_logbar;
                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: Theme.line;
                    }
                    HorizontalLayout {
                        width: 100%; height: 100%;
                        spacing: Theme.s2;
                        padding-left: Theme.s3;
                        padding-right: Theme.s3;
                        IconBtn {
                            size: 28px; glyph_size: 11px;
                            // 字形改用系统字体（Noto/DejaVu）确定覆盖的符号，避免 ⏸ 等 emoji 显示为方块
                            glyph: root.log_follow ? "‖" : "▶";
                            active: root.log_follow;
                            tip: @tr("Follow logs");
                            clicked => { root.log_follow_click(); }
                        }
                        IconBtn {
                            size: 28px; glyph_size: 12px;
                            glyph: "❐";
                            tip: @tr("Copy logs");
                            clicked => { root.log_copy_click(); }
                        }
                        IconBtn {
                            size: 28px; glyph_size: 12px;
                            glyph: "⌫";
                            tip: @tr("Clear logs");
                            clicked => { root.log_clear_click(); }
                        }
                    }
                }
                logbox := Rectangle {
                    height: root.content_h - Theme.drawer_logbar;
                    background: Theme.log_bg;
                    VerticalLayout {
                        width: 100%;
                        height: 100%;
                        padding: Theme.s3;
                        for line in root.log_lines : Text {
                            text: line.text;
                            font-size: Theme.fs_xs;
                            font-family: Theme.mono;
                            color: Theme.log_ink;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            // 环境（仅容器）
            env_scroll := ScrollView {
                visible: root.tabs_visible && root.tab == 2;
                height: root.content_h;
                VerticalLayout {
                    width: 100%;
                    spacing: 0px;
                    alignment: start;
                    for row[i] in root.env_rows : DetailRow {
                        data: row;
                        head_gap: i > 0;
                    }
                    Rectangle { height: Theme.s5; }
                }
            }
        }   // 闭 content
    }       // 闭 body
}
