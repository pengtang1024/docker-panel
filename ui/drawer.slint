// drawer.slint — 右侧抽屉（详情 / 日志 / 环境）
import { Theme } from "theme.slint";
import { VCenterText } from "components-align.slint";
import { IconBtn } from "components-interact.slint";
import { TabItem } from "components-nav.slint";
import { LogLineRow, DetailPair } from "models.slint";
import { DetailRow } from "drawer-detail-row.slint";
import { ScrollView } from "std-widgets.slint";

export component Drawer inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <int> tab: 0;
    in-out property <bool> log_follow: true;
    in-out property <[LogLineRow]> log_lines: [];

    in-out property <string> title: "";
    in-out property <string> sub: "";
    in-out property <bool> tabs_visible: true;
    in-out property <[DetailPair]> detail_rows: [];
    in-out property <[DetailPair]> env_rows: [];
    in-out property <string> log_text: "";

    callback close();
    callback set_tab(int);
    callback log_follow_click();
    callback log_copy_click();
    callback log_clear_click();

    width: Theme.drawer_w;
    height: 100%;
    background: Theme.card;

    body := VerticalLayout {
        visible: root.open;
        width: 100%;
        height: 100%;
        spacing: 0px;

        // 顶部标题栏（高度由内容决定，不参与剩余空间分配）
        Rectangle {
            vertical-stretch: 0;
            HorizontalLayout {
                width: 100%; height: 100%;
                spacing: 0px; padding-left: 20px; padding-right: 20px;
                padding-top: 18px; padding-bottom: 14px;
                VerticalLayout {
                    horizontal-stretch: 1; spacing: 4px; alignment: start;
                    padding-right: 30px;
                    VCenterText { text: root.title; font-size: 18px; font-weight: 700; color: Theme.ink; overflow: elide; }
                    VCenterText { text: root.sub; font-size: 12px; color: Theme.ink_2; font-family: Theme.mono; overflow: elide; }
                }
            }
            IconBtn {
                x: parent.width - 14px - 28px; y: 14px;
                size: 28px; icon_size: 12px; icon_name: "x";
                tip: @tr("Close");
                clicked => { root.close(); }
            }
        }

        // Tab 栏（36px 固定高）
        if root.tabs_visible : Rectangle {
            vertical-stretch: 0;
            height: 36px;
            HorizontalLayout {
                width: 100%; height: 100%;
                spacing: 2px; padding-left: 12px; padding-right: 12px;
                TabItem { label: @tr("Details"); active: root.tab == 0; idx: 0; clicked(t) => { root.set_tab(t); } }
                TabItem { label: @tr("Logs"); active: root.tab == 1; idx: 1; clicked(t) => { root.set_tab(t); } }
                TabItem { label: @tr("Environment"); active: root.tab == 2; idx: 2; clicked(t) => { root.set_tab(t); } }
            }
        }

        // 内容区（占剩余空间）
        content_box := Rectangle {
            vertical-stretch: 1;
            width: 100%;

            // ====== 详情 tab ======
            detail_scroll := ScrollView {
                visible: (root.tabs_visible == false) || root.tab == 0;
                width: 100%;
                height: 100%;
                vertical-scrollbar-policy: as-needed;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    width: parent.width;
                    spacing: 0px;
                    for row[i] in root.detail_rows : DetailRow { data: row; head_gap: i > 0; }
                    Rectangle { height: Theme.s5; }
                }
            }

            // ====== 日志 tab ======
            logsec := VerticalLayout {
                visible: root.tabs_visible && root.tab == 1;
                width: 100%;
                height: 100%;
                spacing: 0px;
                Rectangle {
                    vertical-stretch: 0;
                    height: 36px;
                    HorizontalLayout {
                        width: 100%; height: 100%; spacing: 8px; padding-left: 12px; padding-right: 12px;
                        IconBtn { size: 26px; icon_size: 11px; icon_name: root.log_follow ? "pause" : "play"; active: root.log_follow; tip: @tr("Follow logs"); clicked => { root.log_follow_click(); } }
                        IconBtn { size: 26px; icon_size: 12px; icon_name: "copy"; tip: @tr("Copy logs"); clicked => { root.log_copy_click(); } }
                        IconBtn { size: 26px; icon_size: 12px; icon_name: "trash"; tip: @tr("Clear logs"); clicked => { root.log_clear_click(); } }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    width: 100%;
                    background: Theme.log_bg;
                    ScrollView {
                        mouse-drag-pan-enabled: false;
                        width: 100%; height: 100%;
                        vertical-scrollbar-policy: as-needed;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: 100%;
                            spacing: 0px;
                            padding-left: 16px; padding-right: 16px;
                            padding-top: 14px; padding-bottom: 14px;
                            TextInput {
                                width: 100%;
                                read-only: true;
                                text: root.log_text;
                                font-size: 12px;
                                font-family: Theme.mono;
                                color: Theme.log_ink;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // ====== 环境 tab ======
            env_scroll := ScrollView {
                visible: root.tabs_visible && root.tab == 2;
                width: 100%;
                height: 100%;
                vertical-scrollbar-policy: as-needed;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    width: parent.width;
                    spacing: 0px;
                    for row[i] in root.env_rows : DetailRow { data: row; head_gap: i > 0; }
                    Rectangle { height: Theme.s5; }
                }
            }
        }
    }
}
