// headers.slint — 表格表头
// 关键设计：单元格序列与 delegates.slint 中的行**逐字段一致**，列宽全部来自 Theme.c-*。
// 表头:  [checkbox] [dot] [name flex] [image] [state] [cpu] [mem] [actions]
// 数据行: [checkbox] [dot] [name flex] [image] [state] [cpu] [mem] [actions]
import { Theme } from "theme.slint";
import { SortCell } from "components.slint";

// ============ 容器表头 ============
export component HeadContainer inherits Rectangle {
    in-out property <int> sort_field: 0;
    in-out property <bool> sort_desc: false;
    callback sort(int);

    height: Theme.head-h;
    background: Theme.bg-main;

    VerticalLayout {
        width: 100%; height: 100%;
        padding-left: Theme.s4; padding-right: Theme.s4;
        alignment: center;
        HorizontalLayout {
            spacing: Theme.s2;
            alignment: center;

            Rectangle { width: Theme.c-check; height: 1px; }
            Rectangle { width: Theme.c-dot; height: 1px; }

            SortCell {
                horizontal-stretch: 1;
                label: "名称"; field: 1;
                sort_field <=> root.sort_field; sort_desc <=> root.sort_desc;
                sort(f) => { root.sort(f); }
            }
            SortCell {
                width: Theme.c-image;
                label: "镜像"; field: 5;
                sort_field <=> root.sort_field; sort_desc <=> root.sort_desc;
                sort(f) => { root.sort(f); }
            }
            SortCell {
                width: Theme.c-state;
                label: "状态"; field: 2;
                sort_field <=> root.sort_field; sort_desc <=> root.sort_desc;
                sort(f) => { root.sort(f); }
            }
            SortCell {
                width: Theme.c-cpu; align-right: true;
                label: "CPU"; field: 3;
                sort_field <=> root.sort_field; sort_desc <=> root.sort_desc;
                sort(f) => { root.sort(f); }
            }
            SortCell {
                width: Theme.c-mem; align-right: true;
                label: "内存"; field: 4;
                sort_field <=> root.sort_field; sort_desc <=> root.sort_desc;
                sort(f) => { root.sort(f); }
            }
            Rectangle { width: Theme.c-act; height: 1px; }
        }
    }

    Rectangle { x: 0; y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
}

// ============ 镜像表头 ============
export component HeadImage inherits Rectangle {
    height: Theme.head-h;
    background: Theme.bg-main;

    VerticalLayout {
        width: 100%; height: 100%;
        padding-left: Theme.s4; padding-right: Theme.s4;
        alignment: center;
        HorizontalLayout {
            spacing: Theme.s2;
            alignment: center;

            Text {
                horizontal-stretch: 1;
                text: "仓库";
                font-size: Theme.fs-xs; font-weight: 700; color: Theme.fg-3;
                vertical-alignment: center;
            }
            Text {
                width: Theme.i-tag;
                text: "标签";
                font-size: Theme.fs-xs; font-weight: 700; color: Theme.fg-3;
                vertical-alignment: center;
            }
            Text {
                width: Theme.i-use;
                text: "使用";
                font-size: Theme.fs-xs; font-weight: 700; color: Theme.fg-3;
                vertical-alignment: center;
            }
            Text {
                width: Theme.i-size;
                text: "大小";
                font-size: Theme.fs-xs; font-weight: 700; color: Theme.fg-3;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Rectangle { width: 28px; height: 1px; }
        }
    }

    Rectangle { x: 0; y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
}

// ============ 网络表头 ============
export component HeadNetwork inherits Rectangle {
    height: Theme.head-h;
    background: Theme.bg-main;

    VerticalLayout {
        width: 100%; height: 100%;
        padding-left: Theme.s4; padding-right: Theme.s4;
        alignment: center;
        HorizontalLayout {
            spacing: Theme.s2;
            alignment: center;

            Text {
                horizontal-stretch: 1;
                text: "名称"; font-size: Theme.fs-xs; font-weight: 700; color: Theme.fg-3;
                vertical-alignment: center;
            }
            Text {
                width: Theme.n-driver;
                text: "驱动"; font-size: Theme.fs-xs; font-weight: 700; color: Theme.fg-3;
                vertical-alignment: center;
            }
            Text {
                width: Theme.n-scope;
                text: "范围"; font-size: Theme.fs-xs; font-weight: 700; color: Theme.fg-3;
                vertical-alignment: center;
            }
            Text {
                width: Theme.n-count;
                text: "容器"; font-size: Theme.fs-xs; font-weight: 700; color: Theme.fg-3;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }

    Rectangle { x: 0; y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
}

