import { Theme } from "theme.slint";
// headers.slint — 列表表头（支持点击排序 + 方向箭头）
import { HorizontalBox } from "std-widgets.slint";
// 自绘 Rectangle + Text（不用 Button，规避 Button 不支持 children）

// —— 排序箭头（独立组件，供两个 Header 共享）——
export component SortArrow inherits Text {
    in-out property <int> active: 0;
    in-out property <int> mine: 0;
    in-out property <bool> desc: false;
    text: root.active == root.mine ? (root.desc ? "▼" : "▲") : "";
    color: Theme.accent;
    font-size: 10px;
}

export component ContainerHeader inherits Rectangle {
    height: 32px;
    background: Theme.bg-root;

    // —— 排序状态（由 Rust 侧注入）——
    in-out property <int> sort_field: 0; // 0=Group 1=Name 2=Status 3=Cpu 4=Mem
    in-out property <bool> sort_desc: false;

    // —— 点击回调 ——
    callback sort(int);

    HorizontalBox {
        spacing: Theme.space-3;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        width: parent.width;
        height: parent.height;

        // —— 状态灯占位 ——
        Rectangle { width: 12px; height: 12px; }

        // —— 服务/名称 (sort_field=1) ——
        Rectangle {
            min-width: 220px; height: parent.height;
            TouchArea {
                x: 0; y: 0; width: parent.width; height: parent.height;
                clicked => { root.sort(1); }
            }
            HorizontalBox {
                x: 0; y: 0; width: parent.width; height: parent.height;
                Text { text: "服务/名称"; color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
                SortArrow { active <=> root.sort_field; mine: 1; desc <=> root.sort_desc; }
            }
        }

        // —— 镜像 ——
        Text { text: "镜像"; min-width: 100px; color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }

        HorizontalLayout { }

        // —— 状态 (sort_field=2) ——
        Rectangle {
            min-width: 80px; height: parent.height;
            TouchArea {
                x: 0; y: 0; width: parent.width; height: parent.height;
                clicked => { root.sort(2); }
            }
            HorizontalBox {
                x: 0; y: 0; width: parent.width; height: parent.height;
                Text { text: "状态"; color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
                SortArrow { active <=> root.sort_field; mine: 2; desc <=> root.sort_desc; }
            }
        }

        // —— CPU (sort_field=3) ——
        Rectangle {
            min-width: 50px; height: parent.height;
            TouchArea {
                x: 0; y: 0; width: parent.width; height: parent.height;
                clicked => { root.sort(3); }
            }
            HorizontalBox {
                x: 0; y: 0; width: parent.width; height: parent.height;
                HorizontalLayout { }
                Text { text: "CPU"; color: Theme.text-muted; font-size: Theme.text-xs; font-weight: 600; }
                SortArrow { active <=> root.sort_field; mine: 3; desc <=> root.sort_desc; }
            }
        }

        // —— 内存 (sort_field=4) ——
        Rectangle {
            min-width: 80px; height: parent.height;
            TouchArea {
                x: 0; y: 0; width: parent.width; height: parent.height;
                clicked => { root.sort(4); }
            }
            HorizontalBox {
                x: 0; y: 0; width: parent.width; height: parent.height;
                HorizontalLayout { }
                Text { text: "内存"; color: Theme.text-muted; font-size: Theme.text-xs; font-weight: 600; }
                SortArrow { active <=> root.sort_field; mine: 4; desc <=> root.sort_desc; }
            }
        }

        Rectangle { width: 28px; height: 1px; } // 4 个按钮占位
        Rectangle { width: 28px; height: 1px; }
        Rectangle { width: 28px; height: 1px; }
        Rectangle { width: 28px; height: 1px; }
    }
    Rectangle { background: Theme.bg-hover; width: parent.width; height: 1px; y: parent.height - 1px; }
}

export component ImageHeader inherits Rectangle {
    height: 32px;
    background: Theme.bg-root;

    HorizontalBox {
        spacing: Theme.space-3;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        width: parent.width;
        height: parent.height;

        Text { text: "ID"; min-width: 96px; color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
        Text { text: "仓库"; min-width: 200px; color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
        Text { text: "Tag"; min-width: 100px; color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
        HorizontalLayout { }
        Text { text: "容器"; min-width: 80px; color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
        Text { text: "大小"; min-width: 80px; color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
        Rectangle { width: 28px; height: 1px; } // 删除按钮占位
    }
    Rectangle { background: Theme.bg-hover; width: parent.width; height: 1px; y: parent.height - 1px; }
}
