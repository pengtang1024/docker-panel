// headers.slint — 列表表头
import { HorizontalBox } from "std-widgets.slint";
// 自绘 Rectangle + Text（不用 Button，规避 Button 不支持 children）

export component ContainerHeader inherits Rectangle {
    height: 32px;
    background: #0f172a;

    HorizontalBox {
        spacing: 8px;
        padding-left: 8px;
        padding-right: 8px;
        width: parent.width;
        height: parent.height;

        Rectangle { width: 12px; height: 12px; } // 状态灯占位
        Text { text: "ID"; min-width: 96px; color: #94a3b8; font-size: 12px; font-weight: 600; }
        Text { text: "服务 / 名称"; min-width: 220px; color: #94a3b8; font-size: 12px; font-weight: 600; }
        Text { text: "镜像"; min-width: 100px; color: #94a3b8; font-size: 12px; font-weight: 600; }
        HorizontalLayout { }
        Text { text: "状态"; min-width: 80px; color: #94a3b8; font-size: 12px; font-weight: 600; }
        Text { text: "CPU"; min-width: 50px; color: #94a3b8; font-size: 11px; font-weight: 600; horizontal-alignment: right; }
        Text { text: "内存"; min-width: 80px; color: #94a3b8; font-size: 11px; font-weight: 600; horizontal-alignment: right; }
        Rectangle { width: 28px; height: 1px; } // 4 个按钮占位
        Rectangle { width: 28px; height: 1px; }
        Rectangle { width: 28px; height: 1px; }
        Rectangle { width: 28px; height: 1px; }
    }
    Rectangle { background: #334155; width: parent.width; height: 1px; y: parent.height - 1px; }
}

export component ImageHeader inherits Rectangle {
    height: 32px;
    background: #0f172a;

    HorizontalBox {
        spacing: 8px;
        padding-left: 8px;
        padding-right: 8px;
        width: parent.width;
        height: parent.height;

        Text { text: "ID"; min-width: 96px; color: #94a3b8; font-size: 12px; font-weight: 600; }
        Text { text: "仓库"; min-width: 200px; color: #94a3b8; font-size: 12px; font-weight: 600; }
        Text { text: "Tag"; min-width: 100px; color: #94a3b8; font-size: 12px; font-weight: 600; }
        HorizontalLayout { }
        Text { text: "容器"; min-width: 80px; color: #94a3b8; font-size: 12px; font-weight: 600; }
        Text { text: "大小"; min-width: 80px; color: #94a3b8; font-size: 12px; font-weight: 600; }
        Rectangle { width: 28px; height: 1px; } // 删除按钮占位
    }
    Rectangle { background: #334155; width: parent.width; height: 1px; y: parent.height - 1px; }
}
