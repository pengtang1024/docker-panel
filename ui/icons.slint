// icons.slint — Lucide 风格 SVG 图标库
// Slint Path 用 commands 属性（不是 path！）+ SVG path 命令字符串
// stroke-width/stroke-line-cap 是 Path 内置属性，子组件不能 override — 直接在实例化时赋值
import { Theme } from "theme.slint";

// 所有图标共享的默认属性（实例化时赋值）：
// width: 16px, height: 16px（或由调用方覆盖）, stroke-width: 1.5px, stroke-line-cap: round, stroke-line-join: round, fill: transparent

