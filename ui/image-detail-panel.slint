// image-detail-panel.slint — 镜像详情面板（复用 DetailRow）

import { VerticalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { DetailRow } from "detail-panel.slint";

export component ImageDetailPanel inherits Rectangle {
    in-out property <string> i_short_id: "";
    in-out property <string> i_repo_tags: "";
    in-out property <string> i_created: "";
    in-out property <string> i_author: "";
    in-out property <string> i_size: "";
    in-out property <string> i_platform: "";
    in-out property <string> i_entrypoint: "";
    in-out property <string> i_cmd: "";
    in-out property <string> i_workdir: "";
    in-out property <string> i_ports: "";
    in-out property <string> i_volumes: "";
    in-out property <string> i_labels: "";
    in-out property <string> i_env: "";
    in-out property <string> i_id: "";

    Flickable {
        width: parent.width;
        height: parent.height;
        content-height: 600px;

        VerticalBox {
            spacing: 2px;
            padding-left: Theme.space-4;
            padding-right: Theme.space-4;
            padding-top: Theme.space-3;
            padding-bottom: Theme.space-3;
            width: parent.width - 24px;

            // —— 基本信息 ——
            VerticalBox { padding-top: Theme.space-1; padding-bottom: Theme.space-1; Text { text: "镜像信息"; color: #aaa; font-size: Theme.text-xs; } }
            DetailRow { label: "ID";       value: root.i_short_id; }
            DetailRow { label: "RepoTag";  value: root.i_repo_tags; }
            DetailRow { label: "创建时间"; value: root.i_created; }
            DetailRow { label: "作者";     value: root.i_author; }
            DetailRow { label: "大小";     value: root.i_size; }
            DetailRow { label: "平台";     value: root.i_platform; }

            // —— 运行配置 ——
            VerticalBox { padding-top: Theme.space-3; padding-bottom: Theme.space-1; Text { text: "运行配置"; color: #aaa; font-size: Theme.text-xs; } }
            DetailRow { label: "Entrypoint"; value: root.i_entrypoint; }
            DetailRow { label: "Cmd";        value: root.i_cmd; }
            DetailRow { label: "工作目录";   value: root.i_workdir; }
            DetailRow { label: "暴露端口";   value: root.i_ports; }
            DetailRow { label: "Volumes";    value: root.i_volumes; }

            // —— 元数据 ——
            VerticalBox { padding-top: Theme.space-3; padding-bottom: Theme.space-1; Text { text: "元数据"; color: #aaa; font-size: Theme.text-xs; } }
            DetailRow { label: "Labels"; value: root.i_labels; }
            DetailRow { label: "Env";    value: root.i_env; }
        }
    }
}
