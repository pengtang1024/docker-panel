import { Theme } from "theme.slint";
// list-area.slint — TabBar + ListArea（不引用 app.slint 的任何 global）
import { ListView, VerticalBox, ScrollView, HorizontalBox } from "std-widgets.slint";
import { TabItem } from "components.slint";
import { ContainerRowDelegate, ImageRowDelegate } from "delegates.slint";
import { ContainerHeader, ImageHeader } from "headers.slint";
import { NetworkHeader, NetworkRowDelegate, VolumeHeader, VolumeRowDelegate } from "network-views.slint";
import { ContainerRow, ImageRow, NetworkRow, VolumeRow } from "models.slint";

export component TabBar inherits HorizontalBox {
    spacing: 0px; height: 36px;
    in-out property <int> active_view: 0;

    TabItem { label: "容器";    active: root.active_view == 0; clicked => { root.active_view = 0; } }
    TabItem { label: "镜像";    active: root.active_view == 1; clicked => { root.active_view = 1; } }
    TabItem { label: "网络";    active: root.active_view == 2; clicked => { root.active_view = 2; } }
    TabItem { label: "卷";      active: root.active_view == 3; clicked => { root.active_view = 3; } }
    HorizontalLayout { }
}

export component ListArea inherits Rectangle {
    in-out property <int> active_view: 0;
    in-out property <[ContainerRow]> container_rows: [];
    in-out property <[ImageRow]> image_rows: [];
    in-out property <[NetworkRow]> network_rows: [];
    in-out property <[VolumeRow]> volume_rows: [];
    in-out property <int> sort_field: 0;
    in-out property <bool> sort_desc: false;
    // callback 注入点（由 app.slint 的 AppActions 实现）
    callback container_click(string);
    callback container_toggle(string);
    callback container_restart(string);
    callback container_logs(string);
    callback container_remove(string);
    callback container_sort(int);
    callback container_toggle_select(string);
    callback image_click(string);
    callback image_remove(string);
    clip: true;

    if active_view == 0: VerticalBox {
        width: parent.width; height: parent.height; spacing: 0px;
        ContainerHeader {
            width: parent.width;
            sort_field <=> root.sort_field;
            sort_desc <=> root.sort_desc;
            sort(f) => { root.container_sort(f); }
        }
        ScrollView { width: parent.width; height: parent.height - 36px;
            ListView { width: parent.width;
                for row in root.container_rows: ContainerRowDelegate {
                    width: parent.width; row_id: row.id; short_id: row.short_id;
                    name: row.name; image: row.image; status: row.status;
                    is_running: row.is_running; is_selected: row.is_selected;
                    compose_project: row.compose_project; compose_service: row.compose_service;
                    is_group_start: row.is_group_start;
                    cpu_percent: row.cpu_percent; mem_usage: row.mem_usage;
                    net_traffic: row.net_traffic;
                    clicked => { root.container_click(row.id); }
                    toggle => { root.container_toggle(row.id); }
                    restart => { root.container_restart(row.id); }
                    logs => { root.container_logs(row.id); }
                    remove => { root.container_remove(row.id); }
                    toggle_select => { root.container_toggle_select(row.id); }
                }
            }
        }
    }

    if active_view == 1: VerticalBox {
        width: parent.width; height: parent.height; spacing: 0px;
        ImageHeader { width: parent.width; }
        ScrollView { width: parent.width; height: parent.height - 36px;
            ListView { width: parent.width;
                for row in root.image_rows: ImageRowDelegate {
                    width: parent.width; row_id: row.id; short_id: row.short_id;
                    name: row.name; tag: row.tag; size: row.size;
                    containers: row.containers;
                    clicked => { root.image_click(row.id); }
                    remove => { root.image_remove(row.id); }
                }
            }
        }
    }

    if active_view == 2: VerticalBox {
        width: parent.width; height: parent.height; spacing: 0px;
        NetworkHeader { width: parent.width; }
        ScrollView { width: parent.width; height: parent.height - 36px;
            ListView { width: parent.width;
                for row in root.network_rows: NetworkRowDelegate {
                    width: parent.width; short_id: row.short_id; name: row.name;
                    driver: row.driver; scope: row.scope;
                }
            }
        }
    }

    if active_view == 3: VerticalBox {
        width: parent.width; height: parent.height; spacing: 0px;
        VolumeHeader { width: parent.width; }
        ScrollView { width: parent.width; height: parent.height - 36px;
            ListView { width: parent.width;
                for row in root.volume_rows: VolumeRowDelegate {
                    width: parent.width; name: row.name; driver: row.driver;
                    mountpoint: row.mountpoint;
                }
            }
        }
    }
}
