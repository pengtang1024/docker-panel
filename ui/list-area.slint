// list-area.slint — 主列表区（表头 + 列表，4 个视图互斥）
import { Theme } from "theme.slint";
import { ListView, ScrollView } from "std-widgets.slint";
import { HeadContainer, HeadImage, HeadNetwork, HeadVolume } from "headers.slint";
import { RowContainer, RowImage, RowNetwork, RowVolume } from "delegates.slint";
import { ContainerRow, ImageRow, NetworkRow, VolumeRow } from "models.slint";

// —— 空状态 ——
export component Blank inherits Rectangle {
    in-out property <string> title: "";
    in-out property <string> hint: "";
    background: Theme.bg-main;

    VerticalLayout {
        width: 100%; height: 100%;
        alignment: center;
        Text {
            text: root.title;
            font-size: Theme.fs-lg; color: Theme.fg-3;
            horizontal-alignment: center;
        }
        Text {
            text: root.hint;
            font-size: Theme.fs; color: Theme.fg-4;
            horizontal-alignment: center;
            visible: root.hint != "";
        }
    }
}

export component ListArea inherits Rectangle {
    in-out property <int> tab: 0;
    in-out property <[ContainerRow]> containers: [];
    in-out property <[ImageRow]> images: [];
    in-out property <[NetworkRow]> networks: [];
    in-out property <[VolumeRow]> volumes: [];
    in-out property <int> sort_field: 0;
    in-out property <bool> sort_desc: false;

    callback c-pick(string);
    callback c-toggle(string);
    callback c-restart(string);
    callback c-logs(string);
    callback c-remove(string);
    callback c-sort(int);
    callback c-box(string);
    callback i-pick(string);
    callback i-remove(string);

    clip: true;
    background: Theme.bg-main;

    VerticalLayout {
        width: 100%; height: 100%;
        spacing: 0px;

        // ===== 容器 =====
        if root.tab == 0: HeadContainer {
            width: 100%;
            sort_field <=> root.sort_field; sort_desc <=> root.sort_desc;
            sort(f) => { root.c-sort(f); }
        }
        if root.tab == 0 && root.containers.length > 0: ScrollView {
            width: 100%; vertical-stretch: 1;
            ListView {
                width: 100%;
                for r in root.containers: RowContainer {
                    width: 100%;
                    id: r.id; is-group: r.is_group_start; group: r.compose_project;
                    service: r.compose_service; name: r.name; image: r.image;
                    state: r.status; running: r.is_running; selected: r.is_selected;
                    cpu: r.cpu_percent; mem: r.mem_usage;
                    pick => { root.c-pick(r.id); }
                    toggle => { root.c-toggle(r.id); }
                    restart => { root.c-restart(r.id); }
                    logs => { root.c-logs(r.id); }
                    remove => { root.c-remove(r.id); }
                    pick-box => { root.c-box(r.id); }
                }
            }
        }
        if root.tab == 0 && root.containers.length == 0: Blank {
            width: 100%; vertical-stretch: 1;
            title: "没有容器"; hint: "用「拉取镜像」获取第一个镜像";
        }

        // ===== 镜像 =====
        if root.tab == 1: HeadImage { width: 100%; }
        if root.tab == 1 && root.images.length > 0: ScrollView {
            width: 100%; vertical-stretch: 1;
            ListView {
                width: 100%;
                for r in root.images: RowImage {
                    width: 100%;
                    id: r.id; repo: r.name; tag: r.tag; size: r.size; used: r.containers;
                    pick => { root.i-pick(r.id); }
                    remove => { root.i-remove(r.id); }
                }
            }
        }
        if root.tab == 1 && root.images.length == 0: Blank {
            width: 100%; vertical-stretch: 1;
            title: "没有镜像"; hint: "点击「拉取镜像」下载";
        }

        // ===== 网络 =====
        if root.tab == 2: HeadNetwork { width: 100%; }
        if root.tab == 2 && root.networks.length > 0: ScrollView {
            width: 100%; vertical-stretch: 1;
            ListView {
                width: 100%;
                for r in root.networks: RowNetwork {
                    width: 100%;
                    name: r.name; driver: r.driver; scope: r.scope; used: r.containers;
                }
            }
        }
        if root.tab == 2 && root.networks.length == 0: Blank {
            width: 100%; vertical-stretch: 1;
            title: "没有网络"; hint: "";
        }

        // ===== 卷 =====
        if root.tab == 3: HeadVolume { width: 100%; }
        if root.tab == 3 && root.volumes.length > 0: ScrollView {
            width: 100%; vertical-stretch: 1;
            ListView {
                width: 100%;
                for r in root.volumes: RowVolume {
                    width: 100%;
                    name: r.name; driver: r.driver; mountpoint: r.mountpoint;
                }
            }
        }
        if root.tab == 3 && root.volumes.length == 0: Blank {
            width: 100%; vertical-stretch: 1;
            title: "没有卷"; hint: "";
        }
    }
}
