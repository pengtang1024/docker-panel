// —— 日志行 delegate + 日志面板 ——

import { VerticalBox, HorizontalBox, ScrollView, ListView } from "std-widgets.slint";
import { LogLineRow } from "models.slint";

// 单行日志——纯文本 + 左对齐 + 等宽感
export component LogLineDelegate inherits HorizontalBox {
    in-out property <string> text: "";
    spacing: 4px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0px;
    padding-bottom: 0px;

    Text {
        text: root.text;
        color: #aaa;
        font-size: 11px;
        overflow: elide;
        wrap: no-wrap;
    }
}

// 日志面板
export component LogPanel inherits Rectangle {
    background: #1e1e2e;
    width: 100%;
    height: 100%;

    in-out property <[LogLineRow]> log_lines: [];

    VerticalBox {
        spacing: 0px;
        width: parent.width;
        height: parent.height;

        Rectangle {
            background: #2a2a3a;
            height: 22px;
            HorizontalBox {
                padding-left: 8px;
                width: parent.width;
                height: parent.height;
                Text {
                    text: "实时日志";
                    font-size: 11px;
                    color: #aaa;
                    vertical-alignment: center;
                }
            }
        }

        ScrollView {
            ListView {
                for line in root.log_lines: LogLineDelegate {
                    text: line.text;
                }
            }
        }
    }
}
