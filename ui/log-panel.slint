import { Theme } from "theme.slint";
// —— 日志行 delegate + 日志面板 ——

import { VerticalBox, HorizontalBox, ScrollView, ListView } from "std-widgets.slint";
import { LogLineRow } from "models.slint";

// 单行日志——纯文本 + 左对齐 + 等宽感
export component LogLineDelegate inherits HorizontalBox {
    in-out property <string> text: "";
    spacing: Theme.space-1;
    padding-left: Theme.space-2;
    padding-right: Theme.space-2;
    padding-top: 0px;
    padding-bottom: 0px;

    Text {
        text: root.text;
        color: Theme.text-secondary;
        font-size: Theme.text-xs;
        overflow: elide;
        wrap: no-wrap;
    }
}

// 日志面板
export component LogPanel inherits Rectangle {
    background: Theme.bg-surface;
    width: 100%;
    height: 100%;

    in-out property <[LogLineRow]> log_lines: [];

    VerticalBox {
        spacing: 0px;
        width: parent.width;
        height: parent.height;

        Rectangle {
            background: Theme.bg-surface;
            height: 22px;
            HorizontalBox {
                padding-left: Theme.space-3;
                width: parent.width;
                height: parent.height;
                Text {
                    text: "实时日志";
                    font-size: Theme.text-xs;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
            }
        }

        ScrollView {
            ListView {
                for line in root.log_lines: LogLineDelegate {
                    text: line.text;
                }
            }
        }
    }
}
