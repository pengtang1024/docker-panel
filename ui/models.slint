// —— 数据 struct：Rust ↔ Slint 桥接 ——
// Slint 自动生成对应 Rust 类型（snake_case 转换）
//
// 纪律：struct 内**禁止嵌套数组**（`[string]` 会让整个 struct 失去 Send，
// 无法跨线程投递到 invoke_from_event_loop）。多值一律拆成 N 个标量 + 溢出计数。

export struct ContainerRow {
    id: string,
    name: string,
    image: string,
    // —— 内联树行型（0=容器行 1=项目带 2=服务带）——
    kind: int,
    /// 层级缩进（0=项目带 1=项目下的容器 / 服务带 2=服务下的容器）
    depth: int,
    /// 分组带是否展开（仅 kind>=1 有意义）
    expanded: bool,
    /// 分组带的成员数（仅 kind>=1 有意义）
    group_n: int,
    is_running: bool,
    is_selected: bool,
    /// 需关注（非 0 退出 / dead / paused / restarting）→ 琥珀色状态轨
    needs_attention: bool,
    // —— Compose 分组 ——
    compose_project: string,       // 空字符串表示非 Compose 容器
    compose_color: color,          // compose 项目标签配色（按项目名稳定散列）
    // —— 资源监控（台账：一位小数百分比，右对齐等宽体）——
    cpu_text: string,              // 如 "12.4%"（停止时 "—"）
    mem_text: string,              // 如 "673M"（停止时 "—"）
    disk: string,                  // 如 "596K"（容器可写层占用）
    /// 微条长度比例（0..1，docker stats 口径的绝对占比：占上限的比例）
    cpu_ratio: float,
    mem_ratio: float,
    // —— 端口 ——
    ports_text: string,            // 列内展示的短标签（空格分隔，如 "8081 8083"）
}

/// 台账概览带（方向 A）：4 个计数 + CPU 占用 TOP4
///
/// TOP4 展平成 4 组标量而不是数组 —— Slint struct 内禁止嵌套数组
/// （会让 struct 失去 Send，无法跨线程投递）。
export struct LedgerSummary {
    total: int,
    running: int,
    stopped: int,
    attention: int,                // 需关注数量
    top_name1: string, top_pct1: string, top_ratio1: float,
    top_name2: string, top_pct2: string, top_ratio2: float,
    top_name3: string, top_pct3: string, top_ratio3: float,
    top_name4: string, top_pct4: string, top_ratio4: float,
}

export struct ImageRow {
    id: string,                    // "repo:tag"（选中/删除/详情的主键）
    short_id: string,
    name: string,                  // 仓库名（不含 tag）
    size: string,                  // 格式化大小
    layers: string,                // 层数（未回填时 "—"）
    created: string,               // 相对时间（如 "2 days ago"）
    containers: int,               // 关联容器数
    // —— tag 芯片（spec 3.2 .tags：最多 3 个 +N，latest 高亮）——
    tag1: string,
    tag2: string,
    tag3: string,
    tags_more: int,
    tags_text: string,             // 全部 tag（搜索/过滤与 tooltip 用）
}

export struct NetworkRow {
    id: string,
    short_id: string,
    name: string,
    driver: string,
    scope: string,
    subnet: string,               // 第一个 IPAM 子网（空 = 无）
    containers: int,
    builtin: bool,                // bridge / host / none
}

export struct VolumeRow {
    name: string,                 // 原始卷名（详情/删除主键，tooltip 全文）
    display_name: string,         // 匿名卷截断展示名（12 字符 + …）
    driver: string,
    mountpoint: string,
    size: string,                 // 来自低频 /system/df；未采样时 "—"
    anonymous: bool,
}

// 日志行（虚拟化列表的一行 = 一条日志）
// 逐行成行而非整段文本：整段塞进 TextInput 时，每次新增日志都要让渲染器
// 重排 + 重绘全部缓冲行（实测 500 行时软件渲染器吃掉一个 CPU 核）；
// 拆成行后由 ListView 只实例化视口内的行，成本与视口高度成正比。
export struct LogRow {
    text: string,
}

// 抽屉 / 详情面板的通用行（对齐 prototype .sec / .kv / .box / .kv-list）
export struct DetailPair {
    kind: int,     // 0=kv 行（k 左 v 右） 1=分节标题 2=kv + 代码盒 3=代码盒条目
    k: string,     // kind 0/2 的键名；kind 1 的节标题；kind 3 的高亮前缀（可空）
    v: string,     // kind 0/2/3 的值；kind 3 多行按 '\n' 拆成多条
    mono: bool,    // 值使用等宽字体（ID / 端口 / 路径）
}
