// —— 数据 struct：Rust ↔ Slint 桥接 ——
// 这些 struct 定义后，slint_gen.rs 的 include_modules!() 会生成对应的 Rust 类型，
// 所以不能随便改名或删字段——Rust 侧 main.rs 的 build_container_rows 直接构造它们。

export struct ContainerRow {
    id: string,
    short_id: string,
    name: string,
    image: string,
    status: string,
    is_running: bool,
}

export struct ImageRow {
    id: string,
    short_id: string,
    name: string,
    tag: string,
    size: string,
    containers: int,
}
