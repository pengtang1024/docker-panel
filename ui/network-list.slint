// network-list.slint — 网络表格列表（表头可排序 + 30px 虚拟化行）
//
// 精简列：名称 · driver · 子网
// 列起点固定：表头与行共用同一组列宽（由本组件统一下发）。
import { Theme } from "theme.slint";
import { VCenterText } from "components-align.slint";
import { ListCols, ListHeadCell } from "components-list.slint";
import { NetworkRow } from "models.slint";
import { ListView } from "@material";

// ============ 行（30px）============
component NetworkRowView inherits Rectangle {
    in property <NetworkRow> data;
    in property <length> name_w: 200px;
    in property <length> driver_w: 130px;
    in property <length> subnet_w: 200px;

    callback select(string);

    height: 30px;
    background: touch.has-hover ? Theme.row_hover : transparent;

    // 行热区：必须声明在内容**之前**（命中顺序铁律，规范 #19）
    touch := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.select(root.data.id); }
    }

    HorizontalLayout {
        width: 100%; height: 100%;
        spacing: ListCols.gap;
        padding-left: ListCols.pad_x; padding-right: ListCols.pad_x;
        cross-axis-alignment: center;

        // 名称（内置网络加标记；标记紧跟名称，不被弹性列推到远端）
        HorizontalLayout {
            width: root.name_w; height: 100%;
            horizontal-stretch: 0;
            spacing: 6px;
            VCenterText {
                text: root.data.name;
                horizontal-stretch: 0; min-width: 0px;
                font-size: Theme.fs_md; font-weight: 600;
                color: Theme.ink;
                overflow: elide;
            }
            if root.data.builtin : VCenterText {
                text: "(" + @tr("Builtin") + ")";
                font-size: Theme.fs_xs;
                color: Theme.ink_3;
            }
            Rectangle { horizontal-stretch: 1; }
        }

        // driver
        VCenterText {
            text: root.data.driver;
            width: root.driver_w; horizontal-stretch: 0;
            font-size: Theme.fs_sm; font-family: Theme.mono;
            color: Theme.ink_2;
            overflow: elide;
        }

        // 子网
        VCenterText {
            text: root.data.subnet;
            width: root.subnet_w; horizontal-stretch: 0;
            font-size: Theme.fs_sm; font-family: Theme.mono;
            color: Theme.ink_3;
            overflow: elide;
        }
    }
}

export component NetworkList inherits Rectangle {
    in-out property <[NetworkRow]> rows: [];
    /// 当前排序列（0=名称 1=driver 2=子网）
    in-out property <int> sort_field: 0;
    in-out property <bool> sort_desc: true;

    callback sort_pick(int);
    callback select(string);

    // —— 列宽（表头与行共用）——
    property <length> driver_w: 130px;
    property <length> subnet_w: 200px;
    property <length> content_w: root.width - ListCols.scrollbar_slot - ListCols.pad_x * 2;
    property <length> name_w: root.content_w - root.driver_w - root.subnet_w - ListCols.gap * 2;

    VerticalLayout {
        width: 100%; height: 100%;
        spacing: 0px;

        // 表头（固定在滚动区之外 → 天然 sticky）
        Rectangle {
            vertical-stretch: 0;
            height: ListCols.head_h;
            background: Theme.bg;
            Rectangle {
                y: parent.height - 1px;
                width: 100%; height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                width: 100%; height: 100%;
                spacing: ListCols.gap;
                padding-left: ListCols.pad_x;
                padding-right: ListCols.pad_x + ListCols.scrollbar_slot;
                cross-axis-alignment: center;

                ListHeadCell {
                    text: @tr("Network");
                    cell_w: root.name_w;
                    active: root.sort_field == 0;
                    desc: root.sort_desc;
                    show_arrow: true;
                    picked => { root.sort_pick(0); }
                }
                ListHeadCell {
                    text: @tr("Driver");
                    cell_w: root.driver_w;
                    active: root.sort_field == 1;
                    desc: root.sort_desc;
                    show_arrow: true;
                    picked => { root.sort_pick(1); }
                }
                ListHeadCell {
                    text: @tr("Subnet");
                    cell_w: root.subnet_w;
                    active: root.sort_field == 2;
                    desc: root.sort_desc;
                    show_arrow: true;
                    picked => { root.sort_pick(2); }
                }
            }
        }

        // 行列表（虚拟化：只渲染视口内的行）
        list := ListView {
            vertical-stretch: 1;
            width: 100%;
            vertical-scrollbar-policy: as-needed;
            horizontal-scrollbar-policy: always-off;
            content_width: self.visible_width;
            mouse_drag_pan_enabled: false;
            for row[i] in root.rows : NetworkRowView {
                data: row;
                width: 100%;
                height: ListCols.row_h;
                name_w: root.name_w;
                driver_w: root.driver_w;
                subnet_w: root.subnet_w;
                select(id) => { root.select(id); }
            }
        }
    }
}
