import { Theme } from "theme.slint";
// network-views.slint — 网络 + 卷的 Header + Delegate
// 列宽全部引用 Theme.col-* 令牌

import { HorizontalBox } from "std-widgets.slint";

// —— 网络表头 ——
export component NetworkHeader inherits Rectangle {
    height: 32px; background: Theme.bg-root;
    HorizontalBox {
        spacing: Theme.space-3; padding-left: Theme.space-3; padding-right: Theme.space-3;
        width: parent.width; height: parent.height;
        Text { text: "ID";     min-width: Theme.col-id;    color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
        Text { text: "名称";   min-width: Theme.col-name;  color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
        HorizontalLayout { }
        Text { text: "驱动";   min-width: Theme.col-status; color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
        Text { text: "范围";   min-width: Theme.col-net-scope; color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
    }
    Rectangle { background: Theme.divider; width: parent.width; height: 1px; y: parent.height - 1px; }
}

// —— 网络行 ——
export component NetworkRowDelegate inherits Rectangle {
    in-out property <string> short_id: "";
    in-out property <string> name: "";
    in-out property <string> driver: "";
    in-out property <string> scope: "";
    height: 36px;
    HorizontalBox {
        spacing: Theme.space-3; padding-left: Theme.space-3; padding-right: Theme.space-3;
        width: parent.width; height: parent.height;
        Text { text: root.short_id; min-width: Theme.col-id;          color: Theme.text-faint;  font-size: Theme.text-sm; }
        Text { text: root.name;     min-width: Theme.col-name;        color: Theme.text-normal; overflow: elide; }
        HorizontalLayout { }
        Text { text: root.driver;   min-width: Theme.col-status;      color: Theme.accent;      font-size: Theme.text-sm; }
        Text { text: root.scope;    min-width: Theme.col-net-scope;   color: Theme.text-muted;  font-size: Theme.text-sm; }
    }
}

// —— 卷表头 ——
export component VolumeHeader inherits Rectangle {
    height: 32px; background: Theme.bg-root;
    HorizontalBox {
        spacing: Theme.space-3; padding-left: Theme.space-3; padding-right: Theme.space-3;
        width: parent.width; height: parent.height;
        Text { text: "名称";   min-width: Theme.col-name; color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
        HorizontalLayout { }
        Text { text: "驱动";   min-width: Theme.col-tag;  color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
        Text { text: "挂载点"; color: Theme.text-muted; font-size: Theme.text-sm; font-weight: 600; }
    }
    Rectangle { background: Theme.divider; width: parent.width; height: 1px; y: parent.height - 1px; }
}

// —— 卷行 ——
export component VolumeRowDelegate inherits Rectangle {
    in-out property <string> name: "";
    in-out property <string> driver: "";
    in-out property <string> mountpoint: "";
    height: 36px;
    HorizontalBox {
        spacing: Theme.space-3; padding-left: Theme.space-3; padding-right: Theme.space-3;
        width: parent.width; height: parent.height;
        Text { text: root.name;       min-width: Theme.col-name; color: Theme.text-normal; overflow: elide; }
        HorizontalLayout { }
        Text { text: root.driver;     min-width: Theme.col-tag;  color: Theme.accent;      font-size: Theme.text-sm; }
        Text { text: root.mountpoint; color: Theme.text-muted;   font-size: Theme.text-sm; overflow: elide; }
    }
}
