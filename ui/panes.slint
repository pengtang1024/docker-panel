// panes.slint — 顶栏 / 工具栏 / 状态栏
import { Theme } from "theme.slint";
import { Button, SearchBox, ConnBadge } from "components.slint";

// ============ 顶栏 ============
export component TopBar inherits Rectangle {
    in-out property <bool> online: false;
    callback refresh();
    callback search(string);

    height: Theme.top-h;
    background: Theme.bg-side;

    VerticalLayout {
        width: 100%; height: 100%;
        alignment: center;
        HorizontalLayout {
            padding-left: Theme.s5; padding-right: Theme.s4;
            spacing: Theme.s3;
            alignment: center;

            Text {
                text: "▣";
                font-size: Theme.fs-lg;
                color: Theme.accent;
                }
            Text {
                text: "Docker Panel";
                font-size: Theme.fs-lg;
                font-weight: 700;
                color: Theme.fg;
                }
            Rectangle { width: Theme.s2; height: 1px; }
            ConnBadge { online <=> root.online; }
            Rectangle { horizontal-stretch: 1; }

            SearchBox {
                width: 260px;
                accepted() => { root.search(s); }
            }
            Rectangle { width: Theme.s1; height: 1px; }
            Button { text: "刷新"; glyph: "↻"; clicked => { root.refresh(); } }
        }
    }

    Rectangle { x: 0; y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line; }
}

// ============ 工具栏 ============
export component ToolBar inherits Rectangle {
    in-out property <int> running: 0;
    callback stop_all();
    callback pull();
    callback cleanup();

    height: Theme.tool-h;
    background: Theme.bg-main;

    VerticalLayout {
        width: 100%; height: 100%;
        alignment: center;
        HorizontalLayout {
            padding-left: Theme.s5; padding-right: Theme.s4;
            spacing: Theme.s2;
            alignment: center;

            Button { text: "拉取镜像"; glyph: "↓"; primary: true; clicked => { root.pull(); } }
            Button { text: "清理资源"; glyph: "✦"; clicked => { root.cleanup(); } }
            Rectangle { width: Theme.s3; height: 1px; }
            Button {
                text: "停止全部"; glyph: "■"; danger: true;
                enabled: root.running > 0;
                clicked => { root.stop_all(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    Rectangle { x: 0; y: 0; width: 100%; height: 1px; background: Theme.line; }
}

// ============ 状态栏 ============
export component FootBar inherits Rectangle {
    in-out property <string> status: "就绪";
    in-out property <string> summary: "";

    height: Theme.foot-h;
    background: Theme.bg-side;

    VerticalLayout {
        width: 100%; height: 100%;
        padding-left: Theme.s5; padding-right: Theme.s5;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            spacing: Theme.s2;
            Rectangle { width: 5px; height: 5px; border-radius: 3px; background: Theme.accent; }
            Text {
                text: root.status;
                font-size: Theme.fs-sm;
                color: Theme.fg-3;
                }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.summary;
                font-size: Theme.fs-sm;
                color: Theme.fg-4;
                }
        }
    }
}
