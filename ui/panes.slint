// —— Slint UI 面板组件（顶栏 / 工具栏 / 状态栏）——
// 统一使用 components.slint 的现代皮肤组件
import { SearchInput, FlatButton, StatusChip } from "components.slint";
import { HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

// —— 顶栏：Logo chip + Docker 连接状态 chip + 搜索框 + 刷新按钮 ——
export component TopBar inherits HorizontalBox {
    in-out property <bool> docker_ok: false;

    callback refresh();
    callback search(string);

    spacing: Theme.space-3;

    // Logo 区（圆角胶囊）
    Rectangle {
        height: 32px; border-radius: 6px;
        background: Theme.bg-card;
        HorizontalBox {
            x: 0; y: 0; width: parent.width; height: parent.height;
            padding-left: Theme.space-3; padding-right: Theme.space-3;
            Text {
                text: "🐳 Docker Panel";
                height: parent.height; vertical-alignment: center;
                font-size: Theme.text-base; font-weight: 700;
                color: Theme.text-primary;
            }
        }
    }

    // Docker 连接状态 pill
    StatusChip { online <=> root.docker_ok; }

    HorizontalLayout { }

    // 搜索框（带 🔍 图标前缀 + 圆角）
    SearchInput {
        accepted(s) => { root.search(s); }
        min-width: 200px;
    }

    // 刷新按钮
    FlatButton {
        text: "刷新"; icon: "↻";
        clicked => { root.refresh(); }
    }
}

// —— Tab 下方工具栏 ——
export component ToolBar inherits HorizontalBox {
    callback stop_all();
    callback pull_requested();
    callback cleanup_requested();

    spacing: Theme.space-2;
    padding-top: Theme.space-1;

    FlatButton {
        text: "停止全部"; icon: "⏹";
        clicked => { root.stop_all(); }
    }
    FlatButton {
        text: "拉取镜像"; icon: "⬇";
        clicked => { root.pull_requested(); }
    }
    FlatButton {
        text: "清理资源"; icon: "🧹";
        clicked => { root.cleanup_requested(); }
    }
    HorizontalLayout { }
}

// —— 状态栏：底部状态文本 + 容器/镜像计数 ——
export component StatusBar inherits HorizontalBox {
    in-out property <string> status_text: "就绪";
    in-out property <string> container_count: "0";
    in-out property <string> image_count: "0";

    spacing: Theme.space-4;
    padding-left: Theme.space-3;
    padding-right: Theme.space-3;
    padding-top: Theme.space-1;
    padding-bottom: Theme.space-1;

    Text { text: root.status_text; }
    HorizontalLayout { }
    Text {
        text: root.container_count + " 容器  ·  " + root.image_count + " 镜像";
        color: Theme.text-faint; font-size: Theme.text-xs;
    }
}
