// —— Slint UI 面板组件 v2（顶栏 / 工具栏 / 状态栏）——
import { SearchInput, FlatButton, StatusChip, IconButton } from "components.slint";
import { HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

// —— 顶栏：Logo chip + Docker 连接状态 chip + 搜索框 + 刷新按钮 ——
export component TopBar inherits Rectangle {
    in-out property <bool> docker_ok: false;
    callback refresh();
    callback search(string);

    height: 48px;
    HorizontalBox {
        x: 0; y: 0; width: parent.width; height: parent.height;
        spacing: Theme.space-3;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;

        // Logo 胶囊
        Rectangle {
            height: 36px; border-radius: 6px;
            background: Theme.bg-surface;
            HorizontalBox {
                x: 0; y: 0; width: parent.width; height: parent.height;
                padding-left: Theme.space-3; padding-right: Theme.space-3;
                spacing: Theme.space-1;
                Text {
                    text: "◆";
                    height: parent.height; vertical-alignment: center;
                    font-size: Theme.text-base;
                    color: Theme.accent;
                }
                Text {
                    text: "Docker Panel";
                    height: parent.height; vertical-alignment: center;
                    font-size: Theme.text-base; font-weight: 700;
                    color: Theme.text-primary;
                }
            }
        }

        StatusChip { height: 26px; online <=> root.docker_ok; }

        HorizontalLayout { }

        SearchInput {
            height: 36px;
            min-width: 220px;
            accepted(s) => { root.search(s); }
        }

        FlatButton {
            height: 32px;
            icon: "↻"; text: "刷新";
            clicked => { root.refresh(); }
        }
    }
}

// —— ToolBar：三个 icon-only 按钮 ——
export component ToolBar inherits Rectangle {
    callback stop_all();
    callback pull_requested();
    callback cleanup_requested();

    height: 36px;

    HorizontalBox {
        x: 0; y: 0; width: parent.width; height: parent.height;
        spacing: Theme.space-3;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;

        HorizontalLayout { }

        IconButton { icon: "⏹"; clicked => { root.stop_all(); } }
        IconButton { icon: "⬇"; clicked => { root.pull_requested(); } }
        IconButton { icon: "🧹"; clicked => { root.cleanup_requested(); } }

        HorizontalLayout { }
    }
}

// —— 状态栏：底部状态文本 + 容器/镜像计数 ——
export component StatusBar inherits Rectangle {
    in-out property <string> status_text: "就绪";
    in-out property <string> container_count: "0";
    in-out property <string> image_count: "0";

    height: 28px;
    HorizontalBox {
        x: 0; y: 0; width: parent.width; height: parent.height;
        spacing: Theme.space-4;
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;

        Text {
            text: root.status_text;
            height: parent.height; vertical-alignment: center;
            color: Theme.text-muted; font-size: Theme.text-xs;
        }
        HorizontalLayout { }
        Text {
            text: root.container_count + " 容器  ·  " + root.image_count + " 镜像";
            height: parent.height; vertical-alignment: center;
            color: Theme.text-faint; font-size: Theme.text-xs;
        }
    }
}
