// —— Slint UI 面板组件（顶栏 / 工具栏 / 状态栏）——
// 每个组件都只声明自己的 in-out 属性 + 回调，不直接依赖 AppActions global。
// MainWindow 负责把 root.xxx <=> component.xxx 连起来。

import { Button, LineEdit, HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

// —— 顶栏：Logo + Docker 连接状态 + 搜索 + 刷新 ——
export component TopBar inherits HorizontalBox {
    in-out property <bool> docker_ok: false;

    callback refresh();
    callback search(string);

    spacing: Theme.space-4;

    Text {
        text: "Docker Panel";
        font-size: Theme.text-lg;
        font-weight: 700;
    }
    Text {
        text: root.docker_ok ? "● 已连接" : "○ 未连接";
        color: root.docker_ok ? Theme.status-running : Theme.status-error;
    }
    HorizontalLayout { }
    LineEdit {
        placeholder-text: "搜索...";
        accepted => { root.search(self.text); }
    }
    Button {
        text: "↻ 刷新";
        clicked => { root.refresh(); }
    }
}

// —— Tab 下方工具栏 ——
export component ToolBar inherits HorizontalBox {
    callback stop_all();
    callback pull_requested();
    callback cleanup_requested();

    spacing: Theme.space-3;
    padding-top: Theme.space-1;

    Button {
        text: "停止全部运行中容器";
        clicked => { root.stop_all(); }
    }
    Button {
        text: "拉取镜像";
        clicked => { root.pull_requested(); }
    }
    Button {
        text: "清理未使用资源";
        clicked => { root.cleanup_requested(); }
    }
    HorizontalLayout { }
}

// —— 状态栏：底部状态文本 + 容器/镜像计数 ——
export component StatusBar inherits HorizontalBox {
    in-out property <string> status_text: "就绪";
    in-out property <string> container_count: "0";
    in-out property <string> image_count: "0";

    spacing: Theme.space-4;
    padding-left: Theme.space-3;
    padding-right: Theme.space-3;
    padding-top: Theme.space-1;
    padding-bottom: Theme.space-1;

    Text {
        text: root.status_text;
    }
    HorizontalLayout { }
    Text {
        text: root.container_count + " 容器  ·  " + root.image_count + " 镜像";
        color: Theme.text-faint;
    }
}
