// sidebar.slint — 左侧导航栏
import { Theme } from "theme.slint";
import { NavItem } from "components.slint";

export component Sidebar inherits Rectangle {
    in-out property <int> tab: 0;
    in-out property <int> n-container: 0;
    in-out property <int> n-image: 0;
    in-out property <int> n-network: 0;
    in-out property <int> n-volume: 0;
    in-out property <int> n-running: 0;

    background: Theme.bg-side;

    VerticalLayout {
        width: 100%; height: 100%;
        padding-top: Theme.s4;
        padding-bottom: Theme.s3;
        spacing: 0px;

        // 分组标题
        Text {
            text: "  资源";
            font-size: Theme.fs-xs;
            font-weight: 700;
            color: Theme.fg-4;
            width: 100%; height: 22px;
            vertical-alignment: center;
        }

        NavItem {
            width: 100%;
            glyph: "■"; label: "容器"; count: root.n-container;
            active: root.tab == 0;
            clicked => { root.tab = 0; }
        }
        NavItem {
            width: 100%;
            glyph: "◆"; label: "镜像"; count: root.n-image;
            active: root.tab == 1;
            clicked => { root.tab = 1; }
        }
        NavItem {
            width: 100%;
            glyph: "●"; label: "网络"; count: root.n-network;
            active: root.tab == 2;
            clicked => { root.tab = 2; }
        }
        NavItem {
            width: 100%;
            glyph: "▲"; label: "卷"; count: root.n-volume;
            active: root.tab == 3;
            clicked => { root.tab = 3; }
        }

        Rectangle { vertical-stretch: 1; }

        // 运行统计（外层占满，内层留边距）
        Rectangle {
            width: 100%; height: 40px;
            Rectangle {
                x: Theme.s3; y: 0;
                width: parent.width - 2 * Theme.s3; height: 100%;
                border-radius: 6px;
                background: Theme.bg-card;

                VerticalLayout {
                    width: 100%; height: 100%;
                    padding-left: Theme.s3; padding-right: Theme.s3;
                    alignment: center;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 6px; height: 6px; border-radius: 3px;
                            background: root.n-running > 0 ? Theme.ok : Theme.fg-4;
                        }
                        Rectangle { width: 5px; height: 1px; }
                        Text {
                            text: "运行中 " + root.n-running;
                            font-size: Theme.fs-sm;
                            font-weight: 600;
                            color: Theme.fg-2;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    Rectangle { x: parent.width - 1px; y: 0; width: 1px; height: 100%; background: Theme.line; }
}
