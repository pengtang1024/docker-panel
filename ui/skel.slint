// skel.slint — 骨架屏占位组件（prototype .skel-card / .skel-line）
// 仅在 loading 中间态使用：首次数据拉取 / refresh 期间。
// shimmer 光带动画：Slint animate block 是属性变化动画（duration/easing/iteration-count -1），
// 不支持 CSS @keyframes from/to 语法，也没有 timeout 自动切换的 state 循环。
// 如需 shimmer：Rust 侧 spawn tokio 1.4s interval 调 invoke_from_event_loop 更新 shimmer_x。
// 纯 .slint markup 可实现 LinearGradient 光带（@linear-gradient brush literal），
// 但必须由属性变化驱动动画。
import { Theme } from "theme.slint";

// 骨架线：不同宽度（硬设百分比）
export component SkelLine inherits Rectangle {
    in-out property <length> line_h: 12px;

    height: self.line_h;
    border-radius: 4px;
    background: Theme.skel;
}

// 骨架卡片：4 条 SkelLine（硬设宽度）+ 左侧 3px 装饰竖线
export component SkelCard inherits Rectangle {
    width: 100%;
    height: 104px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: Theme.r;

    Rectangle {
        x: 0px;
        y: 9px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 2px;
        background: Theme.skel;
    }

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding-left: 11px;
        padding-top: 9px;
        padding-bottom: 7px;
        spacing: 8px;

        SkelLine { width: 60%; }
        SkelLine { width: 40%; }
        SkelLine { width: 80%; }
        SkelLine { width: 30%; }
    }
}

// 网格骨架屏：for 循环渲染 6 个 SkelCard（两行 × 三列）
export component SkelGrid inherits Flickable {
    VerticalLayout {
        width: 100%;
        spacing: 12px;

        HorizontalLayout {
            width: 100%;
            spacing: 12px;
            for i[i] in 3 : SkelCard { }
        }
        HorizontalLayout {
            width: 100%;
            spacing: 12px;
            for i[i] in 3 : SkelCard { }
        }
    }
}
