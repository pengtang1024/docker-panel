// sub-bar.slint — 筛选栏（状态芯片 + Compose 项目芯片 + 排序菜单 + 视图 Tab）
import { Theme } from "theme.slint";
import { Dropdown, MenuItem } from "components.slint";
import { ComposeRow } from "models.slint";

component Chip inherits Rectangle {
    in property <string> label: "";
    in property <int> n: 0;
    in property <bool> active: false;
    in property <string> key: "";
    callback clicked(string);
    height: 26px;
    border-radius: 13px;
    background: root.active ? Theme.pill_on_bg : Theme.bg;
    border-width: 1px;
    border-color: root.active ? Theme.ok : Theme.line;
    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.s2;
        padding-left: Theme.s3;
        padding-right: Theme.s3;
        Text { text: root.label; font-size: Theme.fs_xs; font-weight: 600; color: root.active ? Theme.ok : Theme.ink_2; }
        Text { text: root.n; font-size: Theme.fs_xs; color: root.active ? Theme.ok : Theme.ink_3; }
    }
    TouchArea { clicked => { root.clicked(root.key); } }
}

component ViewTab inherits Rectangle {
    in property <string> label: "";
    in property <int> n: 0;
    in property <bool> active: false;
    in property <int> idx: 0;
    callback clicked(int);
    height: 100%;
    // 底部高亮条
    Rectangle {
        y: parent.height - 2px;
        width: 100%;
        height: 2px;
        background: root.active ? Theme.ink : transparent;
    }
    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.s2;
        alignment: center;
        Text { text: root.label; font-size: Theme.fs_sm; font-weight: 600; color: root.active ? Theme.ink : Theme.ink_3; vertical-alignment: center; }
        Text { text: root.n; font-size: Theme.fs_xs; color: root.active ? Theme.ink_2 : Theme.ink_4; vertical-alignment: center; }
    }
    TouchArea { clicked => { root.clicked(root.idx); } }
}

export component SubBar inherits Rectangle {
    height: Theme.sub_h;
    background: Theme.card;
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.line;
    }

    in-out property <int> view: 0;
    in-out property <string> filter: "all";
    in-out property <int> sort_field: 0;
    in-out property <bool> sort_desc: true;
    in-out property <[ComposeRow]> compose_rows: [];
    in-out property <int> total_containers: 0;
    in-out property <int> running_containers: 0;
    in-out property <int> total_images: 0;
    in-out property <int> total_networks: 0;
    in-out property <int> total_volumes: 0;

    /// 排序菜单展开状态与锚点（菜单本体渲染在 app.slint 顶层，
    /// 否则会被下方 CardsArea 覆盖 —— 与 prototype 的绝对定位下拉一致）
    in-out property <bool> sort_open: false;
    out property <length> menu_x: 0;
    out property <length> menu_y: 0;

    callback set_view(int);
    callback set_filter(string);
    callback set_sort(int);
    callback set_sort_dir();

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.s4;
        padding-left: Theme.s5;
        padding-right: Theme.s5;

        Chip { label: @tr("All"); n: root.total_containers; active: root.filter == "all"; key: "all"; clicked(k) => { root.set_filter(k); } }
        Chip { label: @tr("Running"); n: root.running_containers; active: root.filter == "running"; key: "running"; clicked(k) => { root.set_filter(k); } }
        Chip { label: @tr("Stopped"); n: root.total_containers - root.running_containers; active: root.filter == "stopped"; key: "stopped"; clicked(k) => { root.set_filter(k); } }
        for row[i] in root.compose_rows : Chip {
            label: row.name;
            n: row.n;
            key: row.name;
            active: root.filter == row.name;
            clicked(k) => { root.set_filter(k); }
        }

        Rectangle { horizontal-stretch: 1; }

        // 排序按钮（点击展开菜单；点箭头只切升降序）
        sort_btn := Rectangle {
            height: 28px;
            border-radius: Theme.r_sm;
            background: root.sort_open ? Theme.bg : Theme.card;
            border-width: 1px;
            border-color: root.sort_open ? Theme.ink_4 : Theme.line;
            HorizontalLayout {
                width: 100%;
                height: 100%;
                spacing: Theme.s2;
                padding-left: Theme.s3;
                padding-right: Theme.s3;
                Text { text: "↕"; color: Theme.ink_3; font-size: 12px; vertical-alignment: center; }
                Text {
                    text: [@tr("Name"),@tr("CPU"),@tr("Memory"),@tr("Disk"),@tr("Status")][root.sort_field];
                    font-size: Theme.fs_xs;
                    color: Theme.ink_2;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 16px;
                    height: 100%;
                    Text { text: root.sort_desc ? "↓" : "↑"; color: Theme.ink_3; font-size: 10px; vertical-alignment: center; }
                    // 点箭头只切升降序（覆盖在按钮 TouchArea 之上）
                    TouchArea { clicked => { root.set_sort_dir(); } }
                }
            }
            TouchArea { clicked => {
                root.sort_open = root.sort_open == false;
                root.menu_x = sort_btn.absolute-position.x + sort_btn.width - 132px;
                root.menu_y = sort_btn.absolute-position.y + sort_btn.height + 6px;
            } }
        }

        ViewTab { label: @tr("Containers"); n: root.total_containers; active: root.view == 0; idx: 0; clicked(i) => { root.set_view(i); } }
        ViewTab { label: @tr("Images"); n: root.total_images; active: root.view == 1; idx: 1; clicked(i) => { root.set_view(i); } }
        ViewTab { label: @tr("Networks"); n: root.total_networks; active: root.view == 2; idx: 2; clicked(i) => { root.set_view(i); } }
        ViewTab { label: @tr("Volumes"); n: root.total_volumes; active: root.view == 3; idx: 3; clicked(i) => { root.set_view(i); } }
    }
}
