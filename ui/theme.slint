// theme.slint — 设计令牌（唯一真相源）
// 三态主题：auto(跟随系统) / light / dark
// 所有组件引用 Theme.* 属性，切换 theme_mode 时自动更新。

export global Theme {
    // ===== 主题模式 =====
    in-out property <int> theme_mode: 0;   // 0=auto, 1=light, 2=dark
    in-out property <bool> system_dark: false; // Rust 侧检测系统主题后设置

    /// 当前是否深色（对外可见：M3 组件库接线用 Palette.color-scheme）
    out property <bool> is_dark: theme_mode == 2 || (theme_mode == 0 && system_dark);

    // ===== 色彩：浅色 / 深色 =====
    out property <color> bg: is_dark ? #0c0c0e : #f7f7f8;
    out property <color> card: is_dark ? #18181b : #ffffff;
    out property <color> line: is_dark ? #27272a : #ebeaee;
    out property <color> line_2: is_dark ? #1f1f23 : #f4f4f5;

    out property <color> ink: is_dark ? #fafafa : #0e0e11;
    out property <color> ink_2: is_dark ? #a1a1aa : #52525b;
    out property <color> ink_3: is_dark ? #71717a : #a1a1aa;
    out property <color> ink_4: is_dark ? #3f3f46 : #d4d4d8;

    out property <color> ok: is_dark ? #4ade80 : #16a34a;
    out property <color> stop: is_dark ? #71717a : #a1a1aa;
    out property <color> warn: is_dark ? #fbbf24 : #d97706;
    out property <color> err: is_dark ? #f87171 : #dc2626;
    out property <color> accent: is_dark ? #fafafa : #0e0e11;

    out property <color> pill_on_bg: is_dark ? rgba(74,222,128,0.14) : rgba(22,163,74,0.10);
    out property <color> pill_off_bg: is_dark ? rgba(113,113,122,0.18) : rgba(161,161,170,0.14);

    // 交互态（组件层统一引用，禁止各处硬编码）
    out property <color> row_hover: is_dark ? #232327 : #f4f4f5;
    out property <color> row_sel: is_dark ? #27272a : #ebeaee;
    out property <color> err_bg: is_dark ? #3a2024 : #fdecec;

    out property <color> bar_bg: is_dark ? #27272a : #f0f0f3;
    out property <color> bar_cpu: is_dark ? #60a5fa : #3b82f6;
    out property <color> bar_mem: is_dark ? #a78bfa : #8b5cf6;

    out property <color> overlay: is_dark ? rgba(0,0,0,0.55) : rgba(14,14,17,0.4);
    out property <color> skel: is_dark ? #1f1f23 : #ebeaee;
    out property <color> skel_hi: is_dark ? #27272a : #f4f4f5;

    out property <color> log_bg: is_dark ? #000000 : #f4f4f5;
    out property <color> log_ink: is_dark ? #e4e4e7 : #0e0e11;
    out property <color> log_dim: is_dark ? #52525b : #a1a1aa;

    out property <color> tip_bg: is_dark ? #18181b : #ffffff;
    out property <color> tip_ink: is_dark ? #fafafa : #0e0e11;

    // ===== 字体族 =====
    // 拉丁/等宽统一走 JetBrains Mono（系统已装），中文回退由 fontconfig 处理
    out property <string> mono: "JetBrains Mono";

    // ===== 字号 =====
    out property <length> fs_xs: 10px;
    out property <length> fs_sm: 11px;
    out property <length> fs: 12px;
    out property <length> fs_md: 13px;
    out property <length> fs_lg: 16px;
    out property <length> fs_xl: 18px;

    // ===== 圆角 =====
    out property <length> r_xs: 4px;
    out property <length> r_sm: 6px;
    out property <length> r_md: 8px;
    out property <length> r: 14px;
    out property <length> r_dialog: 16px;

    // ===== 间距 =====
    out property <length> s1: 4px;
    out property <length> s2: 6px;
    out property <length> s3: 8px;
    out property <length> s4: 12px;
    out property <length> s5: 16px;
    out property <length> s6: 20px;

    // ===== 结构尺寸 =====
    out property <length> top_h: 48px;
    out property <length> sub_h: 40px;
    out property <length> batch_h: 44px;
    out property <length> foot_h: 40px;
    out property <length> drawer_w: 400px;
    // 抽屉内部布局契约（单一真相源）：内容区高 = 抽屉高 - 头部 -（容器才有）Tab 栏
    // Drawer.height 为百分比，其后代不能再依赖 height:% → 用这些定值显式推导
    out property <length> drawer_head: 56px;
    out property <length> drawer_tabs: 40px;
    out property <length> drawer_logbar: 40px;

    // ===== 阴影 =====
    // prototype: --shadow = 0 1px 2px rgba(0,0,0,.3), 0 4px 16px rgba(0,0,0,.25)
    // prototype: --shadow-hover = 0 2px 4px rgba(0,0,0,.3), 0 12px 32px rgba(0,0,0,.45)
    out property <color> shadow: is_dark ? rgba(0,0,0,0.25) : rgba(14,14,17,0.05);
    out property <color> shadow_hover: is_dark ? rgba(0,0,0,0.45) : rgba(14,14,17,0.10);
}
