// theme.slint — 设计令牌 + 网格常量（唯一真相源）
// 布局纪律：只用 HorizontalLayout / VerticalLayout（无隐式 padding）。
// Box = Layout + 隐式 5px padding，是错位根源，禁止使用。

export global Theme {
    // ============ 色彩 ============
    out property <color> bg-root: #0b1220;
    out property <color> bg-side: #101b2d;      // 左导航 / 右面板 / 顶底栏
    out property <color> bg-main: #16233a;      // 主列表区
    out property <color> bg-card: #1d2c45;      // 卡片 / 控件底
    out property <color> bg-row-hover: #1f3350;
    out property <color> bg-row-sel: #1d4a6b;
    out property <color> bg-group: #131f33;

    out property <color> line: #24344d;         // 分隔线 / 边框

    out property <color> fg: #f1f5f9;           // 主文字
    out property <color> fg-2: #c3d0e0;         // 次文字
    out property <color> fg-3: #8296b0;         // 弱文字
    out property <color> fg-4: #5b6b82;         // 占位符

    out property <color> accent: #38bdf8;
    out property <color> ok: #34d399;
    out property <color> off: #64748b;
    out property <color> warn: #fbbf24;
    out property <color> err: #f87171;

    // ============ 字号 ============
    out property <length> fs-xs: 10px;
    out property <length> fs-sm: 11px;
    out property <length> fs: 12px;
    out property <length> fs-md: 13px;
    out property <length> fs-lg: 16px;

    // ============ 间距 ============
    out property <length> s1: 4px;
    out property <length> s2: 6px;
    out property <length> s3: 8px;
    out property <length> s4: 12px;
    out property <length> s5: 16px;

    // ============ 结构尺寸 ============
    out property <length> nav-w: 200px;
    out property <length> side-w: 360px;
    out property <length> top-h: 48px;
    out property <length> tab-h: 34px;
    out property <length> head-h: 30px;
    out property <length> row-h: 32px;
    out property <length> group-h: 28px;
    out property <length> tool-h: 40px;
    out property <length> foot-h: 24px;
    out property <length> batch-h: 42px;

    // ============ 网格：容器列表 ============
    // 表头与数据行使用完全相同的单元格序列。
    // 固定列合计 = 32+12+150+88+56+86+120 = 544
    // 名称列占据剩余空间（flex）
    out property <length> c-check: 32px;
    out property <length> c-dot: 12px;
    out property <length> c-image: 150px;
    out property <length> c-state: 88px;
    out property <length> c-cpu: 56px;
    out property <length> c-mem: 86px;
    out property <length> c-act: 120px;

    // ============ 网格：镜像列表 ============
    out property <length> i-tag: 130px;
    out property <length> i-use: 70px;
    out property <length> i-size: 80px;

    // ============ 网格：网络 / 卷 ============
    out property <length> n-driver: 110px;
    out property <length> n-scope: 80px;
    out property <length> n-count: 60px;
}
