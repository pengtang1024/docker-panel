// top-bar.slint — 顶栏
import { Theme } from "theme.slint";
import { VCenterText, CenterText } from "components-align.slint";
import { IconBtn, Dot } from "components-interact.slint";

export component TopBar inherits Rectangle {
    height: Theme.top_h;
    background: Theme.card;

    // 底部边框
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.line;
    }

    in-out property <bool> docker_ok: false;
    in-out property <string> search_q: "";
    callback theme_click();
    callback refresh_click();
    callback cleanup_click();
    callback pull_click();
    callback search(string);
    callback focus_search();
    focus_search() => { search_input.focus(); }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: Theme.s4;
        padding-left: Theme.s5;
        padding-right: Theme.s5;
        alignment: center;   // prototype .top: display:flex; align-items:center

        VCenterText {
            text: "Docker Panel";
            font-size: Theme.fs_md;
            font-weight: 700;
            color: Theme.ink;
        }

        Dot { on: root.docker_ok; }
        VCenterText {
            text: root.docker_ok ? @tr("Connected") : @tr("Disconnected");
            font-size: Theme.fs_sm;
            color: Theme.ink_3;
        }

        Rectangle { width: 1px; height: 20px; background: Theme.line; }

        // 搜索框
        Rectangle {
            height: 32px;
            border-radius: Theme.r_md;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.line;
            horizontal-stretch: 1;
            HorizontalLayout {
                width: 100%;
                height: 100%;
                spacing: Theme.s2;
                padding-left: Theme.s3;
                padding-right: Theme.s3;
                alignment: center;   // prototype .search: display:flex; align-items:center
                CenterText {
                    text: "⌕";
                    color: Theme.ink_3;
                    font-size: Theme.fs_md;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;
                    search_input := TextInput {
                        x: 0px; y: (parent.height - self.height) / 2;
                        width: 100%;
                        text <=> root.search_q;
                        color: Theme.ink;
                        font-size: Theme.fs_sm;
                        accepted() => { root.search(root.search_q); }
                        edited() => { root.search(root.search_q); }
                    }
                    VCenterText {
                        x: 0px; y: (parent.height - self.height) / 2;
                        width: 100%;
                        visible: search_input.text == "";
                        text: @tr("Search name, image...");
                        color: Theme.ink_3;
                        font-size: Theme.fs_sm;
                    }
                }
                VCenterText {
                    text: "Ctrl+K";
                    color: Theme.ink_4;
                    font-size: Theme.fs_xs;
                }
            }
        }

        Rectangle { width: 1px; height: 20px; background: Theme.line; }

        // 4 个纯图标按钮（spec 2.1：全图标 + tooltip，无文字）
        IconBtn {
            // 三态循环：auto(跟随系统) → light → dark（spec 2.1）
            glyph: Theme.theme_mode == 1 ? "☀" : Theme.theme_mode == 2 ? "☾" : "◐";
            glyph_size: 16px;
            tip: @tr("Theme");
            clicked => { root.theme_click(); }
        }
        IconBtn {
            glyph: "↻";
            glyph_size: 16px;
            tip: @tr("Refresh");
            clicked => { root.refresh_click(); }
        }
        IconBtn {
            glyph: "⌫";
            glyph_size: 15px;
            tip: @tr("Cleanup");
            clicked => { root.cleanup_click(); }
        }
        IconBtn {
            glyph: "⤓";
            glyph_size: 16px;
            primary: true;
            tip: @tr("Pull");
            clicked => { root.pull_click(); }
        }
    }
}
