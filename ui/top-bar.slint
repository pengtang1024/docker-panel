// top-bar.slint — 顶栏（严格对齐 prototype .top{height:48px;padding:0 14px;gap:10px}）
import { Theme } from "theme.slint";
import { VCenterText, CenterText } from "components-align.slint";
import { IconBtn, Dot } from "components-interact.slint";

export component TopBar inherits Rectangle {
    height: Theme.top_h;
    background: Theme.card;

    Rectangle {
        y: parent.height - 1px; width: 100%; height: 1px; background: Theme.line;
    }

    in-out property <bool> docker_ok: false;
    in-out property <string> search_q: "";
    callback theme_click();
    callback refresh_click();
    callback cleanup_click();
    callback pull_click();
    callback search(string);
    callback focus_search();
    focus_search() => { search_input.focus(); }

    // alignment:center 确保所有子元素垂直居中（Slint HorizontalLayout 默认 start 会让元素靠顶）
    HorizontalLayout {
        width: 100%; height: 100%;
        spacing: 10px;
        padding-left: 14px; padding-right: 14px;

        // .brand .mark{width:26px;height:26px;background:var(--ink);border-radius:var(--r-md)}
        Rectangle {
            width: 26px; height: 26px;
            border-radius: Theme.r_md;
            background: Theme.ink;
            CenterText { text: "◎"; font-size: 16px; color: Theme.card; width: 100%; height: 100%; }
        }

        VCenterText { text: "Docker Panel"; font-size: 15px; font-weight: 800; color: Theme.ink; }

        // .conn{gap:5px;font-size:11px;margin-left:2px}
        Rectangle { width: 2px; }  // margin-left:2px 等效间距
        Dot { on: root.docker_ok; dot_size: 6px; }
        VCenterText {
            text: root.docker_ok ? @tr("Connected") : @tr("Disconnected");
            font-size: 11px; font-weight: 600; color: Theme.ink_3;
        }

        Rectangle { width: 1px; height: 20px; background: Theme.line; }

        // .search{margin-left:auto;width:300px;height:32px;padding:0 10px;gap:8px}
        Rectangle {
            height: 32px;
            border-radius: Theme.r_md;
            background: Theme.bg;
            border-width: 1px; border-color: Theme.line;
            horizontal-stretch: 1;

            HorizontalLayout {
                width: 100%; height: 100%;
                spacing: 8px;
                padding-left: 10px; padding-right: 10px;
                alignment: center;

                CenterText { text: "⌕"; color: Theme.ink_3; font-size: 13px; }

                Rectangle {
                    horizontal-stretch: 1;
                    height: 100%;
                    search_input := TextInput {
                        x: 0px; y: (parent.height - self.height) / 2;
                        width: 100%;
                        text <=> root.search_q;
                        color: Theme.ink; font-size: 12px;
                        accepted() => { root.search(root.search_q); }
                        edited() => { root.search(root.search_q); }
                    }
                    VCenterText {
                        x: 0px; y: (parent.height - self.height) / 2;
                        width: 100%;
                        visible: search_input.text == "";
                        text: @tr("Search name, image...");
                        color: Theme.ink_3; font-size: 12px;
                    }
                }

                Rectangle {
                    padding-left: 6px; padding-right: 6px;
                    padding-top: 1px; padding-bottom: 1px;
                    border-width: 1px; border-color: Theme.line;
                    border-radius: Theme.r_xs;
                    VCenterText {
                        text: "Ctrl+K"; font-size: 10px; color: Theme.ink_3; font-family: Theme.mono;
                    }
                }
            }
        }

        Rectangle { width: 1px; height: 20px; background: Theme.line; }

        IconBtn { glyph: Theme.theme_mode == 1 ? "☀" : Theme.theme_mode == 2 ? "☾" : "◐"; glyph_size: 16px; tip: @tr("Theme"); clicked => { root.theme_click(); } }
        IconBtn { glyph: "↻"; glyph_size: 16px; tip: @tr("Refresh"); clicked => { root.refresh_click(); } }
        IconBtn { glyph: "⌫"; glyph_size: 15px; tip: @tr("Cleanup"); clicked => { root.cleanup_click(); } }
        IconBtn { glyph: "⤓"; glyph_size: 16px; primary: true; tip: @tr("Pull"); clicked => { root.pull_click(); } }
    }
}
