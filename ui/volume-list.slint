// volume-list.slint — 卷表格列表（表头可排序 + 30px 虚拟化行）
//
// 精简列：名称 · 大小 · 挂载点
// 列起点固定：表头与行共用同一组列宽（由本组件统一下发）。
import { Theme } from "theme.slint";
import { VCenterText, RightText } from "components-align.slint";
import { ListCols, ListHeadCell } from "components-list.slint";
import { VolumeRow } from "models.slint";
import { ListView } from "@material";

// ============ 行（30px）============
component VolumeRowView inherits Rectangle {
    in property <VolumeRow> data;
    in property <length> name_w: 200px;
    in property <length> size_w: 96px;
    in property <length> mount_w: 320px;

    callback select(string);

    height: 30px;
    background: touch.has-hover ? Theme.row_hover : transparent;

    // 行热区：必须声明在内容**之前**（命中顺序铁律，规范 #19）
    touch := TouchArea {
        width: 100%; height: 100%;
        clicked => { root.select(root.data.name); }
    }

    HorizontalLayout {
        width: 100%; height: 100%;
        spacing: ListCols.gap;
        padding-left: ListCols.pad_x; padding-right: ListCols.pad_x;
        cross-axis-alignment: center;

        // 名称（匿名卷截断展示，tooltip 给全名）
        VCenterText {
            text: root.data.display_name;
            width: root.name_w; horizontal-stretch: 0;
            font-size: Theme.fs_md; font-weight: 600;
            font-family: Theme.mono;
            color: Theme.ink;
            overflow: elide;
        }

        // 大小
        RightText {
            text: root.data.size;
            width: root.size_w; horizontal-stretch: 0;
            font-size: Theme.fs; font-weight: 600;
            font-family: Theme.mono;
            color: Theme.ink;
            overflow: elide;
        }

        // 挂载点
        VCenterText {
            text: root.data.mountpoint;
            width: root.mount_w; horizontal-stretch: 0;
            font-size: Theme.fs_sm; font-family: Theme.mono;
            color: Theme.ink_3;
            overflow: elide;
        }
    }
}

export component VolumeList inherits Rectangle {
    in-out property <[VolumeRow]> rows: [];
    /// 当前排序列（0=名称 1=大小 2=挂载点）
    in-out property <int> sort_field: 0;
    in-out property <bool> sort_desc: true;

    callback sort_pick(int);
    callback select(string);

    // —— 列宽（表头与行共用）——
    property <length> size_w: 96px;
    property <length> mount_w: 320px;
    property <length> content_w: root.width - ListCols.scrollbar_slot - ListCols.pad_x * 2;
    property <length> name_w: root.content_w - root.size_w - root.mount_w - ListCols.gap * 2;

    VerticalLayout {
        width: 100%; height: 100%;
        spacing: 0px;

        // 表头（固定在滚动区之外 → 天然 sticky）
        Rectangle {
            vertical-stretch: 0;
            height: ListCols.head_h;
            background: Theme.bg;
            Rectangle {
                y: parent.height - 1px;
                width: 100%; height: 1px;
                background: Theme.line;
            }
            HorizontalLayout {
                width: 100%; height: 100%;
                spacing: ListCols.gap;
                padding-left: ListCols.pad_x;
                padding-right: ListCols.pad_x + ListCols.scrollbar_slot;
                cross-axis-alignment: center;

                ListHeadCell {
                    text: @tr("Volume");
                    cell_w: root.name_w;
                    active: root.sort_field == 0;
                    desc: root.sort_desc;
                    show_arrow: true;
                    picked => { root.sort_pick(0); }
                }
                ListHeadCell {
                    text: @tr("Size");
                    right: true;
                    cell_w: root.size_w;
                    active: root.sort_field == 1;
                    desc: root.sort_desc;
                    show_arrow: true;
                    picked => { root.sort_pick(1); }
                }
                ListHeadCell {
                    text: @tr("Mountpoint");
                    cell_w: root.mount_w;
                    active: root.sort_field == 2;
                    desc: root.sort_desc;
                    show_arrow: true;
                    picked => { root.sort_pick(2); }
                }
            }
        }

        // 行列表（虚拟化：只渲染视口内的行）
        list := ListView {
            vertical-stretch: 1;
            width: 100%;
            vertical-scrollbar-policy: as-needed;
            horizontal-scrollbar-policy: always-off;
            content_width: self.visible_width;
            mouse_drag_pan_enabled: false;
            for row[i] in root.rows : VolumeRowView {
                data: row;
                width: 100%;
                height: ListCols.row_h;
                name_w: root.name_w;
                size_w: root.size_w;
                mount_w: root.mount_w;
                select(id) => { root.select(id); }
            }
        }
    }
}
